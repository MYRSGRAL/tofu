+package nativehooks_test
+
+import (
+	"fmt"
+	mdns "github.com/miekg/dns"
+	"github.com/xtls/xray-core/common/buf"
+	xlog "github.com/xtls/xray-core/common/log"
+	xnet "github.com/xtls/xray-core/common/net"
+	H "github.com/xtls/xray-core/common/yonikbroker"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/infra/conf/serial"
+	_ "github.com/xtls/xray-core/main/distro/all"
+	"io"
+	"net"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestNamedDownstream(t *testing.T) {
+	for _, network := range []string{"tcp", "udp"} {
+		for _, rawMode := range []string{"known", "cancel", "revoke", "epoch", "unknown", "unavailable", "stale", "cache/known", "cache/cancel", "cache/revoke", "cache/epoch", "cache/unknown", "cache/unavailable", "cache/stale", "changed-answer"} {
+			t.Run(network+"/"+rawMode, func(t *testing.T) {
+				mode := strings.TrimPrefix(rawMode, "cache/")
+				cached := strings.HasPrefix(rawMode, "cache/")
+				ctx, change := H.ClosedDNSFixture(t)
+				var egress atomic.Int32
+				tcp, e := net.Listen("tcp", "0.0.0.0:0")
+				if e != nil {
+					t.Fatal(e)
+				}
+				defer tcp.Close()
+				port := tcp.Addr().(*net.TCPAddr).Port
+				udp, e := net.ListenPacket("udp", fmt.Sprintf("0.0.0.0:%d", port))
+				if e != nil {
+					t.Fatal(e)
+				}
+				defer udp.Close()
+				go func() {
+					for {
+						c, e := tcp.Accept()
+						if e != nil {
+							return
+						}
+						egress.Add(1)
+						go func() { defer c.Close(); io.Copy(c, c) }()
+					}
+				}()
+				go func() {
+					b := make([]byte, 64)
+					for {
+						n, a, e := udp.ReadFrom(b)
+						if e != nil {
+							return
+						}
+						egress.Add(1)
+						udp.WriteTo(b[:n], a)
+					}
+				}()
+				listener, e := net.Listen("tcp", "127.0.0.1:0")
+				if e != nil {
+					t.Fatal(e)
+				}
+				entered, release := make(chan struct{}, 8), make(chan struct{})
+				server := &mdns.Server{Listener: listener, Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, q *mdns.Msg) {
+					entered <- struct{}{}
+					<-release
+					r := new(mdns.Msg)
+					r.SetReply(q)
+					answer := "127.0.0.1"
+					if mode == "changed-answer" {
+						answer = "127.0.0.2"
+					}
+					rr, _ := mdns.NewRR("private.test. 60 IN A " + answer)
+					r.Answer = []mdns.RR{rr}
+					w.WriteMsg(r)
+				})}
+				go server.ActivateAndServe()
+				defer server.Shutdown()
+				config, e := serial.LoadJSONConfig(strings.NewReader(fmt.Sprintf(`{"dns":{"queryStrategy":"UseIPv4","servers":["tcp+local://%s"]},"routing":{"domainStrategy":"IPOnDemand","rules":[{"type":"field","ip":["127.0.0.1/32"],"outboundTag":"allowed"}]},"outbounds":[{"tag":"deny","protocol":"blackhole"},{"tag":"allowed","protocol":"freedom","settings":{"domainStrategy":"UseIPv4"}}]}`, listener.Addr())))
+				if e != nil {
+					t.Fatal(e)
+				}
+				instance, e := core.NewWithContext(ctx, config)
+				if e != nil {
+					t.Fatal(e)
+				}
+				defer instance.Close()
+				if e = instance.Start(); e != nil {
+					t.Fatal(e)
+				}
+				done := make(chan error, 1)
+				run := func() {
+					go func() {
+						dst := xnet.TCPDestination(xnet.DomainAddress("private.test"), xnet.Port(port))
+						if network == "udp" {
+							dst.Network = xnet.Network_UDP
+						}
+						link, e := instance.GetFeature(routing.DispatcherType()).(routing.Dispatcher).Dispatch(ctx, dst)
+						if e != nil {
+							done <- e
+							return
+						}
+						b := buf.New()
+						b.Write([]byte("named"))
+						e = link.Writer.WriteMultiBuffer(buf.MultiBuffer{b})
+						if e == nil {
+							var mb buf.MultiBuffer
+							mb, e = link.Reader.ReadMultiBuffer()
+							buf.ReleaseMulti(mb)
+						}
+						done <- e
+					}()
+				}
+				run()
+				select {
+				case <-entered:
+				case <-time.After(3 * time.Second):
+					t.Fatal("DNS barrier не достигнут")
+				}
+				warmQuestions := 0
+				if cached {
+					close(release)
+					select {
+					case e := <-done:
+						if e != nil {
+							t.Fatal(e)
+						}
+					case <-time.After(4 * time.Second):
+						t.Fatal("cache warm echo timeout")
+					}
+					egress.Store(0)
+					warmQuestions = len(entered)
+				}
+
+				var checkpoint *cacheCheckpoint
+				if cached {
+					checkpoint = &cacheCheckpoint{change: change, mode: mode}
+					xlog.RegisterHandler(checkpoint)
+					run()
+				} else {
+					change(mode)
+					close(release)
+				}
+				if mode == "known" {
+					select {
+					case e := <-done:
+						if e != nil {
+							t.Fatal(e)
+						}
+					case <-time.After(3 * time.Second):
+						t.Fatal("нет echo")
+					}
+					if egress.Load() == 0 {
+						t.Fatal("нет egress")
+					}
+				} else {
+					select {
+					case <-done:
+					case <-time.After(time.Second):
+					}
+					if egress.Load() != 0 {
+						t.Fatalf("запрещённый egress %d", egress.Load())
+					}
+				}
+				if cached && checkpoint.hits.Load() == 0 {
+					t.Fatal("не достигнут actual cache-hit checkpoint")
+				}
+				if cached && len(entered) != warmQuestions {
+					t.Fatal("cache flow выполнил новый DNS exchange")
+				}
+				t.Logf("native routing→beforeDial→%s egress=%d mode=%s", network, egress.Load(), mode)
+			})
+		}
+	}
+}
diff --git a/common/yonikbroker/monitor_close_linux_test.go b/common/yonikbroker/monitor_close_linux_test.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/monitor_close_linux_test.go
@@ -0,0 +1,63 @@
+//go:build linux && !android
+
+package nativehooks
+
+import (
+	"context"
+	"os"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// Shutdown обязан дождаться пользователя borrowed FD под общим mutex.
+func TestMonitorCloseWaitsForBorrower(t *testing.T) {
+	pair, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_SEQPACKET|syscall.SOCK_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	channel := os.NewFile(uintptr(pair[0]), "channel")
+	defer channel.Close()
+	peer := os.NewFile(uintptr(pair[1]), "peer")
+	defer peer.Close()
+	pidfd, err := os.Open("/dev/null")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pidfd.Close()
+	session, err := NewSession(Binding{Nonce: [32]byte{1}, ConfigDigest: [32]byte{2}, Epoch: 3}, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := &routingConsumer{channel: channel, pidfd: pidfd, session: session}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	c.mu.Lock()
+	done := make(chan struct{})
+	go func() { c.monitorTUN(ctx); close(done) }()
+	select {
+	case <-done:
+		c.mu.Unlock()
+		t.Fatal("monitor закрыл borrowed FD до освобождения mutex")
+	case <-time.After(50 * time.Millisecond):
+	}
+	raw, err := channel.SyscallConn()
+	if err == nil {
+		err = raw.Control(func(fd uintptr) { _, err = syscall.GetsockoptInt(int(fd), syscall.SOL_SOCKET, syscall.SO_TYPE) })
+	}
+	c.mu.Unlock()
+	if err != nil {
+		t.Fatalf("borrowed FD уже закрыт: %v", err)
+	}
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("monitor не завершился")
+	}
+	if err := raw.Control(func(uintptr) {}); err == nil {
+		t.Fatal("channel не закрыт")
+	}
+	if session.Context().Err() == nil {
+		t.Fatal("session не отозвана")
+	}
+}
diff --git a/common/yonikbroker/flow_scope_test.go b/common/yonikbroker/flow_scope_test.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/flow_scope_test.go
@@ -0,0 +1,167 @@
+package nativehooks
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type countedSocket struct {
+	net.Conn
+	closes atomic.Int32
+}
+
+func (c *countedSocket) Close() error                 { c.closes.Add(1); return c.Conn.Close() }
+func TestSingleSessionFlowScope(t *testing.T)         { singleSessionFlowScope(t, false) }
+func TestAdmittedSingleSessionFlowScope(t *testing.T) { singleSessionFlowScope(t, true) }
+func singleSessionFlowScope(t *testing.T, admitted bool) {
+	for _, network := range []string{"tcp", "udp"} {
+		for _, mode := range []string{"cancel", "unknown", "unavailable", "revoke"} {
+			t.Run(network+"/"+mode, func(t *testing.T) {
+				s, p, _ := fixture(t)
+				defer func() { _ = s.Revoke() }()
+				globalRevoke := func() { _ = s.Revoke() }
+				if admitted {
+					ctx, _, wireRevoke := closedTUNFixtureMode(t, "known/revoke")
+					s = ctx.Value(routingKey{}).(*routingConsumer).session
+					p.Binding = s.binding
+					globalRevoke = func() {
+						wireRevoke()
+						select {
+						case <-s.Context().Done():
+						case <-time.After(time.Second):
+							t.Fatal("wire REVOKE не обработан")
+						}
+						_ = s.Revoke()
+					}
+				}
+				var address string
+				if network == "tcp" {
+					l, e := net.Listen("tcp", "127.0.0.1:0")
+					if e != nil {
+						t.Fatal(e)
+					}
+					defer l.Close()
+					address = l.Addr().String()
+					go func() {
+						for {
+							c, e := l.Accept()
+							if e != nil {
+								return
+							}
+							go func() {
+								defer c.Close()
+								b := make([]byte, 8)
+								for {
+									n, e := c.Read(b)
+									if e != nil {
+										return
+									}
+									_, _ = c.Write(b[:n])
+								}
+							}()
+						}
+					}()
+				} else {
+					l, e := net.ListenPacket("udp", "127.0.0.1:0")
+					if e != nil {
+						t.Fatal(e)
+					}
+					defer l.Close()
+					address = l.LocalAddr().String()
+					go func() {
+						b := make([]byte, 8)
+						for {
+							n, a, e := l.ReadFrom(b)
+							if e != nil {
+								return
+							}
+							_, _ = l.WriteTo(b[:n], a)
+						}
+					}()
+				}
+				makeFlow := func() (context.Context, context.CancelFunc, *routingConsumer, *countedSocket, func() error) {
+					ctx, cancel := context.WithCancel(context.Background())
+					c := &routingConsumer{session: s, required: true, flow: p.Flow}
+					c.lookup = func(context.Context, Flow) (Evidence, error) {
+						q := p
+						q.Flow = c.flow
+						q.Observed = time.Now()
+						q.Expires = q.Observed.Add(20 * time.Millisecond)
+						return q, nil
+					}
+					ctx = context.WithValue(ctx, routingKey{}, c)
+					conn, e := net.Dial(network, address)
+					if e != nil {
+						t.Fatal(e)
+					}
+					c.flow.Local = netip.MustParseAddrPort(conn.LocalAddr().String())
+					c.flow.Remote = netip.MustParseAddrPort(conn.RemoteAddr().String())
+					if network == "udp" {
+						c.flow.Protocol = 17
+					}
+					socket := &countedSocket{Conn: conn}
+					release, e := OwnSocket(ctx, socket)
+					if e != nil {
+						t.Fatal(e)
+					}
+					return ctx, cancel, c, socket, release
+				}
+				a, ca, c, sa, ra := makeFlow()
+				defer ca()
+				defer ra()
+				b, cb, _, sb, rb := makeFlow()
+				defer cb()
+				defer rb()
+				switch mode {
+				case "cancel":
+					ca()
+				case "unknown", "unavailable":
+					c.lookup = func(context.Context, Flow) (Evidence, error) {
+						q := p
+						q.Flow = c.flow
+						if mode == "unknown" {
+							q.Status = Unknown
+						} else {
+							q.Status = Unavailable
+						}
+						return q, nil
+					}
+				case "revoke":
+					globalRevoke()
+				}
+				if RoutingEntry(a) == nil {
+					t.Fatal("A разрешён")
+				}
+				if sa.closes.Load() == 0 {
+					t.Fatal("A не закрыт")
+				}
+				if mode == "revoke" {
+					if RoutingEntry(b) == nil || sb.closes.Load() == 0 {
+						t.Fatal("глобальный revoke не закрыл B")
+					}
+					return
+				}
+				if RoutingEntry(b) != nil || sb.closes.Load() != 0 {
+					t.Fatal("B отозван вместе с A")
+				}
+				_ = sb.SetDeadline(time.Now().Add(time.Second))
+				if _, e := sb.Write([]byte("echo")); e != nil {
+					t.Fatal(e)
+				}
+				buf := make([]byte, 4)
+				n, e := sb.Read(buf)
+				if e != nil || n != 4 || string(buf) != "echo" {
+					t.Fatalf("echo B: %q %v", buf, e)
+				}
+				t.Logf("A_close=%d B_close=%d B_echo_bytes=%d", sa.closes.Load(), sb.closes.Load(), n)
+				if RoutingEntry(a) == nil {
+					t.Fatal("A повторно разрешён")
+				}
+			})
+		}
+	}
+}
diff --git a/common/yonikbroker/plain_tun_linux_test.go b/common/yonikbroker/plain_tun_linux_test.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/plain_tun_linux_test.go
@@ -0,0 +1,115 @@
+package nativehooks
+
+import (
+	"golang.org/x/sys/unix"
+	"net"
+	"os"
+	"testing"
+)
+
+func TestPlainTUNFlags(t *testing.T) {
+	for flags := 0; flags <= 0xffff; flags++ {
+		want := flags == 0x1001 || flags == 0x1801
+		if plainTUNFlags(uint16(flags)) != want {
+			t.Fatalf("flags=%#x", flags)
+		}
+	}
+}
+
+func TestKernelPlainTUNValidation(t *testing.T) {
+	if os.Getenv("YONIK_ISOLATED_TUN_TEST") != "1" {
+		t.Skip("нужен isolated namespace launcher")
+	}
+	ns, err := os.Readlink("/proc/self/ns/net")
+	if err != nil || ns == os.Getenv("YONIK_HOST_NETNS") {
+		t.Fatal("нужна отдельная netns")
+	}
+	for _, item := range []struct {
+		name    string
+		flags   uint16
+		persist bool
+		header  int
+		want    bool
+	}{
+		{"plain", 0x1001, false, 0, true}, {"persistent_plain", 0x1001, true, 0, true},
+		{"vnet10", 0x5001, false, 10, false}, {"persistent_vnet10", 0x5001, true, 10, false},
+		{"vnet12", 0x5001, false, 12, false}, {"tap", 0x1002, false, 0, false},
+		{"pi", 0x0001, false, 0, false}, {"multiqueue", 0x1101, false, 0, false},
+		{"unknown", 0x1005, false, 0, false},
+	} {
+		t.Run(item.name, func(t *testing.T) {
+			fd, e := unix.Open("/dev/net/tun", unix.O_RDWR|unix.O_NONBLOCK|unix.O_CLOEXEC, 0)
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer unix.Close(fd)
+			req, _ := unix.NewIfreq("ynkcheck%d")
+			req.SetUint16(item.flags)
+			if e = unix.IoctlIfreq(fd, unix.TUNSETIFF, req); e != nil {
+				if item.want {
+					t.Fatal(e)
+				}
+				t.Logf("kernel отверг flags=%#x: %v", item.flags, e)
+				return
+			}
+			if item.persist {
+				if e = unix.IoctlSetInt(fd, unix.TUNSETPERSIST, 1); e != nil {
+					t.Fatal(e)
+				}
+				defer unix.IoctlSetInt(fd, unix.TUNSETPERSIST, 0)
+			}
+			if item.header != 0 {
+				if e = unix.IoctlSetPointerInt(fd, unix.TUNSETVNETHDRSZ, item.header); e != nil {
+					t.Fatal(e)
+				}
+			}
+			if item.header != 0 {
+				actualHeader, err := unix.IoctlGetInt(fd, unix.TUNGETVNETHDRSZ)
+				if err != nil || actualHeader != item.header {
+					t.Fatalf("header=%d expected=%d err=%v", actualHeader, item.header, err)
+				}
+				t.Logf("kernel vnet header=%d", actualHeader)
+			}
+			if e = unix.IoctlIfreq(fd, unix.TUNGETIFF, req); e != nil {
+				t.Fatal(e)
+			}
+			actual := req.Uint16()
+			iface, e := net.InterfaceByName(req.Name())
+			if e != nil {
+				t.Fatal(e)
+			}
+			a := AttachBody{Name: iface.Name, Ifindex: uint32(iface.Index), MTU: uint32(iface.MTU)}
+			accepted := validateTUNFD(fd, a) == nil
+			if item.name == "pi" && actual&unix.IFF_NO_PI != 0 {
+				t.Logf("kernel нормализовал PI request в Plain: actual=%#x; PI flags deny проверяется exhaustive unit test", actual)
+				return
+			}
+			if item.name == "unknown" && actual&0x0004 == 0 {
+				t.Log("kernel удалил неизвестный бит; сохранённые unknown bits проверяются exhaustive unit test")
+				return
+			}
+			if accepted != item.want {
+				t.Fatalf("requested=%#x actual=%#x accepted=%v", item.flags, actual, accepted)
+			}
+			t.Logf("requested=%#x actual=%#x accepted=%v", item.flags, actual, accepted)
+			if !item.want {
+				return
+			}
+			if _, e = unix.FcntlInt(uintptr(fd), unix.F_SETFD, 0); e != nil {
+				t.Fatal(e)
+			}
+			if validateTUNFD(fd, a) == nil {
+				t.Fatal("нет CLOEXEC: FD принят")
+			}
+			if _, e = unix.FcntlInt(uintptr(fd), unix.F_SETFD, unix.FD_CLOEXEC); e != nil {
+				t.Fatal(e)
+			}
+			if e = unix.SetNonblock(fd, false); e != nil {
+				t.Fatal(e)
+			}
+			if validateTUNFD(fd, a) == nil {
+				t.Fatal("blocking FD принят")
+			}
+		})
+	}
+}

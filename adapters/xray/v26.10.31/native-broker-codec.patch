+type freedomDialer struct{ calls int }
+
+func (d *freedomDialer) Dial(_ context.Context, dest xnet.Destination) (stat.Connection, error) {
+	if !dest.Address.IP().Equal(net.ParseIP("127.0.0.1")) {
+		panic("не private DNS")
+	}
+	c, err := net.DialTimeout("tcp", dest.NetAddr(), time.Second)
+	if err != nil {
+		return nil, err
+	}
+	_ = c.Close()
+	d.calls++
+	return nil, errors.New("controlled dial")
+}
+func (*freedomDialer) DestIpAddress() xnet.IP                                { return nil }
+func (*freedomDialer) SetOutboundGateway(context.Context, *session.Outbound) {}
+
+func TestFreedomReaderAfterAwait(t *testing.T) {
+	for _, mode := range []string{"known", "cancel", "revoke", "unknown", "epoch", "unavailable", "stale"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, change := hooks.ClosedDNSFixture(t)
+			socket, err := net.ListenPacket("udp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer socket.Close()
+			sender, err := net.ListenPacket("udp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer sender.Close()
+			_ = socket.SetReadDeadline(time.Now().Add(time.Second))
+			reader := freedom.NewPacketReader(ctx, &xnet.PacketConnWrapper{PacketConn: socket, Dest: sender.LocalAddr()}, &freedom.Handler{}, nil, xnet.Destination{}, xnet.UDPDestination(xnet.LocalHostIP, 443))
+			result := make(chan int, 1)
+			go func() { mb, _ := reader.ReadMultiBuffer(); n := len(mb); buf.ReleaseMulti(mb); result <- n }()
+			change(mode)
+			if _, err := sender.WriteTo([]byte("private"), socket.LocalAddr()); err != nil {
+				t.Fatal(err)
+			}
+			n := <-result
+			if (mode == "known") != (n == 1) {
+				t.Fatalf("handoff=%d mode=%s", n, mode)
+			}
+		})
+	}
+}

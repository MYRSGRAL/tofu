+						}
+						before := []uint64{hooks.AuthenticatedProofCount(ctx0), hooks.AuthenticatedProofCount(ctx1)}
+						changes[victim](mode)
+						close(release)
+						for i, ch := range results {
+							select {
+							case ips := <-ch:
+								ctx := []context.Context{ctx0, ctx1}[i]
+								if (mode == "known" || i != victim) && hooks.AuthenticatedProofCount(ctx) <= before[i] {
+									t.Fatal("нет свежего proof после await")
+								}
+								actualEcho(t, ctx, transport, ips, mode == "known" || i != victim)
+								allowed := mode == "known" || i != victim
+								if allowed {
+									if len(ips) != 1 || !ips[0].Equal(net.ParseIP("127.0.0.1")) {
+										t.Fatalf("caller %d должен получить адрес: %v", i, ips)
+									}
+								} else if len(ips) != 0 {
+									t.Fatalf("caller %d получил адрес без authority: %v", i, ips)
+								}
+							case <-time.After(5 * time.Second):
+								t.Fatal("await завис")
+							}
+						}
+						if queries.Load() != 1 && !(mode == "revoke" && victim == 0 && queries.Load() == 2) {
+							t.Fatalf("coalescing: queries=%d", queries.Load())
+						}
+						// Свежие вызовы используют общий native cache, но повторно проверяют каждого caller.
+						for i, ctx := range []context.Context{ctx0, ctx1} {
+							ips, _, _ := client.LookupIPWithContext(ctx, "private.test", option)
+							allowed := mode == "known" || i != victim
+							if allowed != (len(ips) == 1) {
+								t.Fatalf("cache caller %d: %v", i, ips)
+							}
+						}
+						// Отдельный caller прогревает routing cache, затем теряет authority.
+						cacheCtx, cacheChange := hooks.ClosedAuthenticatedDNSFixture(t)
+						cacheCtx = context.WithValue(cacheCtx, core.XrayKey(1), instance)
+						cacheCtx = session.ContextWithOutbounds(cacheCtx, []*session.Outbound{{Target: xnet.TCPDestination(xnet.DomainAddress("private.test"), 443)}})
+						route := rdns.ContextWithDNSClient(rsession.AsRoutingContext(cacheCtx), instance.GetFeature(fdns.ClientType()).(fdns.Client))
+						if ips := route.GetTargetIPs(); len(ips) != 1 {
+							t.Fatalf("warm routing cache: %v", ips)
+						}
+						cacheChange(mode)
+						if ips := route.GetTargetIPs(); (mode == "known") != (len(ips) == 1) {
+							t.Fatalf("routing cache после %s: %v", mode, ips)
+						}
+						if queries.Load() != 1 && !(mode == "revoke" && victim == 0 && queries.Load() == 2) {
+							t.Fatalf("cache miss: queries=%d", queries.Load())
+						}
+					})
+				}
+			}
+		}
+	}
+
+}
+
+// actualEcho проверяет точный адрес, реальный socket и двусторонний payload.
+func actualEcho(t *testing.T, ctx context.Context, network string, ips []net.IP, allowed bool, revoke ...func()) {
+	t.Helper()
+	var port int
+	received := make(chan string, 1)
+	if network == "tcp" {
+		l, e := net.Listen("tcp", "127.0.0.1:0")
+		if e != nil {
+			t.Fatal(e)
+		}
+		defer l.Close()
+		port = l.Addr().(*net.TCPAddr).Port
+		go func() {
+			c, e := l.Accept()
+			if e != nil {
+				return
+			}
+			defer c.Close()
+			c.SetDeadline(time.Now().Add(time.Second))
+			b := make([]byte, 4)
+			_, e = io.ReadFull(c, b)
+			if e == nil {
+				received <- string(b)
+				c.Write(b)
+				c.Read(make([]byte, 4))
+			}
+		}()
+	} else {
+		l, e := net.ListenPacket("udp", "127.0.0.1:0")
+		if e != nil {
+			t.Fatal(e)
+		}
+		defer l.Close()
+		port = l.LocalAddr().(*net.UDPAddr).Port
+		go func() {
+			b := make([]byte, 4)
+			n, a, e := l.ReadFrom(b)
+			if e == nil {
+				received <- string(b[:n])
+				l.WriteTo(b[:n], a)
+			}
+		}()
+	}
+	counter := &actualSystemDialer{}
+	ctx = context.WithValue(ctx, actualCounterKey{}, counter)
+	egress := 0
+	if len(ips) > 0 {
+		if !ips[0].Equal(net.ParseIP("127.0.0.1")) {
+			t.Fatal("неверный адрес", ips)
+		}
+		dst := xnet.TCPDestination(xnet.IPAddress(ips[0]), xnet.Port(port))
+		if network == "udp" {
+			dst.Network = xnet.Network_UDP
+		}
+		if hooks.RoutingEntry(ctx) == nil {
+			c, e := internet.DialSystem(ctx, dst, nil)
+			if e == nil {
+				c.SetDeadline(time.Now().Add(time.Second))
+				_, e = c.Write([]byte("echo"))
+				b := make([]byte, 4)
+				if e == nil {
+					_, e = io.ReadFull(c, b)
+				}
+				defer c.Close()
+				if e != nil || string(b) != "echo" {
+					t.Fatal("echo", e, string(b))
+				}
+				select {
+				case v := <-received:
+					if v != "echo" {
+						t.Fatal(v)
+					}
+					egress++
+					if len(revoke) > 0 {
+						t.Logf("registered flows before revoke=%d", hooks.AuthenticatedFlowCount(ctx))
+						revoke[0]()
+						if !hooks.WaitAuthenticatedRevoke(ctx) {
+							t.Fatal("revoke не завершён")
+						}
+						deadline := time.Now().Add(time.Second)
+						for hooks.AuthenticatedFlowCount(ctx) != 0 && time.Now().Before(deadline) {
+							time.Sleep(time.Millisecond)
+						}
+						if hooks.AuthenticatedFlowCount(ctx) != 0 {
+							t.Fatal("flow остался после отзыва")
+						}
+						c.SetDeadline(time.Now().Add(time.Second))
+						if _, err := c.Write([]byte("late")); err == nil {
+							t.Fatal("subsequent Write разрешён после отзыва")
+						}
+						if _, err := c.Read(make([]byte, 4)); err == nil {
+							t.Fatal("subsequent Read разрешён после отзыва")
+						}
+						if next, err := internet.DialSystem(ctx, dst, nil); err == nil {
+							next.Close()
+							t.Fatal("subsequent dial разрешён")
+						}
+					}
+
+				case <-time.After(time.Second):
+					t.Fatal("нет egress")
+				}
+			}
+		}
+	}
+	expected := 0
+	if allowed {
+		expected = 1
+	}
+	dials, handoffs := counter.dials.Load(), counter.handoffs.Load()
+	if dials != int32(expected) || handoffs != int32(expected) || egress != expected {
+		t.Fatalf("actual dial=%d handoff=%d egress=%d want=%d", dials, handoffs, egress, expected)
+	}
+	t.Logf("actual %s dial=%d socket-handoff=%d egress=%d", network, dials, handoffs, egress)
+}
+
+type cacheCheckpoint struct {
+	change func(string)
+	mode   string
+	hits   atomic.Int32
+}
+
+func (h *cacheCheckpoint) Handle(m xlog.Message) {
+	if d, ok := m.(*xlog.DNSLog); ok && d.Status == xlog.DNSCacheHit && d.Domain == "private.test." {
+		h.hits.Add(1)
+		mode := h.mode
+		if mode == "" {
+			mode = "unknown"
+		}
+		h.change(mode)
+	}
+}
+
+// Checkpoint находится внутри реального cache-hit перед возвратом cached reply.
+func TestAuthenticatedCacheFence(t *testing.T) {
+	l, e := net.Listen("tcp", "127.0.0.1:0")
+	if e != nil {
+		t.Fatal(e)
+	}
+	var questions atomic.Int32
+	server := &mdns.Server{Listener: l, Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, q *mdns.Msg) {
+		questions.Add(1)
+		r := new(mdns.Msg)
+		r.SetReply(q)
+		rr, _ := mdns.NewRR("private.test. 60 IN A 127.0.0.1")
+		r.Answer = []mdns.RR{rr}
+		w.WriteMsg(r)
+	})}
+	go server.ActivateAndServe()
+	defer server.Shutdown()
+	cfg := &appdns.Config{QueryStrategy: appdns.QueryStrategy_USE_IP4, NameServer: []*appdns.NameServer{{Address: &xnet.Endpoint{Address: xnet.NewIPOrDomain(xnet.DomainAddress("tcp+local://" + l.Addr().String()))}}}}
+	instance, e := core.New(&core.Config{App: []*serial.TypedMessage{serial.ToTypedMessage(cfg), serial.ToTypedMessage(&dispatcher.Config{}), serial.ToTypedMessage(&proxyman.OutboundConfig{}), serial.ToTypedMessage(&policy.Config{})}})
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer instance.Close()
+	ctx, change := hooks.ClosedAuthenticatedDNSFixture(t)
+	client := instance.GetFeature(fdns.ClientType()).(fdns.ContextClient)
+	option := fdns.IPOption{IPv4Enable: true}
+	ips, _, e := client.LookupIPWithContext(ctx, "private.test", option)
+	if e != nil || len(ips) != 1 {
+		t.Fatal("warm", ips, e)
+	}
+	if hooks.RoutingEntry(ctx) != nil {
+		t.Fatal("entry отвергнут до cache")
+	}
+	h := &cacheCheckpoint{change: change}
+	xlog.RegisterHandler(h)
+	ips, _, e = client.LookupIPWithContext(ctx, "private.test", option)
+	if h.hits.Load() != 1 || questions.Load() != 1 {
+		t.Fatalf("cache checkpoint hits=%d questions=%d", h.hits.Load(), questions.Load())
+	}
+	if e == nil || len(ips) != 0 {
+		t.Fatalf("cache fence пропустил адрес: %v %v", ips, e)
+	}
+}
+
+type actualSystemDialer struct {
+	dials, handoffs atomic.Int32
+	real            internet.DefaultSystemDialer
+}
+
+func (d *actualSystemDialer) Dial(ctx context.Context, src xnet.Address, dst xnet.Destination, opt *internet.SocketConfig) (net.Conn, error) {
+	counter, _ := ctx.Value(actualCounterKey{}).(*actualSystemDialer)
+	if counter != nil {
+		counter.dials.Add(1)
+	}
+	c, e := d.real.Dial(ctx, src, dst, opt)
+	if e == nil && counter != nil {
+		counter.handoffs.Add(1)
+	}
+	return c, e
+}
+func (*actualSystemDialer) DestIpAddress() xnet.IP { return nil }
+
+type actualCounterKey struct{}
+
+func TestAuthenticatedSocketOwnership(t *testing.T) {
+	internet.UseAlternativeSystemDialer(&actualSystemDialer{})
+	defer internet.UseAlternativeSystemDialer(nil)
+	for _, network := range []string{"tcp", "udp"} {
+		for _, mode := range []string{"cancel", "revoke"} {
+			t.Run(network+"/"+mode, func(t *testing.T) {
+				l, e := net.Listen("tcp", "127.0.0.1:0")
+				if e != nil {
+					t.Fatal(e)
+				}
+				var questions atomic.Int32
+				server := &mdns.Server{Listener: l, Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, q *mdns.Msg) {
+					questions.Add(1)
+					r := new(mdns.Msg)
+					r.SetReply(q)
+					rr, _ := mdns.NewRR("private.test. 60 IN A 127.0.0.1")
+					r.Answer = []mdns.RR{rr}
+					w.WriteMsg(r)
+				})}
+				go server.ActivateAndServe()
+				defer server.Shutdown()
+				cfg := &appdns.Config{QueryStrategy: appdns.QueryStrategy_USE_IP4, NameServer: []*appdns.NameServer{{Address: &xnet.Endpoint{Address: xnet.NewIPOrDomain(xnet.DomainAddress("tcp+local://" + l.Addr().String()))}}}}
+				instance, e := core.New(&core.Config{App: []*serial.TypedMessage{serial.ToTypedMessage(cfg), serial.ToTypedMessage(&dispatcher.Config{}), serial.ToTypedMessage(&proxyman.OutboundConfig{}), serial.ToTypedMessage(&policy.Config{})}})
+				if e != nil {
+					t.Fatal(e)
+				}
+				defer instance.Close()
+				ctx, change := hooks.ClosedAuthenticatedDNSFixture(t)
+				client := instance.GetFeature(fdns.ClientType()).(fdns.ContextClient)
+				option := fdns.IPOption{IPv4Enable: true}
+				ips, _, e := client.LookupIPWithContext(ctx, "private.test", option)
+				if e != nil || len(ips) != 1 {
+					t.Fatal("warm", ips, e)
+				}
+				if hooks.RoutingEntry(ctx) != nil {
+					t.Fatal("routing отказал Known")
+				}
+				actualEcho(t, ctx, network, ips, true, func() { change(mode) })
+			})
+		}
+	}
+}

+						packet := buf.New()
+						_, _ = packet.Write([]byte("private"))
+						packet.UDP = &target
+						result <- writer.WriteMultiBuffer(buf.MultiBuffer{packet})
+					} else {
+						result <- handler.Process(ctx, &transport.Link{}, dialer)
+					}
+				}()

+++ b/common/yonikbroker/export_test.go
@@ -0,0 +1,234 @@
+package nativehooks
+
+import (
+	"context"
+	"encoding/binary"
+	"net/netip"
+	"os"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func ClosedTUNFixture(t *testing.T) (context.Context, *os.File, func()) {
+	ctx, original, cancel := closedTUNFixture(t)
+	c := ctx.Value(routingKey{}).(*routingConsumer)
+	return ctx, original, func() {
+		cancel()
+		select {
+		case <-c.session.revokeDone:
+		case <-time.After(time.Second):
+			t.Fatal("native revoke deadline")
+		}
+	}
+}
+
+// ClosedDialFixture доступен только тестовому бинарнику, production issuer не открывает.
+func ClosedDialFixture(t *testing.T, mode string, protocol uint8) (context.Context, *int) {
+	t.Helper()
+	s, p, _ := fixture(t)
+	p.Flow.Protocol = protocol
+	calls := new(int)
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	t.Cleanup(func() { _ = s.Revoke() })
+	c := &routingConsumer{session: s, required: true, flow: p.Flow}
+	c.lookup = func(context.Context, Flow) (Evidence, error) {
+		*calls++
+		p.Observed = time.Now()
+		p.Expires = p.Observed.Add(20 * time.Millisecond)
+		if *calls > 1 {
+			switch mode {
+			case "unknown":
+				p.Status = Unknown
+			case "unavailable":
+				p.Status = Unavailable
+			case "stale":
+				p.Expires = p.Observed.Add(-time.Millisecond)
+			case "cancel":
+				cancel()
+			case "revoke":
+				_ = s.Revoke()
+			}
+		}
+		return p, nil
+	}
+	ctx = context.WithValue(ctx, routingKey{}, c)
+	if err := RoutingEntry(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if mode == "nohandoff" {
+		return context.Background(), calls
+	}
+	return ctx, calls
+}
+
+// ClosedDNSFixture меняет ответ broker только после начала controlled exchange.
+var dnsFixtureSequence atomic.Uint32
+
+func ClosedDNSFixture(t *testing.T) (context.Context, func(string)) {
+	s, p, _ := fixture(t)
+	s.maxTTL = time.Second
+	id := dnsFixtureSequence.Add(1)
+	binary.LittleEndian.PutUint32(p.Binding.Nonce[:4], id)
+	s.binding = p.Binding
+	p.Flow.Local = netip.AddrPortFrom(p.Flow.Local.Addr(), uint16(1024+id%60000))
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	t.Cleanup(func() { _ = s.Revoke() })
+	c := &routingConsumer{session: s, required: true, flow: p.Flow}
+	mode := "known"
+	c.lookup = func(context.Context, Flow) (Evidence, error) {
+		reply := p
+		reply.Observed = time.Now()
+		reply.Expires = reply.Observed.Add(time.Second)
+		if mode == "unknown" {
+			reply.Status = Unknown
+		}
+		if mode == "unavailable" {
+			reply.Status = Unavailable
+		}
+		if mode == "stale" {
+			reply.Expires = reply.Observed.Add(-time.Millisecond)
+		}
+		if mode == "wrong-session" {
+			reply.Binding.Nonce[0]++
+		}
+		if mode == "wrong-binding" {
+			reply.Binding.ConfigDigest[0]++
+		}
+		if mode == "epoch" {
+			reply.Binding.Epoch++
+		}
+		return reply, nil
+	}
+	ctx = context.WithValue(ctx, routingKey{}, c)
+	if err := RoutingEntry(ctx); err != nil {
+		t.Fatal(err)
+	}
+	return ctx, func(next string) {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		mode = next
+		if next == "revoke" {
+			_ = s.Revoke()
+		}
+		if next == "cancel" {
+			cancel()
+		}
+	}
+}
+
+// ClosedRevokeFixture сохраняет authenticated ATTACH и wire Known issuer в test binary.
+func ClosedRevokeFixture(t *testing.T, mode string, protocol uint8) (context.Context, func()) {
+	ctx, _, control := closedTUNFixtureMode(t, "known/"+mode)
+	c := ctx.Value(routingKey{}).(*routingConsumer)
+	_, p, _ := fixture(t)
+	p.Binding = c.bootstrap.Binding
+	p.Flow.Protocol = protocol
+	c.mu.Lock()
+	c.flow = p.Flow
+	c.mu.Unlock()
+	return ctx, func() {
+		control()
+		select {
+		case <-c.session.revokeDone:
+		case <-time.After(time.Second):
+			t.Fatal("revoke deadline")
+		}
+		if err := c.session.Revoke(); err != nil {
+			t.Fatal(err)
+		}
+		c.session.mu.Lock()
+		remaining := len(c.session.flows)
+		c.session.mu.Unlock()
+		if remaining != 0 {
+			t.Fatalf("owned flows после revoke: %d", remaining)
+		}
+		c.mu.Lock()
+		next := c.next
+		c.mu.Unlock()
+		t.Cleanup(func() {
+			c.mu.Lock()
+			defer c.mu.Unlock()
+			if c.next != next {
+				t.Error("lookup после revoke")
+			}
+		})
+	}
+}
+
+// ClosedAuthenticatedDNSFixture выдаёт proof только через private wire issuer.
+func ClosedAuthenticatedDNSFixture(t *testing.T) (context.Context, func(string)) {
+	state := new(atomic.Uint32)
+	ctx, _, revoke := closedTUNFixtureMode(t, "known/cancel", state)
+	ctx, cancel := context.WithCancel(ctx)
+	t.Cleanup(cancel)
+	c := ctx.Value(routingKey{}).(*routingConsumer)
+	_, p, _ := fixture(t)
+	c.mu.Lock()
+	c.flow = p.Flow
+	c.mu.Unlock()
+	t.Cleanup(func() {
+		revoke()
+		select {
+		case <-c.session.revokeDone:
+		case <-time.After(time.Second):
+			t.Fatal("flow release deadline")
+		}
+		c.session.mu.Lock()
+		remaining := len(c.session.flows)
+		c.session.mu.Unlock()
+		if remaining != 0 {
+			t.Errorf("authenticated flows остались: %d", remaining)
+		}
+	})
+	return ctx, func(mode string) {
+		switch mode {
+		case "unknown":
+			state.Store(1)
+		case "unavailable":
+			state.Store(2)
+		case "epoch":
+			state.Store(3)
+		case "wrong-session":
+			state.Store(4)
+		case "wrong-binding":
+			state.Store(5)
+		case "stale":
+			state.Store(6)
+		case "cancel":
+			cancel()
+		case "revoke":
+			revoke()
+		}
+	}
+}
+
+func AuthenticatedProofCount(ctx context.Context) uint64 {
+	c := ctx.Value(routingKey{}).(*routingConsumer)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.next
+}
+
+func AuthenticatedFlowCount(ctx context.Context) int {
+	c := ctx.Value(routingKey{}).(*routingConsumer)
+	c.session.mu.Lock()
+	defer c.session.mu.Unlock()
+	return len(c.session.flows)
+}
+
+func WaitAuthenticatedRevoke(ctx context.Context) bool {
+	c := ctx.Value(routingKey{}).(*routingConsumer)
+	select {
+	case <-c.session.revokeDone:
+		return true
+	case <-time.After(time.Second):
+		return false
+	}
+}
+
+func PersistentPlainTUNFixture(t *testing.T) (context.Context, *os.File, func()) {
+	return closedTUNFixtureMode(t, "persistent/cancel")
+}

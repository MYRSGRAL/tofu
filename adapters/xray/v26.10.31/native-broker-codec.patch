diff --git a/app/dns/yonik_exchange.go b/app/dns/yonik_exchange.go
new file mode 100644
--- /dev/null
+++ b/app/dns/yonik_exchange.go
@@ -0,0 +1,57 @@
+package dns
+
+import (
+	"context"
+	hooks "github.com/xtls/xray-core/common/yonikbroker"
+	D "github.com/xtls/xray-core/features/dns"
+	"time"
+)
+
+type cachePending struct {
+	waiters int
+	done    chan struct{}
+	cancel  context.CancelFunc
+	result  result
+}
+
+// Последний waiter освобождает общий upstream; отмена соседа не влияет на остальных.
+func cacheExchange(ctx context.Context, s CachedNameserver, key, fqdn string, option D.IPOption) (*cachePending, func()) {
+	c := s.getCacheController()
+	c.exchangeMu.Lock()
+	if c.exchanges == nil {
+		c.exchanges = make(map[string]*cachePending)
+	}
+	p := c.exchanges[key]
+	if p == nil {
+		shared, release := hooks.DNSExchangeContext(ctx)
+		query, cancel := context.WithTimeout(shared, 8*time.Second)
+		p = &cachePending{done: make(chan struct{}), cancel: cancel}
+		c.exchanges[key] = p
+		go func() {
+			defer release()
+			defer cancel()
+			ret := doFetch(query, s, fqdn, option)
+			c.exchangeMu.Lock()
+			p.result = ret
+			if c.exchanges[key] == p {
+				delete(c.exchanges, key)
+			}
+			close(p.done)
+			c.exchangeMu.Unlock()
+		}()
+	}
+	p.waiters++
+	c.exchangeMu.Unlock()
+
+	return p, func() {
+		c.exchangeMu.Lock()
+		defer c.exchangeMu.Unlock()
+		p.waiters--
+		if p.waiters == 0 {
+			if c.exchanges[key] == p {
+				delete(c.exchanges, key)
+			}
+			p.cancel()
+		}
+	}
+}
diff --git a/app/dns/yonik_exchange_test.go b/app/dns/yonik_exchange_test.go
new file mode 100644
--- /dev/null
+++ b/app/dns/yonik_exchange_test.go
@@ -0,0 +1,117 @@
+package dns
+
+import (
+	"context"
+	D "github.com/xtls/xray-core/features/dns"
+	"reflect"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type heldExchange struct {
+	cache   *CacheController
+	started chan context.Context
+	retry   bool
+	calls   atomic.Int32
+}
+
+func (s *heldExchange) getCacheController() *CacheController { return s.cache }
+func (s *heldExchange) sendQuery(ctx context.Context, errs chan<- error, _ string, _ D.IPOption) {
+	s.started <- ctx
+	if s.retry && s.calls.Add(1) == 1 {
+		errs <- context.Canceled
+	}
+}
+func waitExchange(t *testing.T, ch <-chan context.Context) context.Context {
+	t.Helper()
+	select {
+	case ctx := <-ch:
+		return ctx
+	case <-time.After(time.Second):
+		t.Fatal("exchange не начат")
+		return nil
+	}
+}
+func endedExchange(t *testing.T, ctx context.Context) {
+	t.Helper()
+	select {
+	case <-ctx.Done():
+	case <-time.After(time.Second):
+		t.Fatal("upstream жив после последнего cancel")
+	}
+}
+func TestNativeDNSLastWaiterCancel(t *testing.T) {
+	s := &heldExchange{cache: NewCacheController("held", true, false, 0), started: make(chan context.Context, 2)}
+	assertReleased(t, s)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() { defer close(done); fetch(ctx, s, "held.", D.IPOption{IPv4Enable: true}) }()
+	upstream := waitExchange(t, s.started)
+	cancel()
+	endedExchange(t, upstream)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("caller жив")
+	}
+}
+func TestNativeDNSRetryCancel(t *testing.T) {
+	s := &heldExchange{cache: NewCacheController("held", true, false, 0), started: make(chan context.Context, 2), retry: true}
+	assertReleased(t, s)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() { defer close(done); fetch(ctx, s, "retry.", D.IPOption{IPv4Enable: true}) }()
+	waitExchange(t, s.started)
+	retry := waitExchange(t, s.started)
+	cancel()
+	endedExchange(t, retry)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("retry caller жив")
+	}
+}
+func TestNativeDNSWaiterIsolation(t *testing.T) {
+	s := &heldExchange{cache: NewCacheController("held", true, false, 0), started: make(chan context.Context, 2)}
+	a, ca := context.WithCancel(context.Background())
+	defer ca()
+	b, cb := context.WithCancel(context.Background())
+	defer cb()
+	_, leaveA := cacheExchange(a, s, "same", "same.", D.IPOption{IPv4Enable: true})
+	upstream := waitExchange(t, s.started)
+	_, leaveB := cacheExchange(b, s, "same", "same.", D.IPOption{IPv4Enable: true})
+	ca()
+	leaveA()
+	select {
+	case <-upstream.Done():
+		t.Fatal("отмена соседа убила exchange")
+	default:
+	}
+	cb()
+	leaveB()
+	endedExchange(t, upstream)
+}
+
+func assertReleased(t *testing.T, s *heldExchange) {
+	t.Helper()
+	t.Cleanup(func() {
+		deadline := time.Now().Add(time.Second)
+		for {
+			s.cache.exchangeMu.Lock()
+			n := len(s.cache.exchanges)
+			s.cache.exchangeMu.Unlock()
+			s.cache.pub.Cleanup()
+			s.cache.pub.RLock()
+			subs := reflect.ValueOf(s.cache.pub).Elem().FieldByName("subs").Len()
+			s.cache.pub.RUnlock()
+			if n == 0 && subs == 0 {
+				return
+			}
+			if time.Now().After(deadline) {
+				t.Fatalf("release exchanges=%d subscriptions=%d", n, subs)
+			}
+			time.Sleep(time.Millisecond)
+		}
+	})
+}

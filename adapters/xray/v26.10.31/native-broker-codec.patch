+package nativehooks_test
+
+import (
+	"context"
+	nativehooks "github.com/xtls/xray-core/common/yonikbroker"
+	"github.com/xtls/xray-core/proxy/tun"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestActualTUNConstructor(t *testing.T)                { actualTUNConstructor(t, false) }
+func TestPersistentPlainActualTUNConstructor(t *testing.T) { actualTUNConstructor(t, true) }
+func actualTUNConstructor(t *testing.T, persistent bool) {
+	if _, err := tun.NewTun(&tun.Config{Name: "ignored", MTU: 1500}, context.Background()); err == nil {
+		t.Fatal("нет handoff")
+	}
+	fixture := nativehooks.ClosedTUNFixture
+	if persistent {
+		fixture = nativehooks.PersistentPlainTUNFixture
+	}
+	ctx, original, cancel := fixture(t)
+	ctx = nativehooks.CarryClosedSession(ctx, context.Background())
+	iface, err := net.InterfaceByName("ynkfixture0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	native, err := tun.NewTun(&tun.Config{Name: iface.Name, MTU: uint32(iface.MTU)}, ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = native.Start(); err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	done := make(chan error, 1)
+	go func() { _, err := native.ReadPacket(make([]byte, 2048)); done <- err }()
+	select {
+	case err = <-done:
+		if err == nil {
+			t.Fatal("закрытый TUN читает")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("revoke не закрыл TUN")
+	}
+	if err = native.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = original.Stat(); err != nil {
+		t.Fatal("original", err)
+	}
+}

+func TestNativeDNSAfterReply(t *testing.T) {
+	for _, parallel := range []bool{false, true} {
+		for _, mode := range []string{"known", "cancel", "unknown", "epoch"} {
+			t.Run(map[bool]string{false: "serial", true: "parallel"}[parallel]+"/"+mode, func(t *testing.T) {
+				listener, err := net.Listen("tcp", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				entered, release := make(chan struct{}), make(chan struct{})
+				server := &mdns.Server{Listener: listener, Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, q *mdns.Msg) {
+					close(entered)
+					<-release
+					reply := new(mdns.Msg)
+					reply.SetReply(q)
+					rr, _ := mdns.NewRR("private.test. 60 IN A 192.0.2.17")
+					reply.Answer = []mdns.RR{rr}
+					_ = w.WriteMsg(reply)
+				})}
+				go server.ActivateAndServe()
+				t.Cleanup(func() { _ = server.Shutdown() })
+				cfg := &appdns.Config{QueryStrategy: appdns.QueryStrategy_USE_IP4, DisableCache: true, EnableParallelQuery: parallel, NameServer: []*appdns.NameServer{{Address: &xnet.Endpoint{Address: xnet.NewIPOrDomain(xnet.DomainAddress("tcp+local://" + listener.Addr().String()))}}}}
+				instance, err := core.New(&core.Config{App: []*serial.TypedMessage{serial.ToTypedMessage(cfg), serial.ToTypedMessage(&dispatcher.Config{}), serial.ToTypedMessage(&proxyman.OutboundConfig{}), serial.ToTypedMessage(&policy.Config{})}})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer instance.Close()
+				ctx, change := hooks.ClosedDNSFixture(t)
+				ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: xnet.TCPDestination(xnet.DomainAddress("private.test"), 443)}})
+				route := rdns.ContextWithDNSClient(rsession.AsRoutingContext(ctx), instance.GetFeature(fdns.ClientType()).(fdns.Client))
+				result := make(chan []xnet.IP, 1)
+				go func() { result <- route.GetTargetIPs() }()
+				select {
+				case <-entered:
+				case <-time.After(5 * time.Second):
+					t.Fatal("DNS exchange не начался")
+				}
+				change(mode)
+				close(release)
+				select {
+				case ips := <-result:
+					downstream := 0
+					if len(ips) > 0 {
+						downstream++
+					}
+					if mode == "known" {
+						if downstream != 1 || !ips[0].Equal(net.ParseIP("192.0.2.17")) {
+							t.Fatalf("private reply: %v", ips)
+						}
+					} else if downstream != 0 {
+						t.Fatalf("downstream=%d", downstream)
+					}
+				case <-time.After(5 * time.Second):
+					t.Fatal("DNS await завис")
+				}
+			})
+		}
+	}
+}

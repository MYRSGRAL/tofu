+func TestNativeDNSConcurrentAuthority(t *testing.T) {
+	for _, transport := range []string{"tcp", "udp"} {
+		for _, parallel := range []bool{false, true} {
+			for _, mode := range []string{"known", "cancel", "revoke", "epoch", "unknown", "unavailable", "stale", "wrong-session", "wrong-binding"} {
+				for _, victim := range []int{0, 1} {
+					t.Run(fmt.Sprintf("%s/parallel=%v/%s/victim=%d", transport, parallel, mode, victim), func(t *testing.T) {
+						listener, err := net.Listen("tcp", "127.0.0.1:0")
+						if err != nil {
+							t.Fatal(err)
+						}
+						entered, release := make(chan struct{}), make(chan struct{})
+						var queries atomic.Int32
+						server := &mdns.Server{Listener: listener, Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, q *mdns.Msg) {
+							if queries.Add(1) == 1 {
+								close(entered)
+							}
+							<-release
+							reply := new(mdns.Msg)
+							reply.SetReply(q)
+							rr, _ := mdns.NewRR("private.test. 60 IN A 192.0.2.17")
+							reply.Answer = []mdns.RR{rr}
+							_ = w.WriteMsg(reply)
+						})}
+						endpoint := "tcp+local://" + listener.Addr().String()
+						if transport == "udp" {
+							_ = listener.Close()
+							packet, err := net.ListenPacket("udp", "127.0.0.1:0")
+							if err != nil {
+								t.Fatal(err)
+							}
+							server.Listener = nil
+							server.PacketConn = packet
+							endpoint = "udp://" + packet.LocalAddr().String()
+						}
+						go server.ActivateAndServe()
+						defer server.Shutdown()
+						cfg := &appdns.Config{QueryStrategy: appdns.QueryStrategy_USE_IP4, EnableParallelQuery: parallel, NameServer: []*appdns.NameServer{{Address: &xnet.Endpoint{Address: xnet.NewIPOrDomain(xnet.DomainAddress(endpoint))}}}}
+						if transport == "udp" {
+							cfg.NameServer[0].Address = &xnet.Endpoint{Address: xnet.NewIPOrDomain(xnet.ParseAddress("127.0.0.1")), Port: uint32(server.PacketConn.LocalAddr().(*net.UDPAddr).Port)}
+						}
+						instance, err := core.New(&core.Config{Outbound: []*core.OutboundHandlerConfig{{ProxySettings: serial.ToTypedMessage(&freedom.Config{})}}, App: []*serial.TypedMessage{serial.ToTypedMessage(cfg), serial.ToTypedMessage(&dispatcher.Config{}), serial.ToTypedMessage(&proxyman.OutboundConfig{}), serial.ToTypedMessage(&policy.Config{})}})
+						if err != nil {
+							t.Fatal(err)
+						}
+						defer instance.Close()
+						client := instance.GetFeature(fdns.ClientType()).(fdns.ContextClient)
+						ctx0, change0 := hooks.ClosedDNSFixture(t)
+						ctx1, change1 := hooks.ClosedDNSFixture(t)
+						ctx0 = context.WithValue(ctx0, core.XrayKey(1), instance)
+						ctx1 = context.WithValue(ctx1, core.XrayKey(1), instance)
+						changes := []func(string){change0, change1}
+						option := fdns.IPOption{IPv4Enable: true}
+						results := []chan []net.IP{make(chan []net.IP, 1), make(chan []net.IP, 1)}
+						go func() {
+							ips, _, err := client.LookupIPWithContext(ctx0, "private.test", option)
+							if err != nil {
+								t.Logf("caller0 err=%v", err)
+							}
+							results[0] <- ips
+						}()
+						select {
+						case <-entered:
+						case <-time.After(5 * time.Second):
+							t.Fatal("нет exchange")
+						}
+						go func() {
+							ips, _, err := client.LookupIPWithContext(ctx1, "private.test", option)
+							if err != nil {
+								t.Logf("caller1 err=%v", err)
+							}
+							results[1] <- ips
+						}()
+						// Барьер подтверждает два реальных native fetch до выпуска DNS reply.
+						deadline := time.Now().Add(5 * time.Second)
+						for {
+							buf := make([]byte, 1<<20)
+							n := runtime.Stack(buf, true)
+							if strings.Count(string(buf[:n]), "app/dns.fetch(") >= 2 {
+								break
+							}
+							if time.Now().After(deadline) {
+								close(release)
+								t.Fatal("оба caller не вошли в native fetch")
+							}
+							runtime.Gosched()
+						}
+						changes[victim](mode)
+						close(release)
+						for i, ch := range results {
+							select {
+							case ips := <-ch:
+								allowed := mode == "known" || i != victim
+								if allowed {
+									if len(ips) != 1 || !ips[0].Equal(net.ParseIP("192.0.2.17")) {
+										t.Fatalf("caller %d должен получить адрес: %v", i, ips)
+									}
+								} else if len(ips) != 0 {
+									t.Fatalf("caller %d получил адрес без authority: %v", i, ips)
+								}
+							case <-time.After(5 * time.Second):
+								t.Fatal("await завис")
+							}
+						}
+						if queries.Load() != 1 && !(mode == "revoke" && victim == 0 && queries.Load() == 2) {
+							t.Fatalf("coalescing: queries=%d", queries.Load())
+						}
+						// Свежие вызовы используют общий native cache, но повторно проверяют каждого caller.
+						for i, ctx := range []context.Context{ctx0, ctx1} {
+							ips, _, _ := client.LookupIPWithContext(ctx, "private.test", option)
+							allowed := mode == "known" || i != victim
+							if allowed != (len(ips) == 1) {
+								t.Fatalf("cache caller %d: %v", i, ips)
+							}
+						}
+						// Отдельный caller прогревает routing cache, затем теряет authority.
+						cacheCtx, cacheChange := hooks.ClosedDNSFixture(t)
+						cacheCtx = context.WithValue(cacheCtx, core.XrayKey(1), instance)
+						cacheCtx = session.ContextWithOutbounds(cacheCtx, []*session.Outbound{{Target: xnet.TCPDestination(xnet.DomainAddress("private.test"), 443)}})
+						route := rdns.ContextWithDNSClient(rsession.AsRoutingContext(cacheCtx), instance.GetFeature(fdns.ClientType()).(fdns.Client))
+						if ips := route.GetTargetIPs(); len(ips) != 1 {
+							t.Fatalf("warm routing cache: %v", ips)
+						}
+						cacheChange(mode)
+						if ips := route.GetTargetIPs(); (mode == "known") != (len(ips) == 1) {
+							t.Fatalf("routing cache после %s: %v", mode, ips)
+						}
+						if queries.Load() != 1 && !(mode == "revoke" && victim == 0 && queries.Load() == 2) {
+							t.Fatalf("cache miss: queries=%d", queries.Load())
+						}
+					})
+				}
+			}
+		}
+	}

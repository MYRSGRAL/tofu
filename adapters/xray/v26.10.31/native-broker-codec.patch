+)
+
+type countingDialer struct{ calls int }
+
+func (d *countingDialer) Dial(context.Context, net.Address, net.Destination, *internet.SocketConfig) (net.Conn, error) {
+	d.calls++
+	return nil, errors.New("fixture dial")
+}
+func (*countingDialer) DestIpAddress() net.IP { return nil }
+
+func TestActualSystemDialGuard(t *testing.T) {
+	for _, network := range []net.Network{net.Network_TCP, net.Network_UDP} {
+		for _, mode := range []string{"unknown", "unavailable", "stale", "cancel", "revoke", "nohandoff", "known"} {
+			t.Run(network.String()+"/"+mode, func(t *testing.T) {
+				ctx, lookups := hooks.ClosedDialFixture(t, mode, map[net.Network]uint8{net.Network_TCP: 6, net.Network_UDP: 17}[network])
+				d := new(countingDialer)
+				internet.UseAlternativeSystemDialer(d)
+				defer internet.UseAlternativeSystemDialer(nil)
+				dest := net.Destination{Network: network, Address: net.LocalHostIP, Port: 443}
+				for _, opt := range []*internet.SocketConfig{nil, {}} {
+					_, _ = internet.DialSystem(ctx, dest, opt)
+				}
+				want := 0
+				if mode == "known" {
+					want = 2
+					if *lookups != 3 {
+						t.Fatalf("нет fresh lookup: %d", *lookups)
+					}
+				}
+				if d.calls != want {
+					t.Fatalf("dialcounter=%d, ожидалось %d", d.calls, want)
+				}
+			})
+		}
+	}
+}
+
+func TestActualLoopbackSocket(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	for _, network := range []net.Network{net.Network_TCP, net.Network_UDP} {
+		ctx, _ := hooks.ClosedDialFixture(t, "known", map[net.Network]uint8{net.Network_TCP: 6, net.Network_UDP: 17}[network])
+		addr := listener.Addr().(*net.TCPAddr)
+		conn, err := internet.DialSystem(ctx, net.Destination{Network: network, Address: net.LocalHostIP, Port: net.Port(addr.Port)}, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		conn.Close()
+	}
+}

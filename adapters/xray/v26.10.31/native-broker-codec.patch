+func TestFreedomDNSAfterReply(t *testing.T) {
+	for _, udp := range []bool{false, true} {
+		parallel := false
+		for _, mode := range []string{"known", "cancel", "unknown", "epoch", "revoke", "unavailable", "stale"} {
+			t.Run(map[bool]string{false: "tcp", true: "udp"}[udp]+"/"+mode, func(t *testing.T) {
+				listener, err := net.Listen("tcp", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				entered, release := make(chan struct{}), make(chan struct{})
+				server := &mdns.Server{Listener: listener, Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, q *mdns.Msg) {
+					close(entered)
+					<-release
+					reply := new(mdns.Msg)
+					reply.SetReply(q)
+					rr, _ := mdns.NewRR("private.test. 60 IN A 127.0.0.1")
+					reply.Answer = []mdns.RR{rr}
+					_ = w.WriteMsg(reply)
+				})}
+				go server.ActivateAndServe()
+				t.Cleanup(func() { _ = server.Shutdown() })
+				cfg := &appdns.Config{QueryStrategy: appdns.QueryStrategy_USE_IP4, DisableCache: true, EnableParallelQuery: parallel, NameServer: []*appdns.NameServer{{Address: &xnet.Endpoint{Address: xnet.NewIPOrDomain(xnet.DomainAddress("tcp+local://" + listener.Addr().String()))}}}}
+				instance, err := core.New(&core.Config{App: []*serial.TypedMessage{serial.ToTypedMessage(cfg), serial.ToTypedMessage(&dispatcher.Config{}), serial.ToTypedMessage(&proxyman.OutboundConfig{}), serial.ToTypedMessage(&policy.Config{})}})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer instance.Close()
+				tcpListener, err := net.Listen("tcp", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer tcpListener.Close()
+				go func() {
+					for {
+						c, err := tcpListener.Accept()
+						if err != nil {
+							return
+						}
+						_ = c.Close()
+					}
+				}()
+				ctx, change := hooks.ClosedDNSFixture(t)
+				ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: xnet.TCPDestination(xnet.DomainAddress("private.test"), xnet.Port(tcpListener.Addr().(*net.TCPAddr).Port))}})
+				object, err := core.CreateObject(instance, &freedom.Config{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				handler := object.(*freedom.Handler)
+				socket, err := net.ListenPacket("udp", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer socket.Close()
+				sender, err := net.ListenPacket("udp", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer sender.Close()
+				target := xnet.UDPDestination(xnet.DomainAddress("private.test"), xnet.Port(socket.LocalAddr().(*net.UDPAddr).Port))
+				writer := freedom.NewPacketWriter(ctx, &xnet.PacketConnWrapper{PacketConn: sender, Dest: socket.LocalAddr()}, handler, nil, xnet.Destination{}, xnet.UDPDestination(xnet.LocalHostIP, target.Port), nil)
+				dialer := new(freedomDialer)

new file mode 100644
index 0000000..5774bf9
--- /dev/null
+++ b/adapter/dns_resolution_pin_test.go
@@ -0,0 +1,98 @@
+package adapter
+
+import (
+	"github.com/miekg/dns"
+	M "github.com/sagernet/sing/common/metadata"
+	"net/netip"
+	"testing"
+	"time"
+)
+
+func testPin(t *testing.T) (*ResolutionPin, *InboundContext, DNSLookupResult) {
+	t.Helper()
+	address := netip.MustParseAddr("192.0.2.1")
+	target := M.Socksaddr{Fqdn: "Example.org", Port: 443}
+	result := DNSLookupResult{Addresses: []netip.Addr{address}, Families: []DNSResponseProof{{QuestionName: "example.org.", CanonicalName: "example.org.", QueryType: dns.TypeA, Addresses: []netip.Addr{address}, Deadline: time.Now().Add(time.Hour)}}}
+	pin, err := NewResolutionPin(target, result)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return pin, &InboundContext{Destination: target, DestinationAddresses: append([]netip.Addr(nil), result.Addresses...)}, result
+}
+
+func TestResolutionPinImmutableAndExact(t *testing.T) {
+	pin, metadata, result := testPin(t)
+	result.Addresses[0] = netip.MustParseAddr("192.0.2.2")
+	result.Families[0].Addresses[0] = result.Addresses[0]
+	result.Families[0].Deadline = time.Time{}
+	if err := pin.ValidateMetadata(metadata); err != nil {
+		t.Fatal(err)
+	}
+	if err := pin.ValidateDestination(M.SocksaddrFrom(metadata.DestinationAddresses[0], 443)); err != nil {
+		t.Fatal(err)
+	}
+	for _, mutate := range []func(*InboundContext){
+		func(m *InboundContext) { m.Destination.Fqdn = "other.org" },
+		func(m *InboundContext) { m.Destination.Port++ },
+		func(m *InboundContext) { m.DestinationAddresses = []netip.Addr{netip.MustParseAddr("192.0.2.2")} },
+		func(m *InboundContext) { m.DestinationAddresses = nil },
+	} {
+		copy := *metadata
+		mutate(&copy)
+		if pin.ValidateMetadata(&copy) == nil {
+			t.Fatal("accepted mutation")
+		}
+	}
+	for _, target := range []M.Socksaddr{{Fqdn: "example.org", Port: 443}, M.SocksaddrFrom(metadata.DestinationAddresses[0], 80), M.SocksaddrFrom(netip.MustParseAddr("192.0.2.2"), 443)} {
+		if pin.ValidateDestination(target) == nil {
+			t.Fatal("accepted unpinned target")
+		}
+	}
+}
+
+func TestResolutionPinDeadlineBoundary(t *testing.T) {
+	pin, _, _ := testPin(t)
+	deadline := pin.deadlines[0]
+	if pin.fresh(deadline.Add(-time.Nanosecond)) != nil {
+		t.Fatal("expired early")
+	}
+	if pin.fresh(deadline) == nil || pin.fresh(deadline.Add(time.Nanosecond)) == nil {
+		t.Fatal("accepted expired proof")
+	}
+	pin.deadlines = append(pin.deadlines, deadline.Add(-time.Hour))
+	if pin.fresh(deadline.Add(-time.Minute)) == nil {
+		t.Fatal("ignored NODATA/family deadline")
+	}
+}
+
+func TestResolutionPinDefaultUnchanged(t *testing.T) {
+	var pin *ResolutionPin
+	if pin.ValidateDestination(M.Socksaddr{}) != nil || pin.ValidateMetadata(nil) != nil {
+		t.Fatal("changed default")
+	}
+}
+
+func TestResolutionPinRejectsIncompleteProof(t *testing.T) {
+	for _, name := range []string{"wrong question", "missing deadline", "expired deadline", "missing family", "unproved address", "NODATA with address"} {
+		t.Run(name, func(t *testing.T) {
+			_, metadata, result := testPin(t)
+			switch name {
+			case "wrong question":
+				result.Families[0].QuestionName = "other.org."
+			case "missing deadline":
+				result.Families[0].Deadline = time.Time{}
+			case "expired deadline":
+				result.Families[0].Deadline = time.Now().Add(-time.Second)
+			case "missing family":
+				result.Families = nil
+			case "unproved address":
+				result.Families[0].Addresses = []netip.Addr{netip.MustParseAddr("192.0.2.9")}
+			case "NODATA with address":
+				result.Families[0].NoData = true
+			}
+			if _, err := NewResolutionPin(metadata.Destination, result); err == nil {
+				t.Fatal("accepted invalid proof")
+			}
+		})
+	}
+}

+++ b/common/dialer/resolution_pin_test.go
@@ -0,0 +1,136 @@
+package dialer
+
+import (
+	"context"
+	"errors"
+	"github.com/database64128/tfo-go/v2"
+	"github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	M "github.com/sagernet/sing/common/metadata"
+	"net"
+	"net/netip"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func pinContext(t *testing.T) (context.Context, M.Socksaddr, []netip.Addr, time.Time) {
+	t.Helper()
+	addresses := []netip.Addr{netip.MustParseAddr("192.0.2.1"), netip.MustParseAddr("192.0.2.2")}
+	target := M.Socksaddr{Fqdn: "example.org", Port: 443}
+	deadline := time.Now().Add(100 * time.Millisecond)
+	pin, err := adapter.NewResolutionPin(target, adapter.DNSLookupResult{Addresses: addresses, Families: []adapter.DNSResponseProof{{QuestionName: "example.org.", CanonicalName: "example.org.", Addresses: addresses, QueryType: dns.TypeA, Deadline: deadline}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return adapter.ContextWithResolutionPin(context.Background(), pin), target, addresses, deadline
+}
+
+type retryPinDialer struct {
+	calls    int
+	deadline time.Time
+}
+
+func (d *retryPinDialer) DialContext(ctx context.Context, network string, address M.Socksaddr) (net.Conn, error) {
+	d.calls++
+	<-time.After(time.Until(d.deadline))
+	return nil, errors.New("synthetic first attempt failure")
+}
+func (d *retryPinDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	panic("unused")
+}
+
+func TestResolutionPinStopsExpiredRetry(t *testing.T) {
+	ctx, target, addresses, deadline := pinContext(t)
+	d := &retryPinDialer{deadline: deadline}
+	_, err := DialSerialNetwork(ctx, d, "tcp", target, addresses, nil, nil, nil, 0)
+	if err == nil || !strings.Contains(err.Error(), "expired") || d.calls != 1 {
+		t.Fatalf("calls=%d err=%v", d.calls, err)
+	}
+	_, err = DialSerialNetwork(ctx, d, "tcp", target, addresses, nil, nil, nil, 0)
+	if err == nil || d.calls != 1 {
+		t.Fatalf("expired first dial calls=%d err=%v", d.calls, err)
+	}
+}
+
+func TestResolutionPinStopsDelayedTFO(t *testing.T) {
+	ctx, target, addresses, deadline := pinContext(t)
+	conn, err := DialSlowContext(&tfo.Dialer{}, ctx, "", "tcp", M.SocksaddrFrom(addresses[0], target.Port))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	<-time.After(time.Until(deadline))
+	n, err := conn.Write([]byte("must not be sent"))
+	if n != 0 || err == nil || !strings.Contains(err.Error(), "expired") {
+		t.Fatalf("n=%d err=%v", n, err)
+	}
+}
+
+func TestResolutionPinStopsUnpinnedActualDial(t *testing.T) {
+	ctx, _, _, _ := pinContext(t)
+	_, err := dialPinnedContext(ctx, &net.Dialer{}, "tcp", "192.0.2.9:443")
+	if err == nil || !strings.Contains(err.Error(), "unpinned") {
+		t.Fatal(err)
+	}
+}
+
+func TestResolutionPinRechecksAfterSlowControlHook(t *testing.T) {
+	ctx, _, addresses, deadline := pinContext(t)
+	calls := 0
+	guarded := pinNetDialer(ctx, net.Dialer{Control: func(string, string, syscall.RawConn) error { calls++; <-time.After(time.Until(deadline)); return nil }})
+	err := guarded.ControlContext(ctx, "tcp4", M.SocksaddrFrom(addresses[0], 443).String(), nil)
+	if calls != 1 || err == nil || !strings.Contains(err.Error(), "expired") {
+		t.Fatalf("calls=%d err=%v", calls, err)
+	}
+}
+
+func TestResolutionPinClampsConnectDeadline(t *testing.T) {
+	ctx, _, _, deadline := pinContext(t)
+	if got := pinNetDialer(ctx, net.Dialer{}).Deadline; !got.Equal(deadline) {
+		t.Fatalf("deadline=%v want=%v", got, deadline)
+	}
+	earlier := deadline.Add(-time.Minute)
+	if got := pinNetDialer(ctx, net.Dialer{Deadline: earlier}).Deadline; !got.Equal(earlier) {
+		t.Fatalf("overrode earlier dialer deadline: %v", got)
+	}
+	ctx, cancel := context.WithDeadline(ctx, earlier)
+	defer cancel()
+	if got := pinNetDialer(ctx, net.Dialer{}).Deadline; !got.Equal(earlier) {
+		t.Fatalf("ignored context deadline: %v", got)
+	}
+}
+
+func TestResolutionPinPreservesControlContextPrecedence(t *testing.T) {
+	ctx, _, addresses, _ := pinContext(t)
+	calls := 0
+	guarded := pinNetDialer(ctx, net.Dialer{Control: func(string, string, syscall.RawConn) error {
+		t.Fatal("Control called despite ControlContext")
+		return nil
+	}, ControlContext: func(context.Context, string, string, syscall.RawConn) error { calls++; return nil }})
+	if err := guarded.ControlContext(ctx, "tcp4", M.SocksaddrFrom(addresses[0], 443).String(), nil); err != nil || calls != 1 {
+		t.Fatalf("calls=%d err=%v", calls, err)
+	}
+}
+
+func TestResolutionPinBoundsWholeTFOEstablishmentContext(t *testing.T) {
+	ctx, target, addresses, deadline := pinContext(t)
+	for _, dialDeadline := range []time.Time{{}, deadline.Add(-20 * time.Millisecond)} {
+		conn, err := DialSlowContext(&tfo.Dialer{Dialer: net.Dialer{Deadline: dialDeadline}}, ctx, "", "tcp", M.SocksaddrFrom(addresses[0], target.Port))
+		if err != nil {
+			t.Fatal(err)
+		}
+		slow := conn.(*slowOpenConn)
+		got, present := slow.ctx.Deadline()
+		want := deadline
+		if !dialDeadline.IsZero() {
+			want = dialDeadline
+		}
+		if !present || !got.Equal(want) {
+			conn.Close()
+			t.Fatalf("TFO initial Write has no full establishment deadline: got=%v present=%v want=%v", got, present, want)
+		}
+		conn.Close()
+	}
+}

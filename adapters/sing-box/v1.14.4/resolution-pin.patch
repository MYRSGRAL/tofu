diff --git a/common/dialer/resolution_pin.go b/common/dialer/resolution_pin.go
new file mode 100644
index 0000000..fd5d556
--- /dev/null
+++ b/common/dialer/resolution_pin.go
@@ -0,0 +1,57 @@
+package dialer
+
+import (
+	"context"
+	"net"
+	"syscall"
+
+	"github.com/sagernet/sing-box/adapter"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func dialPinnedContext(ctx context.Context, dialer *net.Dialer, network, address string) (net.Conn, error) {
+	if err := adapter.ValidateResolutionDial(ctx, M.ParseSocksaddr(address)); err != nil {
+		return nil, err
+	}
+	guarded := pinNetDialer(ctx, *dialer)
+	conn, err := guarded.DialContext(ctx, network, address)
+	if err != nil {
+		if pinErr := adapter.ValidateResolutionDial(ctx, M.ParseSocksaddr(address)); pinErr != nil {
+			return nil, pinErr
+		}
+	}
+	return conn, err
+}
+
+// ControlContext повторяет проверку после потенциально медленных bind/control hooks,
+// непосредственно перед connect; каждый системный fallback получает свой guard.
+func pinNetDialer(ctx context.Context, dialer net.Dialer) net.Dialer {
+	pin := adapter.ResolutionPinFromContext(ctx)
+	if pin == nil {
+		return dialer
+	}
+	deadline := pin.Deadline()
+	if ctxDeadline, ok := ctx.Deadline(); ok && ctxDeadline.Before(deadline) {
+		deadline = ctxDeadline
+	}
+	if dialer.Deadline.IsZero() || deadline.Before(dialer.Deadline) {
+		dialer.Deadline = deadline
+	}
+	originalContext, original := dialer.ControlContext, dialer.Control
+	dialer.ControlContext = func(ctx context.Context, network, address string, conn syscall.RawConn) error {
+		if err := adapter.ValidateResolutionDial(ctx, M.ParseSocksaddr(address)); err != nil {
+			return err
+		}
+		if originalContext != nil {
+			if err := originalContext(ctx, network, address, conn); err != nil {
+				return err
+			}
+		} else if original != nil {
+			if err := original(network, address, conn); err != nil {
+				return err
+			}
+		}
+		return adapter.ValidateResolutionDial(ctx, M.ParseSocksaddr(address))
+	}
+	return dialer
+}
diff --git a/common/dialer/resolution_pin_test.go b/common/dialer/resolution_pin_test.go

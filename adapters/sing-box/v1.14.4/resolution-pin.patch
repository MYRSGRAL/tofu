diff --git a/adapter/dns_resolution_pin.go b/adapter/dns_resolution_pin.go
new file mode 100644
index 0000000..62219a5
--- /dev/null
+++ b/adapter/dns_resolution_pin.go
@@ -0,0 +1,128 @@
+package adapter
+
+import (
+	"context"
+	"fmt"
+	"net/netip"
+	"strings"
+	"time"
+
+	"github.com/miekg/dns"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+// ResolutionPin фиксирует только DNS-ответ и TTL. Это не lease сети или политики.
+// Поля закрыты: вызывающий не может изменить выданное доказательство.
+type ResolutionPin struct {
+	destination M.Socksaddr
+	addresses   map[netip.Addr]struct{}
+	deadlines   []time.Time
+}
+
+func NewResolutionPin(destination M.Socksaddr, result DNSLookupResult) (*ResolutionPin, error) {
+	if !destination.IsDomain() || len(result.Addresses) == 0 || len(result.Addresses) > 64 || len(result.Families) == 0 || len(result.Families) > 2 {
+		return nil, fmt.Errorf("pin_resolution: invalid DNS proof")
+	}
+	pin := &ResolutionPin{destination: destination, addresses: make(map[netip.Addr]struct{}, len(result.Addresses))}
+	for _, address := range result.Addresses {
+		if !address.IsValid() || address.Is4In6() {
+			return nil, fmt.Errorf("pin_resolution: invalid address")
+		}
+		pin.addresses[address] = struct{}{}
+	}
+	if len(pin.addresses) != len(result.Addresses) {
+		return nil, fmt.Errorf("pin_resolution: duplicate address")
+	}
+	proved := make(map[netip.Addr]struct{}, len(result.Addresses))
+	types := make(map[uint16]bool)
+	for _, proof := range result.Families {
+		if canonicalPinName(proof.QuestionName) != canonicalPinName(destination.Fqdn) || proof.CanonicalName == "" || proof.Deadline.IsZero() || types[proof.QueryType] || (proof.QueryType != dns.TypeA && proof.QueryType != dns.TypeAAAA) || proof.NoData != (len(proof.Addresses) == 0) {
+			return nil, fmt.Errorf("pin_resolution: incomplete DNS proof")
+		}
+		types[proof.QueryType] = true
+		pin.deadlines = append(pin.deadlines, proof.Deadline)
+		for _, address := range proof.Addresses {
+			if (proof.QueryType == dns.TypeA) != address.Is4() {
+				return nil, fmt.Errorf("pin_resolution: address family mismatch")
+			}
+			if _, ok := pin.addresses[address]; !ok {
+				return nil, fmt.Errorf("pin_resolution: unproved address")
+			}
+			if _, ok := proved[address]; ok {
+				return nil, fmt.Errorf("pin_resolution: duplicate proof")
+			}
+			proved[address] = struct{}{}
+		}
+	}
+	if len(proved) != len(pin.addresses) {
+		return nil, fmt.Errorf("pin_resolution: unproved address set")
+	}
+	return pin, pin.fresh(time.Now())
+}
+
+func canonicalPinName(name string) string { return strings.ToLower(dns.Fqdn(name)) }
+
+func (p *ResolutionPin) fresh(now time.Time) error {
+	for _, deadline := range p.deadlines {
+		if !now.Before(deadline) {
+			return fmt.Errorf("pin_resolution: DNS proof expired; new flow required")
+		}
+	}
+	return nil
+}
+
+func (p *ResolutionPin) ValidateMetadata(metadata *InboundContext) error {
+	if p == nil {
+		return nil
+	}
+	if canonicalPinName(metadata.Destination.Fqdn) != canonicalPinName(p.destination.Fqdn) || metadata.Destination.Addr.IsValid() || metadata.Destination.Port != p.destination.Port || len(metadata.DestinationAddresses) != len(p.addresses) {
+		return fmt.Errorf("pin_resolution: destination overridden")
+	}
+	seen := make(map[netip.Addr]bool, len(p.addresses))
+	for _, address := range metadata.DestinationAddresses {
+		if _, ok := p.addresses[address]; !ok || seen[address] {
+			return fmt.Errorf("pin_resolution: address set overridden")
+		}
+		seen[address] = true
+	}
+	return p.fresh(time.Now())
+}
+
+func (p *ResolutionPin) ValidateDestination(destination M.Socksaddr) error {
+	if p == nil {
+		return nil
+	}
+	if destination.IsDomain() || destination.Port != p.destination.Port {
+		return fmt.Errorf("pin_resolution: unpinned destination")
+	}
+	if _, ok := p.addresses[destination.Addr]; !ok {
+		return fmt.Errorf("pin_resolution: unpinned address")
+	}
+	return p.fresh(time.Now())
+}
+
+type resolutionPinKey struct{}
+
+func ContextWithResolutionPin(ctx context.Context, pin *ResolutionPin) context.Context {
+	return context.WithValue(ctx, resolutionPinKey{}, pin)
+}
+
+func ResolutionPinFromContext(ctx context.Context) *ResolutionPin {
+	pin, _ := ctx.Value(resolutionPinKey{}).(*ResolutionPin)
+	return pin
+}
+
+func ValidateResolutionDial(ctx context.Context, destination M.Socksaddr) error {
+	return ResolutionPinFromContext(ctx).ValidateDestination(destination)
+}
+
+// Deadline ограничивает ожидание установки соединения самым ранним TTL семейства.
+func (p *ResolutionPin) Deadline() time.Time {
+	var earliest time.Time
+	for _, deadline := range p.deadlines {
+		if earliest.IsZero() || deadline.Before(earliest) {
+			earliest = deadline
+		}
+	}
+	return earliest
+}

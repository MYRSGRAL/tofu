+	"net/netip"
+	"strings"
+	"testing"
+	"time"
+)
+
+type countingPacketConn struct{ writes int }
+
+func (c *countingPacketConn) WriteTo(p []byte, _ net.Addr) (int, error) {
+	c.writes++
+	return len(p), nil
+}
+func (c *countingPacketConn) ReadFrom([]byte) (int, net.Addr, error) { panic("unused") }
+func (c *countingPacketConn) Close() error                           { return nil }
+func (c *countingPacketConn) LocalAddr() net.Addr                    { return &net.UDPAddr{} }
+func (c *countingPacketConn) SetDeadline(time.Time) error            { return nil }
+func (c *countingPacketConn) SetReadDeadline(time.Time) error        { return nil }
+func (c *countingPacketConn) SetWriteDeadline(time.Time) error       { return nil }
+func (c *countingPacketConn) Upstream() any                          { return c }
+
+func TestPinnedPacketConnPerDatagram(t *testing.T) {
+	address := netip.MustParseAddr("192.0.2.1")
+	deadline := time.Now().Add(100 * time.Millisecond)
+	pin, err := adapter.NewResolutionPin(M.Socksaddr{Fqdn: "example.org", Port: 443}, adapter.DNSLookupResult{Addresses: []netip.Addr{address}, Families: []adapter.DNSResponseProof{{QuestionName: "example.org.", CanonicalName: "example.org.", Addresses: []netip.Addr{address}, QueryType: dns.TypeA, Deadline: deadline}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw := &countingPacketConn{}
+	conn := &pinnedPacketConn{conn: raw, pin: pin}
+	target := net.UDPAddrFromAddrPort(netip.AddrPortFrom(address, 443))
+	if n, err := conn.WriteTo([]byte("valid"), target); n != 5 || err != nil {
+		t.Fatalf("n=%d err=%v", n, err)
+	}
+	if _, err := conn.WriteTo([]byte("wrong"), &net.UDPAddr{IP: net.ParseIP("192.0.2.2"), Port: 443}); err == nil {
+		t.Fatal("accepted other target")
+	}
+	if _, ok := any(conn).(interface{ Upstream() any }); ok {
+		t.Fatal("raw socket unwrap exposed")
+	}
+	<-time.After(time.Until(deadline))
+	if n, err := conn.WriteTo([]byte("expired"), target); n != 0 || err == nil || !strings.Contains(err.Error(), "expired") {
+		t.Fatalf("n=%d err=%v", n, err)
+	}
+	if raw.writes != 1 {
+		t.Fatalf("writes=%d", raw.writes)
+	}
+}
+
+type pinDNSRouter struct {
+	adapter.DNSRouter
+	calls   int
+	options adapter.DNSQueryOptions
+	result  adapter.DNSLookupResult
+}
+
+func (d *pinDNSRouter) LookupWithProvenance(ctx context.Context, domain string, options adapter.DNSQueryOptions) (adapter.DNSLookupResult, error) {
+	d.calls++
+	d.options = options
+	return d.result, nil
+}
+
+func TestResolveActionPinsAndForbidsSecondLookup(t *testing.T) {
+	address := netip.MustParseAddr("192.0.2.1")
+	dnsRouter := &pinDNSRouter{result: adapter.DNSLookupResult{Addresses: []netip.Addr{address}, Families: []adapter.DNSResponseProof{{QuestionName: "example.org.", CanonicalName: "alias.org.", Addresses: []netip.Addr{address}, QueryType: dns.TypeA, Deadline: time.Now().Add(time.Hour)}}}}
+	router := &Router{dns: dnsRouter, logger: log.NewNOPFactory().Logger()}
+	metadata := &adapter.InboundContext{Destination: M.Socksaddr{Fqdn: "EXAMPLE.org.", Port: 443}}
+	action := &R.RuleActionResolve{PinResolution: true}
+	if err := router.actionResolve(context.Background(), metadata, action); err != nil {
+		t.Fatal(err)
+	}
+	if !dnsRouter.options.StrictComplete || !dnsRouter.options.RequireProvenance || dnsRouter.calls != 1 || metadata.ResolutionPin == nil || metadata.Destination.Fqdn != "EXAMPLE.org." {
+		t.Fatalf("options=%+v metadata=%+v", dnsRouter.options, metadata)
+	}
+	dnsRouter.result.Addresses[0] = netip.MustParseAddr("192.0.2.9")
+	if err := metadata.ResolutionPin.ValidateMetadata(metadata); err != nil {
+		t.Fatal(err)
+	}
+	if err := router.actionResolve(context.Background(), metadata, action); err == nil || dnsRouter.calls != 1 {
+		t.Fatalf("second lookup calls=%d err=%v", dnsRouter.calls, err)
+	}
+}
+
+func TestPinnedUDPAfterNATWithoutBatchEscape(t *testing.T) {
+	address := netip.MustParseAddr("192.0.2.1")
+	target := M.Socksaddr{Fqdn: "example.org", Port: 443}
+	pin, err := adapter.NewResolutionPin(target, adapter.DNSLookupResult{Addresses: []netip.Addr{address}, Families: []adapter.DNSResponseProof{{QuestionName: "example.org.", CanonicalName: "example.org.", Addresses: []netip.Addr{address}, QueryType: dns.TypeA, Deadline: time.Now().Add(time.Hour)}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw := &countingPacketConn{}
+	guard := &pinnedPacketConn{conn: raw, pin: pin}
+	nat := bufio.NewNATPacketConn(bufio.NewPacketConn(guard), M.SocksaddrFrom(address, 443), target)
+	payload := buf.As([]byte("valid"))
+	if err := nat.WritePacket(payload, target); err != nil {
+		t.Fatal(err)
+	}
+	if raw.writes != 1 {
+		t.Fatalf("writes=%d", raw.writes)
+	}
+	writer := N.UnwrapPacketWriter(nat)
+	if _, ok := writer.(N.PacketBatchWriter); ok {
+		t.Fatal("batch writer exposed")
+	}
+	if _, ok := writer.(N.ConnectedPacketBatchWriter); ok {
+		t.Fatal("connected batch writer exposed")
+	}
+	guard.connected = M.SocksaddrFrom(address, 443)
+	if _, err := guard.WriteTo([]byte("wrong port"), net.UDPAddrFromAddrPort(netip.AddrPortFrom(address, 80))); err == nil {
+		t.Fatal("accepted connected UDP mismatch")
+	}
+}

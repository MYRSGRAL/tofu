+++ b/route/resolution_pin.go
@@ -0,0 +1,34 @@
+package route
+
+import (
+	"fmt"
+	"github.com/sagernet/sing-box/adapter"
+	M "github.com/sagernet/sing/common/metadata"
+	"net"
+	"time"
+)
+
+type pinnedPacketConn struct {
+	conn      net.PacketConn
+	pin       *adapter.ResolutionPin
+	connected M.Socksaddr
+}
+
+func (c *pinnedPacketConn) WriteTo(payload []byte, destination net.Addr) (int, error) {
+	target := M.SocksaddrFromNet(destination)
+	if c.connected.IsValid() && c.connected != target {
+		return 0, fmt.Errorf("pin_resolution: connected UDP destination overridden")
+	}
+	if err := c.pin.ValidateDestination(target); err != nil {
+		return 0, err
+	}
+	return c.conn.WriteTo(payload, destination)
+}
+func (c *pinnedPacketConn) ReadFrom(payload []byte) (int, net.Addr, error) {
+	return c.conn.ReadFrom(payload)
+}
+func (c *pinnedPacketConn) Close() error                       { return c.conn.Close() }
+func (c *pinnedPacketConn) LocalAddr() net.Addr                { return c.conn.LocalAddr() }
+func (c *pinnedPacketConn) SetDeadline(t time.Time) error      { return c.conn.SetDeadline(t) }
+func (c *pinnedPacketConn) SetReadDeadline(t time.Time) error  { return c.conn.SetReadDeadline(t) }
+func (c *pinnedPacketConn) SetWriteDeadline(t time.Time) error { return c.conn.SetWriteDeadline(t) }

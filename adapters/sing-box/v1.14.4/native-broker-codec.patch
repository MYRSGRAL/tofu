diff --git a/common/yonikbroker/socket.go b/common/yonikbroker/socket.go
new file mode 100644
index 0000000..4868a9e
--- /dev/null
+++ b/common/yonikbroker/socket.go
@@ -0,0 +1,40 @@
+package nativehooks
+
+import (
+	"context"
+	"io"
+	"time"
+)
+
+// OwnSocket передаёт session единственное право закрытия опубликованного сокета.
+func OwnSocket(ctx context.Context, socket io.Closer) (func() error, error) {
+	c, ok := ctx.Value(routingKey{}).(*routingConsumer)
+	if !ok || c == nil {
+		_ = socket.Close()
+		return nil, ErrDenied
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.session == nil || ctx.Err() != nil {
+		_ = socket.Close()
+		return nil, ErrDenied
+	}
+	lookup := c.lookup
+	if lookup == nil {
+		lookup = c.lookupAuthenticated
+	}
+	proof, err := lookup(ctx, c.flow)
+	if err != nil || ctx.Err() != nil {
+		_ = socket.Close()
+		_ = c.session.Revoke()
+		return nil, ErrDenied
+	}
+	handle, err := c.session.Track(time.Now(), c.required, c.flow, proof, socket)
+	if err != nil {
+		_ = socket.Close()
+		_ = c.session.Revoke()
+		return nil, err
+	}
+	stop := context.AfterFunc(ctx, func() { _ = c.session.Revoke() })
+	return func() error { stop(); return c.session.Release(handle) }, nil
+}

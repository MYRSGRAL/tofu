+package nativehooks
+
+import (
+	"context"
+	"os"
+	"testing"
+	"time"
+)
+
+func ClosedRoutingFixture(t *testing.T, status Status) context.Context {
+	s, p, _ := fixture(t)
+	p.Status = status
+	return context.WithValue(context.Background(), routingKey{}, &routingConsumer{session: s, required: true, flow: p.Flow, lookup: func(context.Context, Flow) (Evidence, error) { return p, nil }})
+}
+
+func ClosedTUNFixture(t *testing.T) (context.Context, *os.File, func()) {
+	ctx, original, cancel := closedTUNFixture(t)
+	c := ctx.Value(routingKey{}).(*routingConsumer)
+	return ctx, original, func() {
+		cancel()
+		select {
+		case <-c.session.revokeDone:
+		case <-time.After(time.Second):
+			t.Fatal("native revoke deadline")
+		}
+	}
+}
+
+// ClosedSocketFixture меняет ответ только в закрытом тестовом consumer.
+func ClosedSocketFixture(t *testing.T) (context.Context, func(string), func() int) {
+	s, p, _ := fixture(t)
+	calls := 0
+	c := &routingConsumer{session: s, required: true, flow: p.Flow}
+	c.lookup = func(context.Context, Flow) (Evidence, error) { calls++; return p, nil }
+	ctx := context.WithValue(context.Background(), routingKey{}, c)
+	return ctx, func(mode string) {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		switch mode {
+		case "unknown":
+			p.Status = Unknown
+		case "unavailable":
+			p.Status = Unavailable
+		case "stale":
+			p.Binding.Epoch++
+		case "expired":
+			p.Expires = time.Now().Add(-time.Second)
+		case "revoke":
+			_ = s.Revoke()
+		}
+	}, func() int { c.mu.Lock(); defer c.mu.Unlock(); return calls }
+}
diff --git a/common/yonikbroker/routing.go b/common/yonikbroker/routing.go
new file mode 100644
index 0000000..964da67
--- /dev/null
+++ b/common/yonikbroker/routing.go
@@ -0,0 +1,100 @@
+package nativehooks
+
+import (
+	"context"
+	"os"
+	"sync"
+	"syscall"
+	"time"
+)
+
+// routingKey закрыт: config, env и caller assertions не создают authority.
+type routingKey struct{}
+
+// routingConsumer создаётся только closed worker handoff; production producer ещё не подключён.
+type routingConsumer struct {
+	mu             sync.Mutex
+	session        *Session
+	required       bool
+	flow           Flow
+	bootstrap      Bootstrap
+	channel, pidfd *os.File
+	owned          *os.File
+	ownedHandle    *Handle
+	attached       AttachBody
+	sequence       Sequence
+	next           uint64
+	lookup         func(context.Context, Flow) (Evidence, error) // Только закрытый test fixture.
+}
+
+// RoutingEntry проверяет исходный tuple до forced tag, PickRoute и default outbound.
+// Отсутствие trusted handoff всегда закрывает routing.
+func BeforeSocketDial(ctx context.Context) error { return guardEntry(ctx, BeforeDial) }
+
+func RoutingEntry(ctx context.Context) error { return guardEntry(ctx, BeforeRouting) }
+
+func guardEntry(ctx context.Context, stage Stage) error {
+	c, ok := ctx.Value(routingKey{}).(*routingConsumer)
+	if !ok || c == nil {
+		return ErrDenied
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.session == nil {
+		return ErrDenied
+	}
+	if ctx.Err() != nil {
+		c.sequence.Retire()
+		_ = c.session.Revoke()
+		return ErrDenied
+	}
+	if !c.required {
+		return c.session.Guard(time.Now(), stage, false, Flow{}, Evidence{})
+	}
+	lookup := c.lookup
+	if lookup == nil {
+		lookup = c.lookupAuthenticated
+	}
+	proof, err := lookup(ctx, c.flow)
+	if err != nil || ctx.Err() != nil {
+		c.sequence.Retire()
+		_ = c.session.Revoke()
+		return ErrDenied
+	}
+	if err := c.session.Guard(time.Now(), stage, true, c.flow, proof); err != nil {
+		c.sequence.Retire()
+		_ = c.session.Revoke()
+		return err
+	}
+	return nil
+}
+
+// lookupAuthenticated не принимает proof от inbound/config: только authenticated wire reply.
+func (c *routingConsumer) lookupAuthenticated(ctx context.Context, flow Flow) (Evidence, error) {
+	if c.channel == nil || c.pidfd == nil || ctx.Err() != nil {
+		return Evidence{}, ErrDenied
+	}
+	c.next++
+	if c.sequence.Begin(c.next) != nil {
+		return Evidence{}, ErrDenied
+	}
+	started := time.Now()
+	fail := func() (Evidence, error) { c.sequence.Retire(); _ = c.session.Revoke(); return Evidence{}, ErrDenied }
+	request, err := EncodeLookup(c.bootstrap.Binding, c.next, flow)
+	if err != nil || c.bootstrap.CheckServer(c.pidfd) != nil {
+		return fail()
+	}
+	if err := syscall.Sendmsg(int(c.channel.Fd()), request, nil, nil, syscall.MSG_DONTWAIT|syscall.MSG_NOSIGNAL); err != nil {
+		return fail()
+	}
+	reply, files, err := c.bootstrap.ReceiveAuthenticated(c.channel, c.pidfd)
+	for _, file := range files {
+		_ = file.Close()
+	}
+	if ctx.Err() != nil || err != nil || len(files) != 0 || reply.Header.Kind != ReplyKind || reply.CheckBinding(c.bootstrap.Binding, c.next) != nil || c.sequence.Complete(c.next) != nil {
+		return fail()
+	}
+	now := time.Now()
+	ttl := EffectiveReplyTTL(reply.Reply.TTL, started, now)
+	return Evidence{Flow: flow, Binding: c.bootstrap.Binding, Status: reply.Reply.Status, Observed: now, Expires: now.Add(ttl), ExecutableDevice: reply.Reply.ExecutableDevice, ExecutableInode: reply.Reply.ExecutableInode}, nil
+}

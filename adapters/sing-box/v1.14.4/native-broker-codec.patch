+// ProtectPath расположен в настоящем control path системного dial/listen.
+// Счётчик считает handoff native FD, а не прямые вызовы broker guard.
+func TestActualSocketHandoffCounter(t *testing.T) {
+	for _, network := range []string{"tcp", "udp", "listen"} {
+		for _, mode := range []string{"known", "no-handoff", "unknown", "unavailable", "stale", "expired", "cancel", "revoke"} {
+			t.Run(network+"/"+mode, func(t *testing.T) {
+				var id [16]byte
+				if _, err := rand.Read(id[:]); err != nil {
+					t.Fatal(err)
+				}
+				path := "@yonik-counter-" + hex.EncodeToString(id[:])
+				l, err := net.ListenUnix("unix", &net.UnixAddr{Name: path, Net: "unix"})
+				if err != nil {
+					t.Fatal(err)
+				}
+				var calls atomic.Int32
+				done := make(chan struct{})
+				go func() {
+					defer close(done)
+					for {
+						c, e := l.AcceptUnix()
+						if e != nil {
+							return
+						}
+						b := make([]byte, 1)
+						oob := make([]byte, 128)
+						_, n, _, _, e := c.ReadMsgUnix(b, oob)
+						if e == nil {
+							msgs, _ := syscall.ParseSocketControlMessage(oob[:n])
+							for _, msg := range msgs {
+								fds, _ := syscall.ParseUnixRights(&msg)
+								for _, fd := range fds {
+									_ = syscall.Close(fd)
+								}
+							}
+							calls.Add(1)
+							_, _ = c.Write([]byte{1})
+						}
+						_ = c.Close()
+					}
+				}()
+				defer func() { _ = l.Close(); <-done }()
+				ctx, change, _ := H.ClosedSocketFixture(t)
+				if err := H.RoutingEntry(ctx); err != nil {
+					t.Fatal(err)
+				}
+				change(mode)
+				if mode == "no-handoff" {
+					ctx = context.Background()
+				}
+				ctx, cancel := context.WithCancel(ctx)
+				defer cancel()
+				if mode == "cancel" {
+					cancel()
+				}
+				opts := option.DialerOptions{}
+				opts.ProtectPath = path
+				d, err := D.NewDefault(ctx, opts)
+				if err != nil {
+					t.Fatal(err)
+				}
+				target, err := net.Listen("tcp4", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer target.Close()
+				var c interface{ Close() error }
+				if network == "listen" {
+					c, err = d.ListenPacket(ctx, M.ParseSocksaddr("127.0.0.1:12345"))
+				} else {
+					c, err = d.DialContext(ctx, network, M.ParseSocksaddr(target.Addr().String()))
+				}
+				if err == nil {
+					defer c.Close()
+				}
+				want := int32(0)
+				if mode == "known" {
+					want = 1
+				}
+				if calls.Load() != want || (err == nil) != (mode == "known") {
+					t.Fatalf("native handoffs=%d want=%d err=%v", calls.Load(), want, err)
+				}
+			})
+		}
+	}
+}

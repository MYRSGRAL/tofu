@@ -0,0 +1,109 @@
+package dns
+
+import (
+	"context"
+	"github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	H "github.com/sagernet/sing-box/common/yonikbroker"
+)
+
+// Ключ включает полное wire-сообщение без request ID и все параметры обработки.
+// Session предотвращает перенос lifetime/authority между admitted сессиями.
+type nativeExchangeKey struct {
+	session *H.Session
+	wire    string
+	cache   dnsCacheKey
+	options adapter.DNSQueryOptions
+}
+type nativeExchange struct {
+	group    *H.DNSExchange
+	done     chan struct{}
+	waiters  int
+	response *dns.Msg
+	proof    *adapter.DNSResponseProof
+	err      error
+}
+
+func (c *Client) nativeExchange(ctx context.Context, transport adapter.DNSTransport, message *dns.Msg, options adapter.DNSQueryOptions) (*dns.Msg, *adapter.DNSResponseProof, error) {
+	if err := H.DNSGuard(ctx); err != nil {
+		return nil, nil, err
+	}
+	if len(message.Question) != 1 {
+		return c.exchangeUnshared(ctx, transport, message, options, nil)
+	}
+	if options.Timeout == 0 {
+		options.Timeout = c.timeout
+	}
+	authorityContext := ctx
+	ctx, cancel := context.WithTimeout(ctx, options.Timeout)
+	defer cancel()
+	query := c.prepareExchangeMessage(message.Copy(), options)
+	query.Id = 0
+	wire, err := query.Pack()
+	if err != nil {
+		return nil, nil, err
+	}
+	key := nativeExchangeKey{session: H.DNSIdentity(ctx), wire: string(wire), cache: c.newCacheKey(transport, query.Question[0], query, options), options: options}
+	// Transport задаётся существующим cache key.
+	key.options.Transport = nil
+	// Не объединяем вызовы с индивидуальным переписыванием TTL.
+	if options.RewriteTTL != nil {
+		return c.exchangeUnshared(ctx, transport, message, options, nil)
+	}
+	c.nativeMu.Lock()
+	if c.nativeExchanges == nil {
+		c.nativeExchanges = make(map[nativeExchangeKey]*nativeExchange)
+	}
+	exchange := c.nativeExchanges[key]
+	fresh := exchange == nil
+	if fresh {
+		if len(c.nativeExchanges) >= H.MaxTrackedFlows {
+			c.nativeMu.Unlock()
+			return nil, nil, H.ErrDenied
+		}
+		exchange = &nativeExchange{group: H.NewDNSExchange(adapter.OverrideContext(ctx)), done: make(chan struct{})}
+		c.nativeExchanges[key] = exchange
+	}
+	leave, err := exchange.group.Join(authorityContext)
+	if err != nil {
+		if fresh {
+			delete(c.nativeExchanges, key)
+			exchange.group.Close()
+		}
+		c.nativeMu.Unlock()
+		return nil, nil, err
+	}
+	exchange.waiters++
+	c.nativeMu.Unlock()
+	defer func() {
+		c.nativeMu.Lock()
+		exchange.waiters--
+		if exchange.waiters == 0 && c.nativeExchanges[key] == exchange {
+			delete(c.nativeExchanges, key)
+		}
+		leave()
+		c.nativeMu.Unlock()
+	}()
+	if fresh {
+		go func() {
+			worker, stop := context.WithTimeout(exchange.group.Context(), options.Timeout)
+			defer stop()
+			exchange.response, exchange.proof, exchange.err = c.exchangeUnshared(worker, transport, message.Copy(), options, nil)
+			close(exchange.done)
+		}()
+	}
+	select {
+	case <-ctx.Done():
+		return nil, nil, ctx.Err()
+	case <-exchange.done:
+	}
+	if err := H.DNSGuard(ctx); err != nil {
+		return nil, nil, err
+	}
+	if exchange.response == nil {
+		return nil, nil, exchange.err
+	}
+	response := exchange.response.Copy()
+	response.Id = message.Id
+	return response, cloneProof(exchange.proof), exchange.err
+}

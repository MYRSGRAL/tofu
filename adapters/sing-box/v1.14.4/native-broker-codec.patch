diff --git a/common/yonikbroker/closed_tun_linux.go b/common/yonikbroker/closed_tun_linux.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/closed_tun_linux.go
@@ -0,0 +1,241 @@
+//go:build linux && !android
+
+package nativehooks
+
+import (
+	"context"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// closedAttach принимает владение только уже аутентифицированным worker handoff.
+// Production issuer пока не подключён; config/env не вызывают этот конструктор.
+func closedAttach(ctx context.Context, record []byte, channel, pidfd *os.File) (context.Context, error) {
+	ok := false
+	defer func() {
+		if !ok {
+			if channel != nil {
+				_ = channel.Close()
+			}
+			if pidfd != nil {
+				_ = pidfd.Close()
+			}
+		}
+	}()
+	b, err := DecodeBootstrap(record, 2)
+	if err != nil || ctx.Err() != nil {
+		return nil, ErrDenied
+	}
+	hello, files, err := b.ReceiveAuthenticated(channel, pidfd)
+	for _, f := range files {
+		_ = f.Close()
+	}
+	if err != nil || hello.Header.Kind != HelloKind {
+		return nil, ErrDenied
+	}
+	selected := uint64(OwnedTUN)
+	if hello.Hello.AppRequired {
+		selected = AllFeatures
+	}
+	features, err := EncodeFeatures(b.Binding, selected, hello.Hello.AppRequired, hello.Hello.Supported)
+	if err != nil {
+		return nil, err
+	}
+	if err = syscall.Sendmsg(int(channel.Fd()), features, nil, nil, syscall.MSG_DONTWAIT|syscall.MSG_NOSIGNAL); err != nil {
+		return nil, ErrDenied
+	}
+	attach, files, err := b.ReceiveAuthenticated(channel, pidfd)
+	if err != nil || attach.Header.Kind != AttachKind || len(files) != 1 {
+		for _, f := range files {
+			_ = f.Close()
+		}
+		return nil, ErrDenied
+	}
+	f := files[0]
+	s, err := NewSession(b.Binding, hello.Hello.OwnerTTL)
+	if err != nil {
+		_ = f.Close()
+		return nil, err
+	}
+	if validateTUN(f, attach.Attach) != nil {
+		_ = f.Close()
+		_ = s.Revoke()
+		return nil, ErrDenied
+	}
+	c := &routingConsumer{session: s, required: hello.Hello.AppRequired, bootstrap: b, channel: channel, pidfd: pidfd, owned: f, attached: attach.Attach}
+	c.ownedHandle, err = s.Track(time.Now(), false, Flow{}, Evidence{}, f)
+	if err != nil {
+		_ = f.Close()
+		return nil, err
+	}
+	ack, err := EncodeAttachACK(b.Binding)
+	if err != nil {
+		_ = s.Revoke()
+		return nil, err
+	}
+	if err = syscall.Sendmsg(int(channel.Fd()), ack, nil, nil, syscall.MSG_DONTWAIT|syscall.MSG_NOSIGNAL); err != nil {
+		_ = s.Revoke()
+		return nil, ErrDenied
+	}
+	ok = true
+	go c.monitorTUN(ctx)
+	return context.WithValue(ctx, routingKey{}, c), nil
+}
+
+func validateTUN(f *os.File, a AttachBody) error {
+	return controlFile(f, func(fd int) error { return validateTUNFD(fd, a) })
+}
+
+func validateTUNFD(fd int, a AttachBody) error {
+	req, err := unix.NewIfreq("")
+	if err != nil || unix.IoctlIfreq(fd, unix.TUNGETIFF, req) != nil {
+		return ErrDenied
+	}
+	if req.Name() != a.Name || !plainTUNFlags(req.Uint16()) {
+		return ErrDenied
+	}
+	iface, err := net.InterfaceByName(a.Name)
+	if err != nil || iface.Index != int(a.Ifindex) || iface.MTU != int(a.MTU) {
+		return ErrDenied
+	}
+	flags, err := unix.FcntlInt(uintptr(fd), unix.F_GETFD, 0)
+	if err != nil || flags&unix.FD_CLOEXEC == 0 {
+		return ErrDenied
+	}
+	status, err := unix.FcntlInt(uintptr(fd), unix.F_GETFL, 0)
+	if err != nil || status&unix.O_NONBLOCK == 0 {
+		return ErrDenied
+	}
+	return nil
+}
+
+type onceTUN struct {
+	io.Closer
+	once sync.Once
+	err  error
+}
+
+func (t *onceTUN) Close() error { t.once.Do(func() { t.err = t.Closer.Close() }); return t.err }
+
+// OpenTUN внедряет FD только из закрытого контекста. При успехе native constructor
+// владеет raw FD; при ошибке constructor обязан оставить raw FD вызывающему.
+// Возвращённый release используется вместо прямого Close ядра.
+func OpenTUN(ctx context.Context, name string, mtu uint32, factory func(int) (io.Closer, error)) (io.Closer, func() error, error) {
+	c, ok := ctx.Value(routingKey{}).(*routingConsumer)
+	if !ok || c == nil || factory == nil {
+		return nil, nil, ErrDenied
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	success := false
+	defer func() {
+		if !success && c.session != nil {
+			_ = c.session.Revoke()
+		}
+	}()
+	if c.session == nil || c.owned == nil || ctx.Err() != nil || c.bootstrap.CheckServer(c.pidfd) != nil || c.session.Guard(time.Now(), BeforeRouting, false, Flow{}, Evidence{}) != nil || name != c.attached.Name || mtu != c.attached.MTU || validateTUN(c.owned, c.attached) != nil {
+		return nil, nil, ErrDenied
+	}
+	fd := -1
+	err := controlFile(c.owned, func(borrowed int) error {
+		var err error
+		fd, err = unix.FcntlInt(uintptr(borrowed), unix.F_DUPFD_CLOEXEC, 3)
+		return err
+	})
+	if err != nil {
+		return nil, nil, err
+	}
+	_ = c.session.Release(c.ownedHandle)
+	c.owned = nil
+	native, err := factory(fd)
+	if err != nil || native == nil {
+		_ = unix.Close(fd)
+		_ = c.session.Revoke()
+		return nil, nil, ErrDenied
+	}
+	closed := &onceTUN{Closer: native}
+	if ctx.Err() != nil || c.bootstrap.CheckServer(c.pidfd) != nil {
+		_ = closed.Close()
+		return nil, nil, ErrDenied
+	}
+	h, err := c.session.Track(time.Now(), false, Flow{}, Evidence{}, closed)
+	if err != nil {
+		_ = closed.Close()
+		return nil, nil, err
+	}
+	success = true
+	return native, func() error { return c.session.Release(h) }, nil
+}
+
+func (c *routingConsumer) monitorTUN(ctx context.Context) {
+	// Все пользователи channel/pidfd держат mu, включая завершение monitor.
+	defer func() {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		_ = c.session.Revoke()
+		_ = c.channel.Close()
+		_ = c.pidfd.Close()
+	}()
+	ticker := time.NewTicker(5 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-c.session.Context().Done():
+			return
+		case <-ticker.C:
+			c.mu.Lock()
+			if c.bootstrap.CheckServer(c.pidfd) != nil {
+				c.mu.Unlock()
+				return
+			}
+			fd := int(c.channel.Fd())
+			var set syscall.FdSet
+			if fd < 0 || fd >= len(set.Bits)*64 {
+				c.mu.Unlock()
+				return
+			}
+			set.Bits[fd/64] |= 1 << uint(fd%64)
+			timeout := syscall.Timeval{}
+			n, err := syscall.Select(fd+1, &set, nil, nil, &timeout)
+			if err != nil {
+				c.mu.Unlock()
+				return
+			}
+			if n != 0 {
+				_, files, _ := c.bootstrap.ReceiveAuthenticated(c.channel, c.pidfd)
+				for _, f := range files {
+					_ = f.Close()
+				}
+				// Любое unsolicited сообщение (включая REVOKE), EOF или invalid frame отзывает custody.
+				c.mu.Unlock()
+				return
+			}
+			c.mu.Unlock()
+		}
+	}
+}
+
+// CarryClosedSession сохраняет только уже доверенную session при upstream detach.
+// Непроверенные context values и caller assertions authority не создают.
+func CarryClosedSession(source, target context.Context) context.Context {
+	c, ok := source.Value(routingKey{}).(*routingConsumer)
+	if !ok || c == nil {
+		return target
+	}
+	return context.WithValue(target, routingKey{}, c)
+}
+
+// Оба закрытых конструктора читают Plain IP без virtio header.
+// PERSIST описывает хранение интерфейса, не packet framing; остальные биты запрещены.
+func plainTUNFlags(flags uint16) bool {
+	const plain = unix.IFF_TUN | unix.IFF_NO_PI
+	return flags == plain || flags == plain|unix.IFF_PERSIST
+}
diff --git a/common/yonikbroker/closed_tun_linux_test.go b/common/yonikbroker/closed_tun_linux_test.go

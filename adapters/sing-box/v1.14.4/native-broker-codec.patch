diff --git a/common/yonikbroker/socket.go b/common/yonikbroker/socket.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/socket.go
@@ -0,0 +1,76 @@
+package nativehooks
+
+import (
+	"context"
+	"io"
+	"time"
+)
+
+// OwnSocket передаёт session единственное право закрытия опубликованного сокета.
+func OwnSocket(ctx context.Context, socket io.Closer) (func() error, error) {
+	c, ok := ctx.Value(routingKey{}).(*routingConsumer)
+	if !ok || c == nil {
+		_ = socket.Close()
+		return nil, ErrDenied
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.session == nil || c.denied || ctx.Err() != nil {
+		_ = socket.Close()
+		return nil, ErrDenied
+	}
+	if c.session.Guard(time.Now(), BeforeDial, false, Flow{}, Evidence{}) != nil {
+		_ = socket.Close()
+		return nil, ErrDenied
+	}
+	if c.dnsExchange != nil && c.dnsExchange.authorize() != nil {
+		_ = socket.Close()
+		c.denyFlow()
+		return nil, ErrDenied
+	}
+	lookup := c.lookup
+	if lookup == nil {
+		lookup = c.lookupAuthenticated
+	}
+	var proof Evidence
+	var err error
+	if c.required {
+		proof, err = lookup(ctx, c.flow)
+	}
+	if err != nil || ctx.Err() != nil {
+		_ = socket.Close()
+		c.denyFlow()
+		return nil, ErrDenied
+	}
+	stop := context.AfterFunc(ctx, func() { c.mu.Lock(); defer c.mu.Unlock(); c.denyFlow() })
+	owned := &socketCancellation{Closer: socket, stop: stop}
+	if c.required && c.acceptProof(proof) != nil {
+		_ = owned.Close()
+		c.denyFlow()
+		return nil, ErrDenied
+	}
+	handle, err := c.session.Track(time.Now(), c.required, c.flow, proof, owned)
+	if err != nil {
+		_ = owned.Close()
+		c.denyFlow()
+		return nil, err
+	}
+	if c.handles == nil {
+		c.handles = make(map[*Handle]struct{})
+	}
+	c.handles[handle] = struct{}{}
+	return func() error {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		delete(c.handles, handle)
+		return c.session.Release(handle)
+	}, nil
+}
+
+// Отзыв освобождает также регистрацию callback на ещё живом parent context.
+type socketCancellation struct {
+	io.Closer
+	stop func() bool
+}
+
+func (s *socketCancellation) Close() error { s.stop(); return s.Closer.Close() }

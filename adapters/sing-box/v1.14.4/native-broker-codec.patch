--- /dev/null
+++ b/common/yonikbroker/export_test.go
@@ -0,0 +1,164 @@
+package nativehooks
+
+import (
+	"context"
+	"net/netip"
+	"os"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func ClosedRoutingFixture(t *testing.T, status Status) context.Context {
+	s, p, _ := fixture(t)
+	p.Status = status
+	return context.WithValue(context.Background(), routingKey{}, &routingConsumer{session: s, required: true, flow: p.Flow, lookup: func(context.Context, Flow) (Evidence, error) { return p, nil }})
+}
+
+func ClosedTUNFixture(t *testing.T) (context.Context, *os.File, func()) {
+	ctx, original, cancel := closedTUNFixture(t)
+	c := ctx.Value(routingKey{}).(*routingConsumer)
+	return ctx, original, func() {
+		cancel()
+		select {
+		case <-c.session.revokeDone:
+		case <-time.After(time.Second):
+			t.Fatal("native revoke deadline")
+		}
+	}
+}
+
+// ClosedSocketFixture меняет ответ только в закрытом тестовом consumer.
+func ClosedSocketFixture(t *testing.T) (context.Context, func(string), func() int) {
+	s, p, _ := fixture(t)
+	calls := 0
+	c := &routingConsumer{session: s, required: true, flow: p.Flow}
+	c.lookup = func(context.Context, Flow) (Evidence, error) { calls++; return p, nil }
+	ctx := context.WithValue(context.Background(), routingKey{}, c)
+	return ctx, func(mode string) {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		switch mode {
+		case "unknown":
+			p.Status = Unknown
+		case "unavailable":
+			p.Status = Unavailable
+		case "stale":
+			p.Binding.Epoch++
+		case "expired":
+			p.Expires = time.Now().Add(-time.Second)
+		case "revoke":
+			_ = s.Revoke()
+		}
+	}, func() int { c.mu.Lock(); defer c.mu.Unlock(); return calls }
+}
+
+// ClosedRevokeFixture сохраняет authenticated ATTACH и wire Known issuer в test binary.
+func ClosedRevokeFixture(t *testing.T, mode string, protocol uint8) (context.Context, func()) {
+	ctx, _, control := closedTUNFixtureMode(t, "known/"+mode)
+	c := ctx.Value(routingKey{}).(*routingConsumer)
+	_, p, _ := fixture(t)
+	p.Binding = c.bootstrap.Binding
+	p.Flow.Protocol = protocol
+	c.mu.Lock()
+	c.flow = p.Flow
+	c.mu.Unlock()
+	return ctx, func() {
+		control()
+		select {
+		case <-c.session.revokeDone:
+		case <-time.After(time.Second):
+			t.Fatal("revoke deadline")
+		}
+		if err := c.session.Revoke(); err != nil {
+			t.Fatal(err)
+		}
+		c.session.mu.Lock()
+		remaining := len(c.session.flows)
+		c.session.mu.Unlock()
+		if remaining != 0 {
+			t.Fatalf("owned flows после revoke: %d", remaining)
+		}
+		c.mu.Lock()
+		next := c.next
+		c.mu.Unlock()
+		t.Cleanup(func() {
+			c.mu.Lock()
+			defer c.mu.Unlock()
+			if c.next != next {
+				t.Error("lookup после revoke")
+			}
+		})
+	}
+}
+
+// ClosedAdmittedPair разделяет flow consumer, сохраняя один ATTACH, Session и wire sequence.
+func ClosedAdmittedPair(t *testing.T, protocol uint8) (context.Context, context.Context, func(string), func(), func() (uint64, int)) {
+	state := new(atomic.Uint32)
+	base, _, wireRevoke := closedTUNFixtureMode(t, "known/revoke", func(f Flow) Status {
+		if f.Local.Port() == 12001 {
+			switch state.Load() {
+			case 1:
+				return Unknown
+			case 2:
+				return Unavailable
+			}
+		}
+		return Known
+	})
+	broker := base.Value(routingKey{}).(*routingConsumer)
+	makeFlow := func(port uint16) context.Context {
+		c := &routingConsumer{session: broker.session, required: true, flow: Flow{Protocol: protocol, Local: netip.AddrPortFrom(netip.MustParseAddr("127.0.0.1"), port), Remote: netip.MustParseAddrPort("127.0.0.1:443")}}
+		c.lookup = func(ctx context.Context, f Flow) (Evidence, error) {
+			broker.mu.Lock()
+			defer broker.mu.Unlock()
+			proof, err := broker.lookupAuthenticated(ctx, f)
+			if err != nil {
+				t.Logf("authority flow=%d request=%d error=%v session=%v", f.Local.Port(), broker.next, err, broker.session.Context().Err())
+			}
+			return proof, err
+		}
+		return context.WithValue(base, routingKey{}, c)
+	}
+	a, b := makeFlow(12001), makeFlow(12002)
+	if a.Value(routingKey{}).(*routingConsumer).session != b.Value(routingKey{}).(*routingConsumer).session {
+		t.Fatal("разные Session")
+	}
+	revoke := func() {
+		wireRevoke()
+		select {
+		case <-broker.session.revokeDone:
+		case <-time.After(time.Second):
+			t.Fatal("wire revoke deadline")
+		}
+	}
+	return a, b, func(mode string) {
+			switch mode {
+			case "unknown":
+				state.Store(1)
+			case "unavailable":
+				state.Store(2)
+			}
+		}, revoke, func() (uint64, int) {
+			broker.mu.Lock()
+			n := broker.next
+			broker.mu.Unlock()
+			broker.session.mu.Lock()
+			defer broker.session.mu.Unlock()
+			return n, len(broker.session.flows)
+		}
+}
+
+// ClosedAdmittedSibling создаёт новый flow той же Session после завершения прежнего.
+func ClosedAdmittedSibling(ctx context.Context, port uint16) context.Context {
+	old := ctx.Value(routingKey{}).(*routingConsumer)
+	old.mu.Lock()
+	defer old.mu.Unlock()
+	flow := old.flow
+	flow.Local = netip.AddrPortFrom(flow.Local.Addr(), port)
+	return context.WithValue(context.WithoutCancel(ctx), routingKey{}, &routingConsumer{session: old.session, required: true, flow: flow, lookup: old.lookup})
+}
+
+func PersistentPlainTUNFixture(t *testing.T) (context.Context, *os.File, func()) {
+	return closedTUNFixtureMode(t, "persistent/cancel")
+}

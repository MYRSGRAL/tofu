--- /dev/null
+++ b/common/yonikbroker/dns_callsite_test.go
@@ -0,0 +1,268 @@
+package nativehooks_test
+
+import (
+	"context"
+	M "github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	H "github.com/sagernet/sing-box/common/yonikbroker"
+	C "github.com/sagernet/sing-box/constant"
+	D "github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"net"
+	"net/netip"
+	"sync/atomic"
+	"testing"
+)
+
+type guardedDNS struct {
+	adapter.DNSTransport
+	entered chan struct{}
+	release chan struct{}
+	calls   atomic.Int32
+}
+
+func (d *guardedDNS) Tag() string  { return "private" }
+func (d *guardedDNS) Type() string { return "udp" }
+func (d *guardedDNS) Exchange(ctx context.Context, q *M.Msg) (*M.Msg, error) {
+	d.calls.Add(1)
+	if d.entered != nil {
+		d.entered <- struct{}{}
+		<-d.release
+	}
+	ip := netip.MustParseAddr("127.0.0.1")
+	if q.Question[0].Qtype == M.TypeAAAA {
+		ip = netip.IPv6Loopback()
+	}
+	return D.FixedResponse(q.Id, q.Question[0], []netip.Addr{ip}, 300), nil
+}
+func (d *guardedDNS) ExchangeAsync(ctx context.Context, q *M.Msg, cb func(*M.Msg, error)) {
+	go func() { cb(d.Exchange(ctx, q)) }()
+}
+
+func TestActualDNSAwaitAuthority(t *testing.T) {
+	for _, strategy := range []C.DomainStrategy{C.DomainStrategyIPv4Only, C.DomainStrategyIPv6Only} {
+		for _, mode := range []string{"known", "unknown", "unavailable", "stale", "revoke", "cancel"} {
+			t.Run(string(rune('4'+strategy))+mode, func(t *testing.T) {
+				ctx, change, _ := H.ClosedSocketFixture(t)
+				ctx, cancel := context.WithCancel(ctx)
+				defer cancel()
+				r, err := D.NewRouter(context.Background(), log.NewNOPFactory(), option.DNSOptions{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				d := &guardedDNS{entered: make(chan struct{}, 2), release: make(chan struct{})}
+				done := make(chan error, 1)
+				go func() {
+					ips, e := r.Lookup(ctx, "private.example", adapter.DNSQueryOptions{Transport: d, Strategy: strategy})
+					if e == nil && len(ips) == 0 {
+						e = H.ErrDenied
+					}
+					done <- e
+				}()
+				<-d.entered
+				if mode == "cancel" {
+					cancel()
+				} else {
+					change(mode)
+				}
+				close(d.release)
+				err = <-done
+				if (err == nil) != (mode == "known") {
+					t.Fatalf("mode=%s err=%v", mode, err)
+				}
+				if mode != "known" && H.DNSGuard(ctx) == nil {
+					t.Fatal("revoked marker bypass")
+				}
+			})
+		}
+	}
+}
+
+// Один cache хранит только DNS данные; authority каждого waiter проверяется отдельно.
+func TestActualDNSCacheAndConcurrentFlows(t *testing.T) {
+	r, err := D.NewRouter(context.Background(), log.NewNOPFactory(), option.DNSOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if e := r.Start(adapter.StartStateStart, new(adapter.Scope)); e != nil {
+		t.Fatal(e)
+	}
+	d := &guardedDNS{}
+	opts := adapter.DNSQueryOptions{Transport: d, Strategy: C.DomainStrategyIPv4Only}
+	a, _, _ := H.ClosedSocketFixture(t)
+	if ips, e := r.Lookup(a, "cache.example", opts); e != nil || len(ips) != 1 {
+		t.Fatal(ips, e)
+	}
+	count := d.calls.Load()
+	b, change, _ := H.ClosedSocketFixture(t)
+	change("unknown")
+	if ips, e := r.Lookup(b, "cache.example", opts); e == nil || len(ips) != 0 {
+		t.Fatal("cache authority reused", ips, e)
+	}
+	c, _, _ := H.ClosedSocketFixture(t)
+	if ips, e := r.Lookup(c, "cache.example", opts); e != nil || len(ips) != 1 || d.calls.Load() != count {
+		t.Fatal("known cache", ips, e, d.calls.Load())
+	}
+	// Два независимых flow ждут один вопрос одновременно; revoke одного не закрывает второй.
+	d = &guardedDNS{entered: make(chan struct{}, 2), release: make(chan struct{})}
+	opts.Transport = d
+	first, changeFirst, _ := H.ClosedSocketFixture(t)
+	second, _, _ := H.ClosedSocketFixture(t)
+	results := make(chan struct {
+		bad bool
+		err error
+	}, 2)
+	for i, ctx := range []context.Context{first, second} {
+		go func(bad bool, ctx context.Context) {
+			_, e := r.Lookup(ctx, "shared.example", opts)
+			results <- struct {
+				bad bool
+				err error
+			}{bad, e}
+		}(i == 0, ctx)
+	}
+	<-d.entered
+	// Client может объединять запросы: release не зависит от количества transport awaits.
+	changeFirst("stale")
+	close(d.release)
+	for range 2 {
+		got := <-results
+		if (got.err != nil) != got.bad {
+			t.Fatalf("flow=%v err=%v", got.bad, got.err)
+		}
+	}
+	if d.calls.Load() != 1 {
+		t.Fatalf("coalesced transport calls=%d", d.calls.Load())
+	}
+	// Обычный caller с методом FlowContext не получает mandatory marker автоматически.
+	if _, e := r.Lookup(legacyDNSContext{context.Background()}, "cache.example", opts); e != nil {
+		t.Fatal(e)
+	}
+}
+
+// Реальный приватный resolver: только случайный loopback порт, без host DNS.
+type loopbackDNS struct {
+	adapter.DNSTransport
+	address, network string
+}
+
+func (d *loopbackDNS) Tag() string  { return "loopback-private" }
+func (d *loopbackDNS) Type() string { return d.network }
+func (d *loopbackDNS) Exchange(ctx context.Context, q *M.Msg) (*M.Msg, error) {
+	c := M.Client{Net: d.network}
+	r, _, e := c.ExchangeContext(ctx, q, d.address)
+	return r, e
+}
+func TestActualPrivateResolverLoopback(t *testing.T) {
+	for _, network := range []string{"tcp", "udp"} {
+		for _, mode := range []string{"known", "unknown", "unavailable", "stale", "revoke", "cancel"} {
+			t.Run(network+"/"+mode, func(t *testing.T) {
+				entered := make(chan struct{}, 2)
+				release := make(chan struct{})
+				handler := M.HandlerFunc(func(w M.ResponseWriter, q *M.Msg) {
+					entered <- struct{}{}
+					<-release
+					ip := netip.MustParseAddr("127.0.0.1")
+					if q.Question[0].Qtype == M.TypeAAAA {
+						ip = netip.IPv6Loopback()
+					}
+					_ = w.WriteMsg(D.FixedResponse(q.Id, q.Question[0], []netip.Addr{ip}, 300))
+				})
+				server := &M.Server{Handler: handler}
+				var address string
+				if network == "tcp" {
+					l, e := net.Listen("tcp4", "127.0.0.1:0")
+					if e != nil {
+						t.Fatal(e)
+					}
+					server.Listener = l
+					address = l.Addr().String()
+				} else {
+					l, e := net.ListenPacket("udp4", "127.0.0.1:0")
+					if e != nil {
+						t.Fatal(e)
+					}
+					server.PacketConn = l
+					address = l.LocalAddr().String()
+				}
+				ready := make(chan struct{})
+				server.NotifyStartedFunc = func() { close(ready) }
+				done := make(chan error, 1)
+				go func() { done <- server.ActivateAndServe() }()
+				<-ready
+				defer func() {
+					_ = server.Shutdown()
+					if e := <-done; e != nil {
+						t.Error(e)
+					}
+				}()
+				r, e := D.NewRouter(context.Background(), log.NewNOPFactory(), option.DNSOptions{})
+				if e != nil {
+					t.Fatal(e)
+				}
+				ctx, change, _ := H.ClosedSocketFixture(t)
+				ctx, cancel := context.WithCancel(ctx)
+				defer cancel()
+				result := make(chan error, 1)
+				go func() {
+					ips, e := r.Lookup(ctx, "private.example", adapter.DNSQueryOptions{Transport: &loopbackDNS{address: address, network: network}, StrictComplete: true})
+					if e == nil && len(ips) != 2 {
+						e = H.ErrDenied
+					}
+					result <- e
+				}()
+				<-entered
+				if mode == "cancel" {
+					cancel()
+				} else {
+					change(mode)
+				}
+				close(release)
+				if e := <-result; (e == nil) != (mode == "known") {
+					t.Fatalf("mode=%s err=%v", mode, e)
+				}
+			})
+		}
+	}
+}

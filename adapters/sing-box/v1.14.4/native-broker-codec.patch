+)
+
+type residualFenceFactory struct {
+	log.Factory
+	hook func()
+}
+
+func (f *residualFenceFactory) NewLogger(tag string) log.ContextLogger {
+	return &residualFenceLogger{ContextLogger: f.Factory.NewLogger(tag), factory: f}
+}
+
+type residualFenceLogger struct {
+	logger.ContextLogger
+	factory *residualFenceFactory
+}
+
+func (l *residualFenceLogger) InfoContext(ctx context.Context, args ...any) {
+	if strings.HasPrefix(fmt.Sprint(args...), "lookup succeed for ") && l.factory.hook != nil {
+		l.factory.hook()
+	}
+	l.ContextLogger.InfoContext(ctx, args...)
+}
+
+type countedDNSTransport struct {
+	adapter.DNSTransport
+	calls atomic.Int32
+}
+
+func (d *countedDNSTransport) Exchange(ctx context.Context, q *mdns.Msg) (*mdns.Msg, error) {
+	d.calls.Add(1)
+	return d.DNSTransport.Exchange(ctx, q)
+}
+func (d *countedDNSTransport) ExchangeAsync(ctx context.Context, q *mdns.Msg, cb func(*mdns.Msg, error)) {
+	go func() { cb(d.Exchange(ctx, q)) }()
+}
+
+func TestAdmittedCacheFence(t *testing.T) {
+	for _, mode := range []string{"known", "cancel", "unknown", "unavailable", "revoke"} {
+		t.Run(mode, func(t *testing.T) {
+			a, b, change, revoke, _ := H.ClosedAdmittedPair(t, 6)
+			a, cancel := context.WithCancel(a)
+			defer cancel()
+			f := &residualFenceFactory{Factory: log.NewNOPFactory()}
+			r, e := D.NewRouter(context.Background(), f, option.DNSOptions{})
+			if e != nil {
+				t.Fatal(e)
+			}
+			if e = r.Start(adapter.StartStateStart, new(adapter.Scope)); e != nil {
+				t.Fatal(e)
+			}
+			listener, e := net.Listen("tcp", "127.0.0.1:0")
+			if e != nil {
+				t.Fatal(e)
+			}
+			var wire atomic.Int32
+			probeDone := make(chan struct{}, 2)
+			probeGate := make(chan struct{})
+			var probes atomic.Int32
+			server := &mdns.Server{Listener: listener, Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, q *mdns.Msg) {
+				if q.Id != 1 && q.Id != 2 {
+					<-probeGate
+				}
+				wire.Add(1)
+				ip := netip.MustParseAddr("127.0.0.1")
+				if q.Question[0].Qtype == mdns.TypeAAAA {
+					ip = netip.IPv6Loopback()
+				}
+				_ = w.WriteMsg(D.FixedResponse(q.Id, q.Question[0], []netip.Addr{ip}, 60))
+				if q.Id == 1 || q.Id == 2 {
+					probeDone <- struct{}{}
+					if probes.Add(1) == 2 {
+						close(probeGate)
+					}
+				}
+			})}
+			go server.ActivateAndServe()
+			defer server.Shutdown()
+			nd, e := dialer.NewDefault(context.Background(), option.DialerOptions{})
+			if e != nil {
+				t.Fatal(e)
+			}
+			transport := DT.NewTCPRaw(D.NewTransportAdapter(C.DNSTypeTCP, "private", nil), nd, M.SocksaddrFromNet(listener.Addr()))
+			defer transport.CloseIdleConnections()
+			d := &countedDNSTransport{DNSTransport: transport}
+			opts := adapter.DNSQueryOptions{Transport: d, Strategy: C.DomainStrategyIPv4Only}
+			if ips, e := r.Lookup(b, "fence.residual", opts); e != nil || len(ips) != 1 {
+				t.Fatal(ips, e)
+			}
+			for range 2 {
+				select {
+				case <-probeDone:
+				case <-time.After(time.Second):
+					t.Fatal("reuse probes не завершены")
+				}
+			}
+			before := wire.Load()
+			if before != 3 || d.calls.Load() != 1 {
+				t.Fatalf("warm wire=%d exchanges=%d", before, d.calls.Load())
+			}
+			reached := false
+			f.hook = func() {
+				if reached {
+					t.Fatal("повторный cache checkpoint")
+				}
+				reached = true
+				if wire.Load() != before || d.calls.Load() != 1 {
+					t.Fatal("cache miss на checkpoint")
+				}
+				if mode == "cancel" {
+					cancel()
+				} else if mode == "revoke" {
+					revoke()
+				} else {
+					change(mode)
+				}
+			}
+			ips, e := r.Lookup(a, "fence.residual", opts)
+			f.hook = nil
+			if !reached {
+				t.Fatal("не достигнут реальный cache hit")
+			}
+			if (e == nil) != (mode == "known") || mode != "known" && len(ips) != 0 {
+				t.Fatalf("cache fence mode=%s addresses=%v error=%v", mode, ips, e)
+			}
+			ips, e = r.Lookup(b, "fence.residual", opts)
+			if (e == nil) != (mode != "revoke") {
+				t.Fatalf("neighbor addresses=%v error=%v", ips, e)
+			}
+			if wire.Load() != before || d.calls.Load() != 1 {
+				t.Fatalf("cache повторил upstream: wire=%d exchanges=%d", wire.Load(), d.calls.Load())
+			}
+			t.Logf("cache_hit=true upstream_exchanges=1 wire=3 neighbor=%v mode=%s", e, mode)
+		})
+	}
+}
+
+type residualBlockedDNS struct {
+	adapter.DNSTransport
+	entered, cleaned chan struct{}
+	calls            atomic.Int32
+	block            atomic.Bool
+}
+
+func (d *residualBlockedDNS) Tag() string  { return "cleanup" }
+func (d *residualBlockedDNS) Type() string { return "tcp" }
+func (d *residualBlockedDNS) Exchange(ctx context.Context, q *mdns.Msg) (*mdns.Msg, error) {
+	d.calls.Add(1)
+	d.entered <- struct{}{}
+	if d.block.Load() {
+		<-ctx.Done()
+		d.cleaned <- struct{}{}
+		return D.FixedResponse(q.Id, q.Question[0], []netip.Addr{netip.MustParseAddr("127.0.0.1")}, 60), nil
+	}
+	return D.FixedResponse(q.Id, q.Question[0], []netip.Addr{netip.MustParseAddr("127.0.0.1")}, 60), nil
+}
+func TestAdmittedLastWaiterCleanup(t *testing.T) {
+	a, b, _, _, stats := H.ClosedAdmittedPair(t, 6)
+	a, ca := context.WithCancel(a)
+	b, cb := context.WithCancel(b)
+	defer ca()
+	defer cb()
+	r, e := D.NewRouter(context.Background(), log.NewNOPFactory(), option.DNSOptions{})
+	if e != nil {
+		t.Fatal(e)
+	}
+	if e = r.Start(adapter.StartStateStart, new(adapter.Scope)); e != nil {
+		t.Fatal(e)
+	}
+	d := &residualBlockedDNS{entered: make(chan struct{}, 4), cleaned: make(chan struct{}, 4)}
+	d.block.Store(true)
+	opts := adapter.DNSQueryOptions{Transport: d, Strategy: C.DomainStrategyIPv4Only}
+	done := make(chan error, 2)
+	for _, ctx := range []context.Context{a, b} {
+		go func(ctx context.Context) { _, e := r.Lookup(ctx, "cleanup.residual", opts); done <- e }(ctx)
+	}
+	select {
+	case <-d.entered:
+	case <-time.After(time.Second):
+		t.Fatal("worker не запущен")
+	}
+	waitNativeWaiters(t, 2)
+	// Первый waiter выходит; второй ещё держит запрос. Последний отменяет worker.
+	ca()
+	select {
+	case e := <-done:
+		if e == nil {
+			t.Fatal("cancel A разрешён")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("A не завершился")
+	}
+	cb()
+	select {
+	case e := <-done:
+		if e == nil {
+			t.Fatal("cancel B разрешён")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("B не завершился")
+	}
+	select {
+	case <-d.cleaned:
+	case <-time.After(time.Second):
+		t.Fatal("last waiter не отменил worker")
+	}
+	d.block.Store(false)
+	// Новый flow той же admitted Session обязан заново выполнить exchange: late reply не cache.
+	fresh := H.ClosedAdmittedSibling(b, 12003)
+	if _, e := r.Lookup(fresh, "cleanup.residual", opts); e != nil {
+		t.Fatal("новый flow не выполнил повторный exchange", e)
+	}
+	_, handles := stats()
+	if handles != 1 {
+		t.Fatalf("остаточные handles=%d want=1 TUN", handles)
+	}
+	if d.calls.Load() != 2 {
+		t.Fatalf("cleanup/retry calls=%d", d.calls.Load())
+	}
+}
+
+func TestAdmittedSocketRegistration(t *testing.T) {
+	for _, network := range []string{"tcp", "udp", "listen"} {
+		t.Run(network, func(t *testing.T) {
+			a, b, _, revoke, stats := H.ClosedAdmittedPair(t, 6)
+			d, e := dialer.NewDefault(context.Background(), option.DialerOptions{})
+			if e != nil {
+				t.Fatal(e)
+			}
+			listener, e := net.Listen("tcp", "127.0.0.1:0")
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer listener.Close()
+			destination := M.SocksaddrFromNet(listener.Addr())
+			var sockets []interface{ Close() error }
+			var writes []func() error
+			for _, ctx := range []context.Context{a, b} {
+				if network == "listen" {
+					c, e := d.ListenPacket(ctx, destination)
+					if e != nil {
+						t.Fatal(e)
+					}
+					sockets = append(sockets, c)
+					writes = append(writes, func() error {
+						_, e := c.WriteTo([]byte("x"), &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 9})
+						return e
+					})
+				} else {
+					c, e := d.DialContext(ctx, network, destination)
+					if e != nil {
+						t.Fatal(e)
+					}
+					sockets = append(sockets, c)
+					writes = append(writes, func() error { _, e := c.Write([]byte("x")); return e })
+				}
+			}
+			defer func() {
+				for _, c := range sockets {
+					_ = c.Close()
+				}
+			}()
+			_, handles := stats()
+			if handles != 3 {
+				t.Errorf("registration handles=%d want=3", handles)
+			}
+			revoke()
+			for _, write := range writes {
+				if write() == nil {
+					t.Fatal("socket остался открыт после wire REVOKE")
+				}
+			}
+			_, handles = stats()
+			if handles != 0 {
+				t.Fatalf("revoke handles=%d", handles)
+			}
+			if _, e := d.DialContext(b, "udp", destination); e == nil {
+				t.Fatal("после revoke разрешён новый socket")
+			}
+			t.Logf("registered=2 global_closed=2 remaining=%d", handles)
+		})
+	}
+}
+
+func TestAdmittedDetachedProbeCleanup(t *testing.T) {
+	a, _, _, _, stats := H.ClosedAdmittedPair(t, 6)
+	group := H.NewDNSExchange(a)
+	leave, e := group.Join(a)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer group.Close()
+	nd, e := dialer.NewDefault(context.Background(), option.DialerOptions{})
+	if e != nil {
+		t.Fatal(e)
+	}
+	probe := context.WithoutCancel(group.Context())
+	socket, e := nd.DialContext(probe, "udp", M.ParseSocksaddr("127.0.0.1:9"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer socket.Close()
+	_, before := stats()
+	if before != 2 {
+		t.Fatalf("probe handles=%d", before)
+	}
+	leave()
+	if _, e = socket.Write([]byte("probe")); e == nil {
+		t.Fatal("WithoutCancel probe пережил последнего waiter")
+	}
+	_, after := stats()
+	if after != 1 {
+		t.Fatalf("probe cleanup handles=%d", after)
+	}
+	if _, e = nd.DialContext(probe, "udp", M.ParseSocksaddr("127.0.0.1:9")); e == nil {
+		t.Fatal("retired exchange разрешил probe")
+	}
+}

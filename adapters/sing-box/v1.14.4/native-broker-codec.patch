@@ -0,0 +1,105 @@
+package nativehooks_test
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/adapter"
+	nativehooks "github.com/sagernet/sing-box/common/yonikbroker"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-box/route"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+	"net"
+	"net/netip"
+	"strings"
+	"testing"
+)
+
+func TestActualRoutingEntry(t *testing.T) {
+	for _, status := range []nativehooks.Status{nativehooks.Known, nativehooks.Unknown, nativehooks.Unavailable} {
+		ctx := nativehooks.ClosedRoutingFixture(t, status)
+		for _, udp := range []bool{false} {
+			r := new(route.Router)
+			// Маркер deprecated mux достигается только после guard, до обращения к router state.
+			m := adapter.InboundContext{}
+			m.InboundDetour = "loop"
+			m.LastInbound = "loop"
+			var err error
+			if udp {
+				err = r.RoutePacketConnection(ctx, nil, m)
+			} else {
+				err = r.RouteConnection(ctx, nil, m)
+			}
+			if status == nativehooks.Known {
+				if err == nil || !strings.Contains(err.Error(), "routing loop") {
+					t.Fatal(status, udp, err)
+				}
+			} else if err != nativehooks.ErrDenied {
+				t.Fatal(status, udp, err)
+			}
+		}
+	}
+	for _, udp := range []bool{false, true} {
+		r := new(route.Router)
+		var err error
+		if udp {
+			err = r.RoutePacketConnection(context.Background(), nil, adapter.InboundContext{})
+		} else {
+			err = r.RouteConnection(context.Background(), nil, adapter.InboundContext{})
+		}
+		if err != nativehooks.ErrDenied {
+			t.Fatal(err)
+		}
+	}
+}
+
+type testDNS struct{ adapter.DNSRouter }
+
+func (testDNS) LookupReverseMapping(netip.Addr) (string, bool) { return "", false }
+
+type testOutbound struct{ adapter.Outbound }
+
+func (testOutbound) Network() []string { return nil }
+func (testOutbound) Tag() string       { return "closed-default-control" }
+
+type testManager struct {
+	adapter.OutboundManager
+	calls int
+}
+
+func (m *testManager) Default() adapter.Outbound { m.calls++; return testOutbound{} }
+func TestActualDefaultPath(t *testing.T) {
+	for _, status := range []nativehooks.Status{nativehooks.Known, nativehooks.Unknown, nativehooks.Unavailable} {
+		ctx := nativehooks.ClosedRoutingFixture(t, status)
+		m := new(testManager)
+		ctx = service.ContextWith[adapter.OutboundManager](ctx, m)
+		ctx = service.ContextWith[adapter.DNSRouter](ctx, testDNS{})
+		r := route.NewRouter(ctx, log.NewNOPFactory(), option.RouteOptions{}, option.DNSOptions{})
+		left, right := net.Pipe()
+		err := r.RouteConnection(ctx, left, adapter.InboundContext{})
+		left.Close()
+		right.Close()
+		if status == nativehooks.Known {
+			if m.calls != 1 || err == nil || !strings.Contains(err.Error(), "closed-default-control") {
+				t.Fatal(status, m.calls, err)
+			}
+		} else if m.calls != 0 || err != nativehooks.ErrDenied {
+			t.Fatal(status, m.calls, err)
+		}
+	}
+}
+
+// Встраивание интерфейса ловит любой неожиданный I/O вызов через nil.
+type countedPacket struct {
+	N.PacketConn
+	closes int
+}
+
+func (p *countedPacket) Close() error { p.closes++; return nil }
+func TestDeniedPacketOwnership(t *testing.T) {
+	p := new(countedPacket)
+	err := new(route.Router).RoutePacketConnection(context.Background(), p, adapter.InboundContext{})
+	if err != nativehooks.ErrDenied || p.closes != 1 {
+		t.Fatalf("deny=%v closes=%d", err, p.closes)
+	}
+}

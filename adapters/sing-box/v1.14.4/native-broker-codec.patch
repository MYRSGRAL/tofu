index 0000000..86fbcf0
--- /dev/null
+++ b/common/yonikbroker/closed_tun_linux_test.go
@@ -0,0 +1,222 @@
+//go:build linux && !android
+
+package nativehooks
+
+import (
+	"context"
+	"golang.org/x/sys/unix"
+	"io"
+	"net"
+	"os"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// Frozen issuer fixture имеет только собственный bound TUN внутри отдельной netns.
+func closedTUNFixture(t *testing.T) (context.Context, *os.File, func()) {
+	return closedTUNFixtureMode(t, "cancel")
+}
+func closedTUNFixtureMode(t *testing.T, mode string) (context.Context, *os.File, func()) {
+	t.Helper()
+	if os.Getenv("YONIK_ISOLATED_TUN_TEST") != "1" {
+		t.Skip("нужен isolated namespace launcher")
+	}
+	current, err := os.Readlink("/proc/self/ns/net")
+	if err != nil || current == os.Getenv("YONIK_HOST_NETNS") {
+		t.Fatal("тест требует отдельную netns")
+	}
+	fd, err := unix.Open("/dev/net/tun", unix.O_RDWR|unix.O_CLOEXEC|unix.O_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	original := os.NewFile(uintptr(fd), "fixture-original")
+	t.Cleanup(func() { original.Close() })
+	req, _ := unix.NewIfreq("ynkfixture0")
+	req.SetUint16(unix.IFF_TUN | unix.IFF_NO_PI)
+	if err = unix.IoctlIfreq(fd, unix.TUNSETIFF, req); err != nil {
+		t.Fatal(err)
+	}
+	iface, err := net.InterfaceByName(req.Name())
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, pidfd := liveBootstrap(t)
+	record := roleRecord()
+	be.PutUint32(record[120:], b.ServerPID)
+	be.PutUint64(record[128:], b.ServerStarttime)
+	pair, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_SEQPACKET|syscall.SOCK_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	receiver := os.NewFile(uintptr(pair[0]), "fixture-receiver")
+	sender := os.NewFile(uintptr(pair[1]), "fixture-sender")
+	t.Cleanup(func() { sender.Close() })
+	if err = syscall.SetsockoptInt(pair[0], syscall.SOL_SOCKET, syscall.SO_PASSCRED, 1); err != nil {
+		t.Fatal(err)
+	}
+	hello := makeFrame(HelloKind, 0, b.Binding, 176)
+	copy(hello[96:112], b.Session[:])
+	be.PutUint64(hello[112:], b.Generation)
+	copy(hello[120:136], b.Invocation[:])
+	be.PutUint32(hello[136:], MaxFrameBytes)
+	be.PutUint16(hello[140:], 1)
+	be.PutUint64(hello[144:], uint64(OwnerTTL))
+	be.PutUint64(hello[152:], uint64(BootstrapTTL))
+	be.PutUint64(hello[160:], OwnedTUN)
+	attach := makeFrame(AttachKind, 0, b.Binding, 128)
+	be.PutUint32(attach[96:], 1)
+	be.PutUint32(attach[100:], uint32(iface.Index))
+	be.PutUint32(attach[104:], 0x1001)
+	be.PutUint32(attach[108:], uint32(iface.MTU))
+	copy(attach[112:], iface.Name)
+	done := make(chan error, 1)
+	go func() {
+		if e := syscall.Sendmsg(pair[1], hello, nil, nil, 0); e != nil {
+			done <- e
+			return
+		}
+		buffer := make([]byte, 256)
+		_, e := syscall.Read(pair[1], buffer)
+		if e != nil {
+			done <- e
+			return
+		}
+		if e = syscall.Sendmsg(pair[1], attach, syscall.UnixRights(fd), nil, 0); e != nil {
+			done <- e
+			return
+		}
+		_, e = syscall.Read(pair[1], buffer)
+		done <- e
+	}()
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	result, err := closedAttach(ctx, record, receiver, pidfd)
+	if err != nil {
+		sender.Close()
+		t.Fatal(err)
+	}
+	select {
+	case err = <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("issuer deadline")
+	}
+	consumer := result.Value(routingKey{}).(*routingConsumer)
+	t.Cleanup(func() {
+		cancel()
+		select {
+		case <-consumer.session.revokeDone:
+		case <-time.After(time.Second):
+			t.Error("cleanup deadline")
+		}
+	})
+	revoke := cancel
+	if mode == "eof" {
+		revoke = func() { _ = sender.Close() }
+	}
+	if mode == "revoke" {
+		revoke = func() {
+			frame := makeFrame(RevokeKind, 0, b.Binding, 104)
+			be.PutUint32(frame[96:], 1)
+			_ = syscall.Sendmsg(pair[1], frame, nil, nil, 0)
+		}
+	}
+	return result, original, revoke
+}
+
+type fixtureCloser struct{ file *os.File }
+
+func (c *fixtureCloser) Close() error { return c.file.Close() }
+func TestClosedTUNAttachCustody(t *testing.T) {
+	for _, mode := range []string{"cancel", "eof", "revoke"} {
+		t.Run(mode, func(t *testing.T) { testClosedTUNCustody(t, mode) })
+	}
+}
+func testClosedTUNCustody(t *testing.T, mode string) {
+	ctx, original, cancel := closedTUNFixtureMode(t, mode)
+	iface, err := net.InterfaceByName("ynkfixture0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var received *os.File
+	_, release, err := OpenTUN(ctx, iface.Name, uint32(iface.MTU), func(fd int) (io.Closer, error) {
+		received = os.NewFile(uintptr(fd), "native-duplicate")
+		return &fixtureCloser{received}, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	cancel()
+	deadline := time.Now().Add(time.Second)
+	for {
+		if _, err = received.Stat(); err != nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("cancel не закрыл native handle")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if err = release(); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = OpenTUN(ctx, iface.Name, uint32(iface.MTU), func(int) (io.Closer, error) { t.Fatal("повторная инъекция"); return nil, nil }); err == nil {
+		t.Fatal("ATTACH повторно использован")
+	}
+	if _, err = original.Stat(); err != nil {
+		t.Fatal("helper original закрыт", err)
+	}
+}
+func TestOpenTUNWithoutHandoff(t *testing.T) {
+	called := false
+	_, _, err := OpenTUN(context.Background(), "ignored", 1500, func(int) (io.Closer, error) { called = true; return nil, nil })
+	if err == nil || called {
+		t.Fatal("нет closed custody", err, called)
+	}
+}
+
+func TestClosedTUNRejectMetadata(t *testing.T) {
+	ctx, _, _ := closedTUNFixture(t)
+	for _, item := range []struct {
+		name string
+		mtu  uint32
+	}{{"wrong", 1500}, {"ynkfixture0", 68}} {
+		if _, _, err := OpenTUN(ctx, item.name, item.mtu, func(int) (io.Closer, error) { t.Fatal("metadata bypass"); return nil, nil }); err == nil {
+			t.Fatal("metadata accepted")
+		}
+	}
+	f, err := os.Open("/dev/null")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if validateTUN(f, AttachBody{Name: "ynkfixture0", MTU: 1500, Ifindex: 1}) == nil {
+		t.Fatal("не-TUN FD")
+	}
+}
+
+func TestClosedTUNOneUse(t *testing.T) {
+	ctx, _, _ := closedTUNFixture(t)
+	iface, err := net.InterfaceByName("ynkfixture0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var received *os.File
+	factory := func(fd int) (io.Closer, error) {
+		received = os.NewFile(uintptr(fd), "single-use")
+		return &fixtureCloser{received}, nil
+	}
+	if _, _, err = OpenTUN(ctx, iface.Name, uint32(iface.MTU), factory); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = OpenTUN(ctx, iface.Name, uint32(iface.MTU), func(int) (io.Closer, error) { t.Fatal("повторная инъекция"); return nil, nil }); err == nil {
+		t.Fatal("повторный ATTACH")
+	}
+	if _, err = received.Stat(); err == nil {
+		t.Fatal("close-on-error")
+	}
+}

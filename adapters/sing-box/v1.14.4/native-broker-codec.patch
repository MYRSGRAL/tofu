+				ctx, cancel := context.WithCancel(ctx)
+				defer cancel()
+				r, e := D.NewRouter(context.Background(), log.NewNOPFactory(), option.DNSOptions{})
+				if e != nil {
+					t.Fatal(e)
+				}
+				d := &guardedDNS{entered: make(chan struct{}, 1), release: make(chan struct{})}
+				q := new(M.Msg)
+				q.SetQuestion("async.example.", qtype)
+				done := make(chan error, 1)
+				r.ExchangeAsync(ctx, q, adapter.DNSQueryOptions{Transport: d}, func(reply *M.Msg, e error) {
+					if e != nil && reply != nil {
+						t.Error("denied reply published")
+					}
+					done <- e
+				})
+				<-d.entered
+				if mode == "cancel" {
+					cancel()
+				} else {
+					change(mode)
+				}
+				close(d.release)
+				if e := <-done; (e == nil) != (mode == "known") {
+					t.Fatalf("mode=%s err=%v", mode, e)
+				}
+			})
+		}
+	}
+}

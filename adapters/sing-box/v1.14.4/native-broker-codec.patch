+func TestAdmittedNamedResidual(t *testing.T) {
+	for _, network := range []string{"tcp", "udp"} {
+		for _, mode := range []string{"known", "cancel", "unknown", "unavailable", "revoke", "last-cancel", "cache/known", "cache/cancel", "cache/unknown", "cache/unavailable", "cache/revoke"} {
+			t.Run(network+"/"+mode, func(t *testing.T) {
+				cached := strings.HasPrefix(mode, "cache/")
+				mode = strings.TrimPrefix(mode, "cache/")
+				protocol := uint8(6)
+				if network == "udp" {
+					protocol = 17
+				}
+				a, b, change, revoke, stats := H.ClosedAdmittedPair(t, protocol)
+				a, cancel := context.WithCancel(a)
+				defer cancel()
+				b, cancelB := context.WithCancel(b)
+				defer cancelB()
+				tcp, e := net.Listen("tcp", "127.0.0.1:0")
+				if e != nil {
+					t.Fatal(e)
+				}
+				defer tcp.Close()
+				port := tcp.Addr().(*net.TCPAddr).Port
+				udp, e := net.ListenPacket("udp", fmt.Sprintf("127.0.0.1:%d", port))
+				if e != nil {
+					t.Fatal(e)
+				}
+				defer udp.Close()
+				var egress atomic.Int32
+				go func() {
+					for {
+						c, e := tcp.Accept()
+						if e != nil {
+							return
+						}
+						egress.Add(1)
+						go func() { defer c.Close(); _, _ = io.Copy(c, c) }()
+					}
+				}()
+				go func() {
+					buf := make([]byte, 32)
+					for {
+						n, c, e := udp.ReadFrom(buf)
+						if e != nil {
+							return
+						}
+						egress.Add(1)
+						_, _ = udp.WriteTo(buf[:n], c)
+					}
+				}()
+				listener, e := net.Listen("tcp", "127.0.0.1:0")
+				if e != nil {
+					t.Fatal(e)
+				}
+				var questions, probes atomic.Int32
+				probeGate := make(chan struct{})
+				entered, release := make(chan struct{}, 8), make(chan struct{})
+				var once sync.Once
+				unblock := func() { once.Do(func() { close(release) }) }
+				defer unblock()
+				server := &mdns.Server{Listener: listener, Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, q *mdns.Msg) {
+					t.Logf("stage=dns-question question=%v id=%d", q.Question, q.Id)
+					if q.Id == 1 || q.Id == 2 {
+						if probes.Add(1) == 2 {
+							close(probeGate)
+						}
+					} else {
+						<-probeGate
+						questions.Add(1)
+						entered <- struct{}{}
+						<-release
+					}
+					r := new(mdns.Msg)
+					r.SetReply(q)
+					rr, _ := mdns.NewRR("residual.test. 60 IN A 127.0.0.1")
+					r.Answer = []mdns.RR{rr}
+					err := w.WriteMsg(r)
+					t.Logf("stage=dns-reply error=%v questions=%d", err, questions.Load())
+				})}
+				go server.ActivateAndServe()
+				defer func() { unblock(); _ = server.Shutdown() }()
+				ctx := include.Context(context.Background())
+				var config option.Options
+				e = json.UnmarshalContext(ctx, []byte(fmt.Sprintf(`{"dns":{"servers":[{"type":"tcp","tag":"private","server":"127.0.0.1","server_port":%d}]},"outbounds":[{"type":"direct","tag":"allowed"}],"route":{"rules":[{"action":"resolve","server":"private","strategy":"ipv4_only"},{"ip_cidr":["127.0.0.1/32"],"action":"route","outbound":"allowed"},{"action":"reject"}],"default_domain_resolver":"private"}}`, listener.Addr().(*net.TCPAddr).Port)), &config)
+				if e != nil {
+					t.Fatal(e)
+				}
+				instance, e := box.New(box.Options{Options: config, Context: ctx})
+				if e != nil {
+					t.Fatal(e)
+				}
+				defer instance.Close()
+				if e = instance.Start(); e != nil {
+					t.Fatal(e)
+				}
+				run := func(ctx context.Context, id string) <-chan error {
+					done := make(chan error, 1)
+					go func() {
+						metadata := adapter.InboundContext{Destination: M.ParseSocksaddr(fmt.Sprintf("residual.test:%d", port))}
+						closed := make(chan error, 1)
+						onClose := func(err error) {
+							select {
+							case closed <- err:
+							default:
+							}
+							t.Logf("stage=route-close flow=%s error=%v ctx=%v", id, err, ctx.Err())
+						}
+						if network == "tcp" {
+							left, right := net.Pipe()
+							defer left.Close()
+							defer right.Close()
+							instance.Router().RouteConnectionEx(ctx, right, metadata, onClose)
+							_ = left.SetDeadline(time.Now().Add(time.Second))
+							_, err := left.Write([]byte(id))
+							if err == nil {
+								v := make([]byte, len(id))
+								_, err = io.ReadFull(left, v)
+								if err == nil && string(v) != id {
+									err = fmt.Errorf("echo=%q", v)
+								}
+							}
+							done <- err
+						} else {
+							p, err := net.ListenPacket("udp", "127.0.0.1:0")
+							if err != nil {
+								done <- err
+								return
+							}
+							defer p.Close()
+							c, err := net.Dial("udp", p.LocalAddr().String())
+							if err != nil {
+								done <- err
+								return
+							}
+							defer c.Close()
+							go instance.Router().RoutePacketConnectionEx(ctx, &namedPacketConn{PacketConn: p, destination: metadata.Destination, client: c.LocalAddr()}, metadata, onClose)
+							_ = c.SetDeadline(time.Now().Add(time.Second))
+							_, err = c.Write([]byte(id))
+							if err == nil {
+								v := make([]byte, len(id))
+								_, err = c.Read(v)
+								if err == nil && string(v) != id {
+									err = fmt.Errorf("echo=%q", v)
+								}
+							}
+							done <- err
+						}
+					}()
+					return done
+				}
+
+				transition := func() {
+					if mode == "last-cancel" {
+						cancel()
+						cancelB()
+					} else if mode == "cancel" {
+						cancel()
+					} else if mode == "revoke" {
+						revoke()
+					} else {
+						change(mode)
+					}
+				}
+				var da, db <-chan error
+				if cached {
+					unblock()
+					warm := run(b, "warm")
+					select {
+					case e := <-warm:
+						if e != nil {
+							t.Fatal("cache warm", e)
+						}
+					case <-time.After(2 * time.Second):
+						t.Fatal("cache warm timeout")
+					}
+					if egress.Load() != 1 {
+						t.Fatal("cache warm egress")
+					}
+					egress.Store(0)
+					transition()
+					da = run(a, "A")
+					db = run(b, "B")
+				} else {
+					da = run(a, "A")
+					select {
+					case <-entered:
+					case <-time.After(time.Second):
+						t.Fatal("stage=DNS-enter A")
+					}
+					db = run(b, "B")
+					waitNativeWaiters(t, 2)
+					transition()
+					unblock()
+				}
+
+				await := func(done <-chan error, id string) error {
+					select {
+					case e := <-done:
+						t.Logf("stage=echo flow=%s error=%v", id, e)
+						return e
+					case <-time.After(2 * time.Second):
+						t.Fatalf("stage=echo-timeout flow=%s", id)
+						return nil
+					}
+				}
+				ea, eb := await(da, "A"), await(db, "B")
+				n, handles := stats()
+				t.Logf("authority_requests=%d handles=%d upstream=%d probes=%d egress=%d A=%v B=%v", n, handles, questions.Load(), probes.Load(), egress.Load(), ea, eb)
+				if mode == "known" {
+					if ea != nil || eb != nil || egress.Load() != 2 {
+						t.Fatal("Known не достиг egress")
+					}
+				} else if mode == "revoke" || mode == "last-cancel" {
+					if ea == nil || eb == nil || egress.Load() != 0 {
+						t.Fatal("global revoke пропустил flow")
+					}
+				} else {
+					if ea == nil || eb != nil || egress.Load() != 1 {
+						t.Fatal("flow isolation")
+					}
+				}
+				if mode == "last-cancel" {
+					deadline := time.Now().Add(time.Second)
+					for {
+						_, remaining := stats()
+						if remaining == 1 {
+							break
+						}
+						if time.Now().After(deadline) {
+							t.Fatalf("last waiter handles=%d want=1 TUN", remaining)
+						}
+						runtime.Gosched()
+					}
+				}
+				if questions.Load() != 1 {
+					t.Fatalf("coalescing upstream=%d want=1", questions.Load())
+				}
+			})
+		}
+	}
+}
+
+// Барьер ждёт parked callers после регистрации, а не только входа в Lookup.
+func waitNativeWaiters(t *testing.T, want int) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for {
+		st := make([]byte, 1<<20)
+		n := runtime.Stack(st, true)
+		waiting := 0
+		for _, stack := range strings.Split(string(st[:n]), "\n\n") {
+			if strings.Contains(stack, "[select]") && strings.Contains(stack, "(*Client).nativeExchange(") {
+				waiting++
+			}
+		}
+		if waiting >= want {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("stage=shared-waiters got=%d want=%d", waiting, want)
+		}
+		runtime.Gosched()
+	}
+}

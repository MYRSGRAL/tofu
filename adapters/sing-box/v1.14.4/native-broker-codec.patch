+package nativehooks_test
+
+import (
+	"context"
+	nativehooks "github.com/sagernet/sing-box/common/yonikbroker"
+	"github.com/sagernet/sing-box/protocol/tun"
+	T "github.com/sagernet/sing-tun"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestActualTUNConstructor(t *testing.T)                { actualTUNConstructor(t, false) }
+func TestPersistentPlainActualTUNConstructor(t *testing.T) { actualTUNConstructor(t, true) }
+func actualTUNConstructor(t *testing.T, persistent bool) {
+	if _, err := tun.NewOwnedInterface(context.Background(), T.Options{EXP_ExternalConfiguration: true, Name: "ignored", MTU: 1500}); err == nil {
+		t.Fatal("нет handoff")
+	}
+	fixture := nativehooks.ClosedTUNFixture
+	if persistent {
+		fixture = nativehooks.PersistentPlainTUNFixture
+	}
+	ctx, original, cancel := fixture(t)
+	ctx = nativehooks.CarryClosedSession(ctx, context.Background())
+	iface, err := net.InterfaceByName("ynkfixture0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	native, err := tun.NewOwnedInterface(ctx, T.Options{EXP_ExternalConfiguration: true, Name: iface.Name, MTU: uint32(iface.MTU)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = native.Start(); err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	done := make(chan error, 1)
+	go func() { _, err := native.Read(make([]byte, 2048)); done <- err }()
+	select {
+	case err = <-done:
+		if err == nil {
+			t.Fatal("закрытый TUN читает")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("revoke не закрыл TUN")
+	}
+	if err = native.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = original.Stat(); err != nil {
+		t.Fatal("original", err)
+	}
+}

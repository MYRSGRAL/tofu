+func TestActualSocketRevokeCloses(t *testing.T) {
+	for _, network := range []string{"tcp", "udp", "listen"} {
+		t.Run(network, func(t *testing.T) {
+			ctx, change, _ := H.ClosedSocketFixture(t)
+			d, err := D.NewDefault(ctx, option.DialerOptions{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			target, err := net.Listen("tcp4", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer target.Close()
+			if network == "listen" {
+				c, err := d.ListenPacket(ctx, M.ParseSocksaddr("127.0.0.1:12345"))
+				if err != nil {
+					t.Fatal(err)
+				}
+				change("revoke")
+				defer c.Close()
+				if _, err = c.WriteTo([]byte("x"), &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 9}); err == nil {
+					t.Fatal("revoked packet socket open")
+				}
+			} else {
+				c, err := d.DialContext(ctx, network, M.ParseSocksaddr(target.Addr().String()))
+				if err != nil {
+					t.Fatal(err)
+				}
+				change("revoke")
+				defer c.Close()
+				if _, err = c.Write([]byte("x")); err == nil {
+					t.Fatal("revoked socket open")
+				}
+			}
+		})
+	}
+}

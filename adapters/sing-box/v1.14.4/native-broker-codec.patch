+++ b/common/yonikbroker/dns_exchange.go
@@ -0,0 +1,88 @@
+package nativehooks
+
+import (
+	"context"
+	"sync"
+)
+
+// DNSIdentity ограничивает объединение запросов одной admitted Session.
+func DNSIdentity(ctx context.Context) *Session {
+	c, _ := ctx.Value(routingKey{}).(*routingConsumer)
+	if c == nil {
+		return nil
+	}
+	return c.session
+}
+
+// DNSExchange хранит только текущих waiter. Его сокеты не принадлежат первому flow.
+type DNSExchange struct {
+	worker  *routingConsumer
+	mu      sync.Mutex
+	session *Session
+	next    uint64
+	waiters map[uint64]context.Context
+	ctx     context.Context
+	cancel  context.CancelFunc
+	stop    func() bool
+}
+
+func NewDNSExchange(ctx context.Context) *DNSExchange {
+	session := DNSIdentity(ctx)
+	if session == nil {
+		return nil
+	}
+	g := &DNSExchange{session: session, waiters: make(map[uint64]context.Context)}
+	worker := &routingConsumer{session: session, dnsExchange: g}
+	g.worker = worker
+	g.ctx, g.cancel = context.WithCancel(context.WithValue(context.WithoutCancel(ctx), routingKey{}, worker))
+	g.stop = context.AfterFunc(session.Context(), g.cancel)
+	return g
+}
+func (g *DNSExchange) Context() context.Context { return g.ctx }
+func (g *DNSExchange) Join(ctx context.Context) (func(), error) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if DNSIdentity(ctx) != g.session || ctx.Err() != nil || g.ctx.Err() != nil || len(g.waiters) >= MaxTrackedFlows {
+		return nil, ErrDenied
+	}
+	g.next++
+	id := g.next
+	g.waiters[id] = ctx
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			g.mu.Lock()
+			delete(g.waiters, id)
+			last := len(g.waiters) == 0
+			g.mu.Unlock()
+			if last {
+				g.Close()
+			}
+		})
+	}, nil
+}
+func (g *DNSExchange) Close() {
+	g.stop()
+	g.cancel()
+	// Native reuse-probe может применять WithoutCancel. Владение сокетами всё равно заканчивается здесь.
+	g.worker.mu.Lock()
+	defer g.worker.mu.Unlock()
+	g.worker.denyFlow()
+}
+func (g *DNSExchange) authorize() error {
+	if g.ctx.Err() != nil {
+		return ErrDenied
+	}
+	g.mu.Lock()
+	callers := make([]context.Context, 0, len(g.waiters))
+	for _, ctx := range g.waiters {
+		callers = append(callers, ctx)
+	}
+	g.mu.Unlock()
+	for _, ctx := range callers {
+		if DNSGuard(ctx) == nil {
+			return nil
+		}
+	}
+	return ErrDenied
+}

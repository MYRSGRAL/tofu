+package dialer
+
+import (
+	"context"
+	H "github.com/sagernet/sing-box/common/yonikbroker"
+	"net"
+	"syscall"
+)
+
+// Проверка выполняется заново после каждого bind/control перед bind сокета.
+func listenGuardedPacket(ctx context.Context, config net.ListenConfig, network, address string) (net.PacketConn, error) {
+	if err := H.BeforeSocketDial(ctx); err != nil {
+		return nil, err
+	}
+	original := config.Control
+	config.Control = func(network, address string, raw syscall.RawConn) error {
+		if original != nil {
+			if err := original(network, address, raw); err != nil {
+				return err
+			}
+		}
+		return H.BeforeSocketDial(ctx)
+	}
+	return config.ListenPacket(ctx, network, address)
+}
+
+type ownedSocketConn struct {
+	net.Conn
+	release func() error
+}
+
+func (c *ownedSocketConn) Close() error { return c.release() }
+func (c *ownedSocketConn) Read(b []byte) (int, error) {
+	n, err := c.Conn.Read(b)
+	if err != nil {
+		_ = c.Close()
+	}
+	return n, err
+}
+func (c *ownedSocketConn) Write(b []byte) (int, error) {
+	n, err := c.Conn.Write(b)
+	if err != nil {
+		_ = c.Close()
+	}
+	return n, err
+}
+
+type ownedSocketPacket struct {
+	net.PacketConn
+	release func() error
+}
+
+func (c *ownedSocketPacket) Close() error { return c.release() }
+func (c *ownedSocketPacket) ReadFrom(b []byte) (int, net.Addr, error) {
+	n, a, err := c.PacketConn.ReadFrom(b)
+	if err != nil {
+		_ = c.Close()
+	}
+	return n, a, err
+}
+func (c *ownedSocketPacket) WriteTo(b []byte, a net.Addr) (int, error) {
+	n, err := c.PacketConn.WriteTo(b, a)
+	if err != nil {
+		_ = c.Close()
+	}
+	return n, err
+}

+
+func TestActualSocketGuard(t *testing.T) {
+	for _, network := range []string{"tcp", "udp", "listen"} {
+		for _, status := range []H.Status{H.Known, H.Unknown, H.Unavailable} {
+			t.Run(network+string(rune('0'+status)), func(t *testing.T) {
+				ctx := H.ClosedRoutingFixture(t, status)
+				d, err := D.NewDefault(ctx, option.DialerOptions{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				target, err := net.Listen("tcp4", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer target.Close()
+				ctx, cancel := context.WithTimeout(ctx, time.Second)
+				defer cancel()
+				var conn interface{ Close() error }
+				if network == "listen" {
+					conn, err = d.ListenPacket(ctx, M.ParseSocksaddr("127.0.0.1:12345"))
+				} else {
+					conn, err = d.DialContext(ctx, network, M.ParseSocksaddr(target.Addr().String()))
+				}
+				if err == nil {
+					defer conn.Close()
+				}
+				if (err == nil) != (status == H.Known) {
+					t.Fatalf("status %v: %v", status, err)
+				}
+			})
+		}
+		t.Run(network+"-no-handoff", func(t *testing.T) {
+			ctx := context.Background()
+			d, err := D.NewDefault(ctx, option.DialerOptions{})
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			if network == "listen" {
+				c, e := d.ListenPacket(ctx, M.ParseSocksaddr("127.0.0.1:12345"))
+				if e == nil {
+					c.Close()
+					t.Fatal("listen without handoff")
+				}
+			} else {
+				c, e := d.DialContext(ctx, network, M.ParseSocksaddr("127.0.0.1:9"))
+				if e == nil {
+					c.Close()
+					t.Fatal("dial without handoff")
+				}
+				if !errors.Is(e, H.ErrDenied) {
+					t.Fatalf("guard not reached: %v", e)
+				}
+			}
+		})
+	}
+}
+
+func TestActualSocketFreshProof(t *testing.T) {
+	for _, network := range []string{"tcp", "udp", "listen"} {
+		for _, mode := range []string{"known", "unknown", "unavailable", "stale", "expired", "revoke", "cancel"} {
+			t.Run(network+"/"+mode, func(t *testing.T) {
+				ctx, change, calls := H.ClosedSocketFixture(t)
+				if err := H.RoutingEntry(ctx); err != nil {
+					t.Fatal(err)
+				}
+				change(mode)
+				ctx, cancel := context.WithCancel(ctx)
+				defer cancel()
+				if mode == "cancel" {
+					cancel()
+				}
+				d, err := D.NewDefault(ctx, option.DialerOptions{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				target, err := net.Listen("tcp4", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer target.Close()
+				var conn interface{ Close() error }
+				if network == "listen" {
+					conn, err = d.ListenPacket(ctx, M.ParseSocksaddr("127.0.0.1:12345"))
+				} else {
+					conn, err = d.DialContext(ctx, network, M.ParseSocksaddr(target.Addr().String()))
+				}
+				if err == nil {
+					defer conn.Close()
+				}
+				if (err == nil) != (mode == "known") {
+					t.Fatalf("%s: %v", mode, err)
+				}
+				if mode == "known" && calls() < 2 {
+					t.Fatalf("cached routing proof: %d", calls())
+				}
+			})
+		}
+	}
+}
+
+func TestActualDelayedTFODenial(t *testing.T) {
+	for _, mode := range []string{"unknown", "unavailable", "stale", "cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, change, _ := H.ClosedSocketFixture(t)
+			ctx, cancel := context.WithCancel(ctx)
+			defer cancel()
+			opts := option.DialerOptions{}
+			opts.TCPFastOpen = true
+			d, err := D.NewDefault(ctx, opts)
+			if err != nil {
+				t.Fatal(err)
+			}
+			c, err := d.DialContext(ctx, "tcp", M.ParseSocksaddr("127.0.0.1:9"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			change(mode)
+			if mode == "cancel" {
+				cancel()
+			}
+			n, err := c.Write([]byte("запрещено"))
+			if n != 0 || !errors.Is(err, H.ErrDenied) {
+				t.Fatalf("n=%d err=%v", n, err)
+			}
+		})
+	}
+}
+
+func TestActualSocketRevokeCloses(t *testing.T) {
+	for _, network := range []string{"tcp", "udp", "listen"} {
+		t.Run(network, func(t *testing.T) {
+			ctx, change, _ := H.ClosedSocketFixture(t)
+			d, err := D.NewDefault(ctx, option.DialerOptions{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			target, err := net.Listen("tcp4", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer target.Close()
+			if network == "listen" {
+				c, err := d.ListenPacket(ctx, M.ParseSocksaddr("127.0.0.1:12345"))
+				if err != nil {
+					t.Fatal(err)
+				}
+				change("revoke")
+				defer c.Close()
+				if _, err = c.WriteTo([]byte("x"), &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 9}); err == nil {
+					t.Fatal("revoked packet socket open")
+				}
+			} else {
+				c, err := d.DialContext(ctx, network, M.ParseSocksaddr(target.Addr().String()))
+				if err != nil {
+					t.Fatal(err)
+				}
+				change("revoke")
+				defer c.Close()
+				if _, err = c.Write([]byte("x")); err == nil {
+					t.Fatal("revoked socket open")
+				}
+			}
+		})
+	}
+}
+
+// ProtectPath расположен в настоящем control path системного dial/listen.
+// Счётчик считает handoff native FD, а не прямые вызовы broker guard.
+func TestActualSocketHandoffCounter(t *testing.T) {
+	for _, network := range []string{"tcp", "udp", "listen"} {
+		for _, mode := range []string{"known", "no-handoff", "unknown", "unavailable", "stale", "expired", "cancel", "revoke"} {
+			t.Run(network+"/"+mode, func(t *testing.T) {
+				var id [16]byte
+				if _, err := rand.Read(id[:]); err != nil {
+					t.Fatal(err)
+				}
+				path := "@yonik-counter-" + hex.EncodeToString(id[:])
+				l, err := net.ListenUnix("unix", &net.UnixAddr{Name: path, Net: "unix"})
+				if err != nil {
+					t.Fatal(err)
+				}
+				var calls atomic.Int32
+				done := make(chan struct{})
+				go func() {
+					defer close(done)
+					for {
+						c, e := l.AcceptUnix()
+						if e != nil {
+							return
+						}
+						b := make([]byte, 1)
+						oob := make([]byte, 128)
+						_, n, _, _, e := c.ReadMsgUnix(b, oob)
+						if e == nil {
+							msgs, _ := syscall.ParseSocketControlMessage(oob[:n])
+							for _, msg := range msgs {
+								fds, _ := syscall.ParseUnixRights(&msg)
+								for _, fd := range fds {
+									_ = syscall.Close(fd)
+								}
+							}
+							calls.Add(1)
+							_, _ = c.Write([]byte{1})
+						}
+						_ = c.Close()
+					}
+				}()
+				defer func() { _ = l.Close(); <-done }()
+				ctx, change, _ := H.ClosedSocketFixture(t)
+				if err := H.RoutingEntry(ctx); err != nil {
+					t.Fatal(err)
+				}
+				change(mode)
+				if mode == "no-handoff" {
+					ctx = context.Background()
+				}
+				ctx, cancel := context.WithCancel(ctx)
+				defer cancel()
+				if mode == "cancel" {
+					cancel()
+				}
+				opts := option.DialerOptions{}
+				opts.ProtectPath = path
+				d, err := D.NewDefault(ctx, opts)
+				if err != nil {
+					t.Fatal(err)
+				}
+				target, err := net.Listen("tcp4", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer target.Close()
+				var c interface{ Close() error }
+				if network == "listen" {
+					c, err = d.ListenPacket(ctx, M.ParseSocksaddr("127.0.0.1:12345"))
+				} else {
+					c, err = d.DialContext(ctx, network, M.ParseSocksaddr(target.Addr().String()))
+				}
+				if err == nil {
+					defer c.Close()
+				}
+				want := int32(0)
+				if mode == "known" {
+					want = 1
+				}
+				if calls.Load() != want || (err == nil) != (mode == "known") {
+					t.Fatalf("native handoffs=%d want=%d err=%v", calls.Load(), want, err)
+				}
+			})
+		}
+	}
+}
+
+// Proof меняется внутри реального Control, после initial guard в Write.
+func TestActualLateTFODenial(t *testing.T) {
+	for _, mode := range []string{"unknown", "known"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, change, _ := H.ClosedSocketFixture(t)
+			listener, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer listener.Close()
+			controls := 0
+			dialer := &tfo.Dialer{Dialer: net.Dialer{Timeout: time.Second, Control: func(string, string, syscall.RawConn) error { controls++; change(mode); return nil }}}
+			c, err := D.DialSlowContext(dialer, ctx, "", "tcp4", M.ParseSocksaddr(listener.Addr().String()))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			payload := []byte("closed-flow")
+			n, err := c.Write(payload)
+			if controls == 0 {
+				t.Fatal("Control не вызван")
+			}
+			if mode == "unknown" {
+				if n != 0 || !errors.Is(err, H.ErrDenied) {
+					t.Fatalf("n=%d err=%v", n, err)
+				}
+				_ = listener.SetDeadline(time.Now().Add(30 * time.Millisecond))
+				accepted, acceptErr := listener.Accept()
+				if acceptErr == nil {
+					accepted.Close()
+					t.Fatal("запрещённый connect принят")
+				}
+			} else {
+				if n != len(payload) || err != nil {
+					t.Fatalf("n=%d err=%v", n, err)
+				}
+				_ = listener.SetDeadline(time.Now().Add(time.Second))
+				accepted, err := listener.Accept()
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer accepted.Close()
+				_ = accepted.SetReadDeadline(time.Now().Add(time.Second))
+				got := make([]byte, len(payload))
+				if _, err := io.ReadFull(accepted, got); err != nil || string(got) != string(payload) {
+					t.Fatalf("payload=%q err=%v", got, err)
+				}
+			}
+		})
+	}
+}
diff --git a/common/yonikbroker/dns_callsite_test.go b/common/yonikbroker/dns_callsite_test.go

@@ -0,0 +1,115 @@
+package nativehooks_test
+
+import (
+	"context"
+	D "github.com/sagernet/sing-box/common/dialer"
+	H "github.com/sagernet/sing-box/common/yonikbroker"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestActualOpenedFlowsRevoke(t *testing.T) {
+	for _, mode := range []string{"cancel", "eof", "revoke", "deadline"} {
+		for _, network := range []string{"tcp", "udp"} {
+			t.Run(mode+"/"+network, func(t *testing.T) {
+				protocol := uint8(6)
+				if network == "udp" {
+					protocol = 17
+				}
+				ctx, revoke := H.ClosedRevokeFixture(t, mode, protocol)
+				var address string
+				var port int
+				var wg sync.WaitGroup
+				if network == "tcp" {
+					l, err := net.Listen("tcp", "127.0.0.1:0")
+					if err != nil {
+						t.Fatal(err)
+					}
+					defer l.Close()
+					address = l.Addr().String()
+					port = l.Addr().(*net.TCPAddr).Port
+					wg.Add(4)
+					go func() {
+						for {
+							c, e := l.Accept()
+							if e != nil {
+								return
+							}
+							go func() { defer wg.Done(); defer c.Close(); _, _ = io.Copy(c, c) }()
+						}
+					}()
+				} else {
+					l, err := net.ListenPacket("udp", "127.0.0.1:0")
+					if err != nil {
+						t.Fatal(err)
+					}
+					defer l.Close()
+					address = l.LocalAddr().String()
+					port = l.LocalAddr().(*net.UDPAddr).Port
+					go func() {
+						b := make([]byte, 1024)
+						for {
+							n, a, e := l.ReadFrom(b)
+							if e != nil {
+								return
+							}
+							_, _ = l.WriteTo(b[:n], a)
+						}
+					}()
+				}
+				_ = address
+				_ = port
+				dial := func() (net.Conn, error) {
+					d, err := D.NewDefault(context.Background(), option.DialerOptions{})
+					if err != nil {
+						return nil, err
+					}
+					return d.DialContext(ctx, network, M.ParseSocksaddr(address))
+				}
+				connections := make([]net.Conn, 4)
+				for i := range connections {
+					c, e := dial()
+					if e != nil {
+						t.Fatal(e)
+					}
+					connections[i] = c
+					defer c.Close()
+					_ = c.SetDeadline(time.Now().Add(time.Second))
+					if _, e = c.Write([]byte{42}); e != nil {
+						t.Fatal(e)
+					}
+					b := make([]byte, 1)
+					if _, e = io.ReadFull(c, b); e != nil || b[0] != 42 {
+						t.Fatalf("positive traffic: %v", e)
+					}
+				}
+				revoke()
+				for _, c := range connections {
+					_ = c.SetDeadline(time.Now().Add(time.Second))
+					if _, e := c.Write([]byte{43}); e == nil {
+						t.Fatal("revoked socket writes")
+					}
+					if _, e := c.Read(make([]byte, 1)); e == nil {
+						t.Fatal("revoked socket reads")
+					}
+					if e := c.Close(); e != nil {
+						t.Fatal(e)
+					}
+				}
+				if c, e := dial(); e == nil {
+					c.Close()
+					t.Fatal("dial after revoke")
+				}
+				if H.RoutingEntry(ctx) == nil || H.DNSGuard(ctx) == nil || H.BeforeSocketDial(ctx) == nil {
+					t.Fatal("guard after revoke")
+				}
+				wg.Wait()
+			})
+		}
+	}
+}

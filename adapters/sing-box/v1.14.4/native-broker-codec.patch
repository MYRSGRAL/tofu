+package nativehooks
+
+import (
+	"context"
+	"testing"
+)
+
+func TestRoutingEntryClosedFixture(t *testing.T) {
+	if RoutingEntry(context.Background()) == nil {
+		t.Fatal("нет сессии")
+	}
+	for _, status := range []Status{Known, Unknown, Unavailable} {
+		s, p, _ := fixture(t)
+		p.Status = status
+		c := &routingConsumer{session: s, required: true, flow: p.Flow, lookup: func(context.Context, Flow) (Evidence, error) { return p, nil }}
+		ctx := context.WithValue(context.Background(), routingKey{}, c)
+		if err := RoutingEntry(ctx); (err == nil) != (status == Known) {
+			t.Fatal(status, err)
+		}
+		_ = s.Revoke()
+		if RoutingEntry(ctx) == nil {
+			t.Fatal("отзыв")
+		}
+	}
+}
+
+func TestRoutingEntryRequiresClosedConsumer(t *testing.T) {
+	s, p, _ := fixture(t)
+	for _, c := range []*routingConsumer{nil, {}, {session: s, required: true, flow: p.Flow}} {
+		ctx := context.WithValue(context.Background(), routingKey{}, c)
+		if RoutingEntry(ctx) == nil {
+			t.Fatal("нет trusted lookup")
+		}
+	}
+	s, _, _ = fixture(t)
+	ctx := context.WithValue(context.Background(), routingKey{}, &routingConsumer{session: s})
+	if err := RoutingEntry(ctx); err != nil {
+		t.Fatal("non-app control", err)
+	}
+	cancelctx, cancel := context.WithCancel(ctx)
+	cancel()
+	if RoutingEntry(cancelctx) == nil {
+		t.Fatal("cancel")
+	}
+}
+
+func TestRoutingEntryCancelDuringLookup(t *testing.T) {
+	s, p, _ := fixture(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	c := &routingConsumer{session: s, required: true, flow: p.Flow, lookup: func(context.Context, Flow) (Evidence, error) { cancel(); return p, nil }}
+	ctx = context.WithValue(ctx, routingKey{}, c)
+	if RoutingEntry(ctx) == nil {
+		t.Fatal("отмена во время lookup пропустила routing")
+	}
+	if s.Guard(p.Observed, BeforeRouting, true, p.Flow, p) == nil {
+		t.Fatal("отмена не отозвала сессию")
+	}
+}

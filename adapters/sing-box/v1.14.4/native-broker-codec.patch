diff --git a/common/yonikbroker/named_downstream_test.go b/common/yonikbroker/named_downstream_test.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/named_downstream_test.go
@@ -0,0 +1,225 @@
+package nativehooks_test
+
+import (
+	"context"
+	"fmt"
+	mdns "github.com/miekg/dns"
+	box "github.com/sagernet/sing-box"
+	"github.com/sagernet/sing-box/adapter"
+	H "github.com/sagernet/sing-box/common/yonikbroker"
+	"github.com/sagernet/sing-box/include"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/json"
+	M "github.com/sagernet/sing/common/metadata"
+	"io"
+	"net"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestNamedDownstream(t *testing.T) {
+	for _, network := range []string{"tcp", "udp"} {
+		for _, rawMode := range []string{"known", "cancel", "revoke", "epoch", "unknown", "unavailable", "stale", "cache/known", "cache/cancel", "cache/revoke", "cache/epoch", "cache/unknown", "cache/unavailable", "cache/stale", "changed-answer"} {
+			t.Run(network+"/"+rawMode, func(t *testing.T) {
+				mode := strings.TrimPrefix(rawMode, "cache/")
+				cached := strings.HasPrefix(rawMode, "cache/")
+				ctx, change, _ := H.ClosedSocketFixture(t)
+				ctx, cancel := context.WithCancel(ctx)
+				defer cancel()
+				ctx = include.Context(ctx)
+				var egress atomic.Int32
+				tcp, e := net.Listen("tcp", "0.0.0.0:0")
+				if e != nil {
+					t.Fatal(e)
+				}
+				defer tcp.Close()
+				port := tcp.Addr().(*net.TCPAddr).Port
+				udp, e := net.ListenPacket("udp", fmt.Sprintf("0.0.0.0:%d", port))
+				if e != nil {
+					t.Fatal(e)
+				}
+				defer udp.Close()
+				go func() {
+					for {
+						c, e := tcp.Accept()
+						if e != nil {
+							return
+						}
+						egress.Add(1)
+						go func() {
+							defer c.Close()
+							io.Copy(c, c)
+						}()
+					}
+				}()
+				go func() {
+					b := make([]byte, 64)
+					for {
+						n, a, e := udp.ReadFrom(b)
+						if e != nil {
+							return
+						}
+						egress.Add(1)
+						udp.WriteTo(b[:n], a)
+					}
+				}()
+				listener, e := net.Listen("tcp", "127.0.0.1:0")
+				if e != nil {
+					t.Fatal(e)
+				}
+				entered, release := make(chan struct{}, 8), make(chan struct{})
+				server := &mdns.Server{Listener: listener, Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, q *mdns.Msg) {
+					entered <- struct{}{}
+					<-release
+					r := new(mdns.Msg)
+					r.SetReply(q)
+					answer := "127.0.0.1"
+					if mode == "changed-answer" {
+						answer = "127.0.0.2"
+					}
+					rr, _ := mdns.NewRR("private.test. 60 IN A " + answer)
+					r.Answer = []mdns.RR{rr}
+					w.WriteMsg(r)
+				})}
+				go server.ActivateAndServe()
+				defer server.Shutdown()
+				var config option.Options
+				e = json.UnmarshalContext(ctx, []byte(fmt.Sprintf(`{"dns":{"servers":[{"type":"tcp","tag":"private","server":"127.0.0.1","server_port":%d}]},"outbounds":[{"type":"direct","tag":"allowed"}],"route":{"rules":[{"action":"resolve","server":"private","strategy":"ipv4_only"},{"ip_cidr":["127.0.0.1/32"],"action":"route","outbound":"allowed"},{"action":"reject"}],"default_domain_resolver":"private"}}`, listener.Addr().(*net.TCPAddr).Port)), &config)
+				if e != nil {
+					t.Fatal(e)
+				}
+				instance, e := box.New(box.Options{Options: config, Context: ctx})
+				if e != nil {
+					t.Fatal(e)
+				}
+				defer instance.Close()
+				if e = instance.Start(); e != nil {
+					t.Fatal(e)
+				}
+
+				done := make(chan error, 1)
+				run := func() {
+					go func() {
+						metadata := adapter.InboundContext{Destination: M.ParseSocksaddr(fmt.Sprintf("private.test:%d", port))}
+						if network == "tcp" {
+							left, right := net.Pipe()
+							defer left.Close()
+							defer right.Close()
+							go instance.Router().RouteConnection(ctx, right, metadata)
+							left.SetDeadline(time.Now().Add(3 * time.Second))
+							_, e := left.Write([]byte("named"))
+							if e == nil {
+								b := make([]byte, 5)
+								_, e = io.ReadFull(left, b)
+							}
+							done <- e
+						} else {
+							p, e := net.ListenPacket("udp", "127.0.0.1:0")
+							if e != nil {
+								done <- e
+								return
+							}
+							defer p.Close()
+
+							c, e := net.Dial("udp", p.LocalAddr().String())
+							if e != nil {
+								done <- e
+								return
+							}
+							defer c.Close()
+							go instance.Router().RoutePacketConnection(ctx, &namedPacketConn{PacketConn: p, destination: metadata.Destination, client: c.LocalAddr()}, metadata)
+							c.SetDeadline(time.Now().Add(3 * time.Second))
+							_, e = c.Write([]byte("named"))
+							if e == nil {
+								b := make([]byte, 5)
+								_, e = c.Read(b)
+							}
+							done <- e
+						}
+					}()
+
+				}
+				run()
+				select {
+				case <-entered:
+				case <-time.After(3 * time.Second):
+					t.Fatal("DNS barrier не достигнут")
+				}
+				warmQuestions := 0
+				if cached {
+					close(release)
+					select {
+					case e := <-done:
+						if e != nil {
+							t.Fatal(e)
+						}
+					case <-time.After(4 * time.Second):
+						t.Fatal("cache warm echo timeout")
+					}
+					egress.Store(0)
+					warmQuestions = len(entered)
+				}
+
+				if mode == "cancel" {
+					cancel()
+				} else if mode == "epoch" {
+					change("stale")
+				} else if mode == "stale" {
+					change("expired")
+				} else {
+					change(mode)
+				}
+				if cached {
+					run()
+				} else {
+					close(release)
+				}
+				if mode == "known" {
+					select {
+					case e := <-done:
+						if e != nil {
+							t.Fatal(e)
+						}
+					case <-time.After(3 * time.Second):
+						t.Fatal("нет echo")
+					}
+					if egress.Load() == 0 {
+						t.Fatal("нет egress")
+					}
+				} else {
+					select {
+					case <-done:
+					case <-time.After(time.Second):
+					}
+					if egress.Load() != 0 {
+						t.Fatalf("запрещённый egress %d", egress.Load())
+					}
+				}
+				if cached && len(entered) != warmQuestions {
+					t.Fatal("cache flow выполнил новый DNS exchange")
+				}
+				t.Logf("native routing→beforeDial→%s egress=%d mode=%s", network, egress.Load(), mode)
+			})
+		}
+	}
+}
+
+// Адаптер моделирует inbound packet metadata; routing, resolver и outbound остаются native.
+type namedPacketConn struct {
+	net.PacketConn
+	destination M.Socksaddr
+	client      net.Addr
+}
+
+func (p *namedPacketConn) ReadPacket(b *buf.Buffer) (M.Socksaddr, error) {
+	_, _, e := b.ReadPacketFrom(p.PacketConn)
+	return p.destination, e
+}
+func (p *namedPacketConn) WritePacket(b *buf.Buffer, _ M.Socksaddr) error {
+	defer b.Release()
+	_, e := p.PacketConn.WriteTo(b.Bytes(), p.client)
+	return e
+}
diff --git a/common/yonikbroker/monitor_close_linux_test.go b/common/yonikbroker/monitor_close_linux_test.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/monitor_close_linux_test.go
@@ -0,0 +1,63 @@
+//go:build linux && !android
+
+package nativehooks
+
+import (
+	"context"
+	"os"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// Shutdown обязан дождаться пользователя borrowed FD под общим mutex.
+func TestMonitorCloseWaitsForBorrower(t *testing.T) {
+	pair, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_SEQPACKET|syscall.SOCK_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	channel := os.NewFile(uintptr(pair[0]), "channel")
+	defer channel.Close()
+	peer := os.NewFile(uintptr(pair[1]), "peer")
+	defer peer.Close()
+	pidfd, err := os.Open("/dev/null")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pidfd.Close()
+	session, err := NewSession(Binding{Nonce: [32]byte{1}, ConfigDigest: [32]byte{2}, Epoch: 3}, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := &routingConsumer{channel: channel, pidfd: pidfd, session: session}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	c.mu.Lock()
+	done := make(chan struct{})
+	go func() { c.monitorTUN(ctx); close(done) }()
+	select {
+	case <-done:
+		c.mu.Unlock()
+		t.Fatal("monitor закрыл borrowed FD до освобождения mutex")
+	case <-time.After(50 * time.Millisecond):
+	}
+	raw, err := channel.SyscallConn()
+	if err == nil {
+		err = raw.Control(func(fd uintptr) { _, err = syscall.GetsockoptInt(int(fd), syscall.SOL_SOCKET, syscall.SO_TYPE) })
+	}
+	c.mu.Unlock()
+	if err != nil {
+		t.Fatalf("borrowed FD уже закрыт: %v", err)
+	}
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("monitor не завершился")
+	}
+	if err := raw.Control(func(uintptr) {}); err == nil {
+		t.Fatal("channel не закрыт")
+	}
+	if session.Context().Err() == nil {
+		t.Fatal("session не отозвана")
+	}
+}
diff --git a/common/yonikbroker/flow_scope_test.go b/common/yonikbroker/flow_scope_test.go
new file mode 100644
--- /dev/null
+++ b/common/yonikbroker/flow_scope_test.go
@@ -0,0 +1,167 @@
+package nativehooks
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type countedSocket struct {
+	net.Conn
+	closes atomic.Int32
+}
+
+func (c *countedSocket) Close() error                 { c.closes.Add(1); return c.Conn.Close() }
+func TestSingleSessionFlowScope(t *testing.T)         { singleSessionFlowScope(t, false) }
+func TestAdmittedSingleSessionFlowScope(t *testing.T) { singleSessionFlowScope(t, true) }
+func singleSessionFlowScope(t *testing.T, admitted bool) {
+	for _, network := range []string{"tcp", "udp"} {
+		for _, mode := range []string{"cancel", "unknown", "unavailable", "revoke"} {
+			t.Run(network+"/"+mode, func(t *testing.T) {
+				s, p, _ := fixture(t)
+				defer func() { _ = s.Revoke() }()
+				globalRevoke := func() { _ = s.Revoke() }
+				if admitted {
+					ctx, _, wireRevoke := closedTUNFixtureMode(t, "known/revoke")
+					s = ctx.Value(routingKey{}).(*routingConsumer).session
+					p.Binding = s.binding
+					globalRevoke = func() {
+						wireRevoke()
+						select {
+						case <-s.Context().Done():
+						case <-time.After(time.Second):
+							t.Fatal("wire REVOKE не обработан")
+						}
+						_ = s.Revoke()
+					}
+				}
+				var address string
+				if network == "tcp" {
+					l, e := net.Listen("tcp", "127.0.0.1:0")
+					if e != nil {
+						t.Fatal(e)
+					}
+					defer l.Close()
+					address = l.Addr().String()
+					go func() {
+						for {
+							c, e := l.Accept()
+							if e != nil {
+								return
+							}
+							go func() {
+								defer c.Close()
+								b := make([]byte, 8)
+								for {
+									n, e := c.Read(b)
+									if e != nil {
+										return
+									}
+									_, _ = c.Write(b[:n])
+								}
+							}()
+						}
+					}()
+				} else {
+					l, e := net.ListenPacket("udp", "127.0.0.1:0")
+					if e != nil {
+						t.Fatal(e)
+					}
+					defer l.Close()
+					address = l.LocalAddr().String()
+					go func() {
+						b := make([]byte, 8)
+						for {
+							n, a, e := l.ReadFrom(b)
+							if e != nil {
+								return
+							}
+							_, _ = l.WriteTo(b[:n], a)
+						}
+					}()
+				}
+				makeFlow := func() (context.Context, context.CancelFunc, *routingConsumer, *countedSocket, func() error) {
+					ctx, cancel := context.WithCancel(context.Background())
+					c := &routingConsumer{session: s, required: true, flow: p.Flow}
+					c.lookup = func(context.Context, Flow) (Evidence, error) {
+						q := p
+						q.Flow = c.flow
+						q.Observed = time.Now()
+						q.Expires = q.Observed.Add(20 * time.Millisecond)
+						return q, nil
+					}
+					ctx = context.WithValue(ctx, routingKey{}, c)
+					conn, e := net.Dial(network, address)
+					if e != nil {
+						t.Fatal(e)
+					}
+					c.flow.Local = netip.MustParseAddrPort(conn.LocalAddr().String())
+					c.flow.Remote = netip.MustParseAddrPort(conn.RemoteAddr().String())
+					if network == "udp" {
+						c.flow.Protocol = 17
+					}
+					socket := &countedSocket{Conn: conn}
+					release, e := OwnSocket(ctx, socket)
+					if e != nil {
+						t.Fatal(e)
+					}
+					return ctx, cancel, c, socket, release
+				}
+				a, ca, c, sa, ra := makeFlow()
+				defer ca()
+				defer ra()
+				b, cb, _, sb, rb := makeFlow()
+				defer cb()
+				defer rb()
+				switch mode {
+				case "cancel":
+					ca()
+				case "unknown", "unavailable":
+					c.lookup = func(context.Context, Flow) (Evidence, error) {
+						q := p
+						q.Flow = c.flow
+						if mode == "unknown" {
+							q.Status = Unknown
+						} else {
+							q.Status = Unavailable
+						}
+						return q, nil
+					}
+				case "revoke":
+					globalRevoke()
+				}
+				if RoutingEntry(a) == nil {
+					t.Fatal("A разрешён")
+				}
+				if sa.closes.Load() == 0 {
+					t.Fatal("A не закрыт")
+				}
+				if mode == "revoke" {
+					if RoutingEntry(b) == nil || sb.closes.Load() == 0 {
+						t.Fatal("глобальный revoke не закрыл B")
+					}
+					return
+				}
+				if RoutingEntry(b) != nil || sb.closes.Load() != 0 {
+					t.Fatal("B отозван вместе с A")
+				}
+				_ = sb.SetDeadline(time.Now().Add(time.Second))
+				if _, e := sb.Write([]byte("echo")); e != nil {
+					t.Fatal(e)
+				}
+				buf := make([]byte, 4)
+				n, e := sb.Read(buf)
+				if e != nil || n != 4 || string(buf) != "echo" {
+					t.Fatalf("echo B: %q %v", buf, e)
+				}
+				t.Logf("A_close=%d B_close=%d B_echo_bytes=%d", sa.closes.Load(), sb.closes.Load(), n)
+				if RoutingEntry(a) == nil {
+					t.Fatal("A повторно разрешён")
+				}
+			})
+		}
+	}
+}
diff --git a/common/yonikbroker/dns_exchange.go b/common/yonikbroker/dns_exchange.go
new file mode 100644

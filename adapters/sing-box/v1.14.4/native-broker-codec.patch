diff --git a/common/yonikbroker/bootstrap_linux.go b/common/yonikbroker/bootstrap_linux.go
new file mode 100644
index 0000000..d935550
--- /dev/null
+++ b/common/yonikbroker/bootstrap_linux.go
@@ -0,0 +1,164 @@
+package nativehooks
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+)
+
+// Bootstrap содержит только поля замороженного closed worker handoff.
+// Вызывающий protected worker обязан подтвердить происхождение record до exec.
+// Разбор произвольной строки окружения сам по себе authority не создаёт.
+type Bootstrap struct {
+	Binding         Binding
+	Session         [16]byte
+	Generation      uint64
+	Invocation      [16]byte
+	ServerPID       uint32
+	ServerStarttime uint64
+}
+
+func DecodeBootstrap(b []byte, fdCount int) (Bootstrap, error) {
+	var r Bootstrap
+	if len(b) != 192 || fdCount != 2 || string(b[:8]) != "YNKROLE1" || zero(b[8:40]) || zero(b[40:72]) || u64(b, 72) == 0 || zero(b[80:96]) || u64(b, 96) == 0 || zero(b[104:120]) || u32(b, 120) == 0 || u32(b, 124) != 0 || u64(b, 128) == 0 || !zero(b[136:144]) || u16(b, 144) != 2 || u16(b, 146) != 1 || u16(b, 148) != 2 || !zero(b[150:192]) {
+		return r, ErrMalformed
+	}
+	copy(r.Binding.Nonce[:], b[8:40])
+	copy(r.Binding.ConfigDigest[:], b[40:72])
+	r.Binding.Epoch = u64(b, 72)
+	copy(r.Session[:], b[80:96])
+	r.Generation = u64(b, 96)
+	copy(r.Invocation[:], b[104:120])
+	r.ServerPID = u32(b, 120)
+	r.ServerStarttime = u64(b, 128)
+	return r, nil
+}
+
+// CheckServer сверяет live pidfd и starttime. FD принадлежит custody вызывающего.
+// pidfd readable при exit, поэтому одного существующего /proc/PID недостаточно.
+func (b Bootstrap) CheckServer(pidfd *os.File) error {
+	if pidfd == nil {
+		return ErrDenied
+	}
+	fd := int(pidfd.Fd())
+	var set syscall.FdSet
+	if fd < 0 || fd >= len(set.Bits)*64 {
+		return ErrDenied
+	}
+	set.Bits[fd/64] |= 1 << uint(fd%64)
+	timeout := syscall.Timeval{}
+	n, err := syscall.Select(fd+1, &set, nil, nil, &timeout)
+	if err != nil || n != 0 {
+		return ErrDenied
+	}
+	info, err := os.ReadFile(fmt.Sprintf("/proc/self/fdinfo/%d", fd))
+	if err != nil {
+		return ErrDenied
+	}
+	found := false
+	for _, line := range strings.Split(string(info), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 && fields[0] == "Pid:" {
+			pid, e := strconv.ParseUint(fields[1], 10, 32)
+			if e != nil || pid != uint64(b.ServerPID) {
+				return ErrDenied
+			}
+			found = true
+		}
+	}
+	if !found {
+		return ErrDenied
+	}
+	stat, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", b.ServerPID))
+	if err != nil {
+		return ErrDenied
+	}
+	end := strings.LastIndexByte(string(stat), ')')
+	if end < 0 {
+		return ErrDenied
+	}
+	fields := strings.Fields(string(stat[end+1:]))
+	if len(fields) <= 19 {
+		return ErrDenied
+	}
+	start, err := strconv.ParseUint(fields[19], 10, 64)
+	if err != nil || start != b.ServerStarttime {
+		return ErrDenied
+	}
+	return nil
+}
+
+// ReceiveAuthenticated принимает владение всеми полученными FD даже при отказе.
+// Возвращённые FD переходят вызывающему только после всех проверок.
+func (b Bootstrap) ReceiveAuthenticated(channel, pidfd *os.File) (Frame, []*os.File, error) {
+	fail := func(files []*os.File) (Frame, []*os.File, error) {
+		for _, f := range files {
+			_ = f.Close()
+		}
+		return Frame{}, nil, ErrDenied
+	}
+	if channel == nil || b.CheckServer(pidfd) != nil {
+		return fail(nil)
+	}
+	kind, err := syscall.GetsockoptInt(int(channel.Fd()), syscall.SOL_SOCKET, syscall.SO_TYPE)
+	if err != nil || kind != syscall.SOCK_SEQPACKET {
+		return fail(nil)
+	}
+	pass, err := syscall.GetsockoptInt(int(channel.Fd()), syscall.SOL_SOCKET, syscall.SO_PASSCRED)
+	if err != nil || pass != 1 {
+		return fail(nil)
+	}
+	data := make([]byte, MaxFrameBytes+1)
+	control := make([]byte, syscall.CmsgSpace(4*16)+syscall.CmsgSpace(syscall.SizeofUcred))
+	fd := int(channel.Fd())
+	var ready syscall.FdSet
+	if fd < 0 || fd >= len(ready.Bits)*64 {
+		return fail(nil)
+	}
+	ready.Bits[fd/64] |= 1 << uint(fd%64)
+	timeout := syscall.NsecToTimeval(int64(20 * time.Millisecond))
+	count, waitErr := syscall.Select(fd+1, &ready, nil, nil, &timeout)
+	if waitErr != nil || count != 1 {
+		return fail(nil)
+	}
+	n, oobn, flags, _, err := syscall.Recvmsg(fd, data, control, syscall.MSG_CMSG_CLOEXEC|syscall.MSG_DONTWAIT)
+	var files []*os.File
+	messages, parseErr := syscall.ParseSocketControlMessage(control[:oobn])
+	credentials := 0
+	valid := true
+	for _, message := range messages {
+		switch {
+		case message.Header.Level == syscall.SOL_SOCKET && message.Header.Type == syscall.SCM_RIGHTS:
+			rights, e := syscall.ParseUnixRights(&message)
+			if e != nil {
+				valid = false
+				continue
+			}
+			for _, fd := range rights {
+				files = append(files, os.NewFile(uintptr(fd), "native-broker-received"))
+			}
+		case message.Header.Level == syscall.SOL_SOCKET && message.Header.Type == syscall.SCM_CREDENTIALS:
+			credentials++
+			cred, e := syscall.ParseUnixCredentials(&message)
+			if e != nil || uint32(cred.Pid) != b.ServerPID || cred.Uid != 0 {
+				valid = false
+			}
+		default:
+			valid = false
+		}
+	}
+	if err != nil || parseErr != nil || !valid || credentials != 1 || flags&(syscall.MSG_TRUNC|syscall.MSG_CTRUNC) != 0 || n == 0 || b.CheckServer(pidfd) != nil {
+		return fail(files)
+	}
+	frame, err := DecodeFrame(data[:n], len(files))
+	if err != nil || frame.CheckBinding(b.Binding, frame.Header.RequestID) != nil {
+		return fail(files)
+	}
+	if frame.Header.Kind == HelloKind && (frame.Hello.Session != b.Session || frame.Hello.Generation != b.Generation || frame.Hello.Invocation != b.Invocation) {
+		return fail(files)
+	}
+	return frame, files, nil
+}
diff --git a/common/yonikbroker/bootstrap_linux_test.go b/common/yonikbroker/bootstrap_linux_test.go
new file mode 100644
index 0000000..30f3ee1
--- /dev/null
+++ b/common/yonikbroker/bootstrap_linux_test.go
@@ -0,0 +1,218 @@
+package nativehooks
+
+import (
+	"os"
+	"runtime"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+)
+
+func roleRecord() []byte {
+	b := make([]byte, 192)
+	copy(b, "YNKROLE1")
+	b[8] = 1
+	b[40] = 2
+	be.PutUint64(b[72:], 3)
+	b[80] = 4
+	be.PutUint64(b[96:], 5)
+	b[104] = 6
+	be.PutUint32(b[120:], 7)
+	be.PutUint64(b[128:], 8)
+	be.PutUint16(b[144:], 2)
+	be.PutUint16(b[146:], 1)
+	be.PutUint16(b[148:], 2)
+	return b
+}
+func TestClosedBootstrap(t *testing.T) {
+	b := roleRecord()
+	r, e := DecodeBootstrap(b, 2)
+	if e != nil || r.ServerPID != 7 || r.Binding.Epoch != 3 {
+		t.Fatal(r, e)
+	}
+	for _, n := range []int{0, 1, 3} {
+		if _, e := DecodeBootstrap(b, n); e == nil {
+			t.Fatalf("принято %d FD", n)
+		}
+	}
+	for _, n := range []int{0, 136, 137, 143, 144, 146, 148, 150, 191} {
+		bad := append([]byte(nil), b...)
+		bad[n] ^= 255
+		if _, e := DecodeBootstrap(bad, 2); e == nil {
+			t.Fatalf("принято изменение byte %d", n)
+		}
+	}
+	for _, n := range []int{0, 136, 191, 193} {
+		bad := make([]byte, n)
+		copy(bad, b)
+		if _, e := DecodeBootstrap(bad, 2); e == nil {
+			t.Fatalf("принята длина %d", n)
+		}
+	}
+	if r.CheckServer(nil) == nil {
+		t.Fatal("nil pidfd принят")
+	}
+}
+
+func TestBootstrapRejectsMissingIdentity(t *testing.T) {
+	for _, span := range [][2]int{{8, 40}, {40, 72}, {72, 80}, {80, 96}, {96, 104}, {104, 120}, {120, 124}, {128, 136}} {
+		b := roleRecord()
+		for i := span[0]; i < span[1]; i++ {
+			b[i] = 0
+		}
+		if _, err := DecodeBootstrap(b, 2); err == nil {
+			t.Fatalf("принято пустое поле %v", span)
+		}
+	}
+	b := roleRecord()
+	be.PutUint32(b[124:], 1000)
+	if _, err := DecodeBootstrap(b, 2); err == nil {
+		t.Fatal("принят server UID != 0")
+	}
+}
+
+// Linux pidfd_open имеет номер 434 на поддерживаемых здесь amd64/arm64.
+func liveBootstrap(t *testing.T) (Bootstrap, *os.File) {
+	t.Helper()
+	if runtime.GOARCH != "amd64" && runtime.GOARCH != "arm64" {
+		t.Skip("pidfd fixture поддерживает amd64/arm64")
+	}
+	fd, _, errno := syscall.Syscall(434, uintptr(os.Getpid()), 0, 0)
+	if errno != 0 {
+		t.Skipf("pidfd_open: %v", errno)
+	}
+	f := os.NewFile(fd, "test-pidfd")
+	t.Cleanup(func() { _ = f.Close() })
+	stat, err := os.ReadFile("/proc/self/stat")
+	if err != nil {
+		t.Fatal(err)
+	}
+	fields := strings.Fields(string(stat[strings.LastIndexByte(string(stat), ')')+1:]))
+	start, err := strconv.ParseUint(fields[19], 10, 64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	record := roleRecord()
+	be.PutUint32(record[120:], uint32(os.Getpid()))
+	be.PutUint64(record[128:], start)
+	b, err := DecodeBootstrap(record, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b, f
+}
+func TestLiveAnchor(t *testing.T) {
+	b, f := liveBootstrap(t)
+	if err := b.CheckServer(f); err != nil {
+		t.Fatal(err)
+	}
+	b.ServerStarttime++
+	if b.CheckServer(f) == nil {
+		t.Fatal("принят чужой starttime")
+	}
+	b.ServerStarttime--
+	b.ServerPID++
+	if b.CheckServer(f) == nil {
+		t.Fatal("принят чужой PID")
+	}
+}
+func TestRecvClosesRejectedRights(t *testing.T) {
+	b, pidfd := liveBootstrap(t)
+	pair, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_SEQPACKET|syscall.SOCK_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	receiver := os.NewFile(uintptr(pair[0]), "receiver")
+	sender := os.NewFile(uintptr(pair[1]), "sender")
+	defer receiver.Close()
+	defer sender.Close()
+	if err := syscall.SetsockoptInt(pair[0], syscall.SOL_SOCKET, syscall.SO_PASSCRED, 1); err != nil {
+		t.Fatal(err)
+	}
+	pipeR, pipeW, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pipeR.Close()
+	defer pipeW.Close()
+	before, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Некорректный frame с real SCM_RIGHTS обязан закрыть полученный duplicate.
+	if err := syscall.Sendmsg(pair[1], []byte("malformed"), syscall.UnixRights(int(pipeR.Fd())), nil, 0); err != nil {
+		t.Fatal(err)
+	}
+	if _, files, err := b.ReceiveAuthenticated(receiver, pidfd); err == nil || len(files) != 0 {
+		t.Fatal("принят malformed frame")
+	}
+	after, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(before) != len(after) {
+		t.Fatalf("FD leak: %d -> %d", len(before), len(after))
+	}
+}
+
+func TestHelloMatchesEntireBootstrapIdentity(t *testing.T) {
+	if os.Geteuid() != 0 {
+		t.Skip("нужен изолированный user namespace с UID 0")
+	}
+	for _, field := range []string{"control", "session", "generation", "invocation"} {
+		t.Run(field, func(t *testing.T) {
+			b, pidfd := liveBootstrap(t)
+			var data []byte
+			for _, vector := range vectors(t) {
+				candidate := wireBytes(t, vector)
+				frame, err := DecodeFrame(candidate, vector.FDCount)
+				if err == nil && frame.Header.Kind == HelloKind {
+					data = candidate
+					break
+				}
+			}
+			if data == nil {
+				t.Fatal("нет корректного HELLO control")
+			}
+			be.PutUint64(data[24:], b.Binding.Epoch)
+			copy(data[32:64], b.Binding.ConfigDigest[:])
+			copy(data[64:96], b.Binding.Nonce[:])
+			copy(data[96:112], b.Session[:])
+			be.PutUint64(data[112:], b.Generation)
+			copy(data[120:136], b.Invocation[:])
+			switch field {
+			case "session":
+				data[96] ^= 128
+			case "generation":
+				be.PutUint64(data[112:], b.Generation+1)
+			case "invocation":
+				data[120] ^= 128
+			}
+			pair, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_SEQPACKET|syscall.SOCK_CLOEXEC, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			receiver := os.NewFile(uintptr(pair[0]), "receiver")
+			sender := os.NewFile(uintptr(pair[1]), "sender")
+			defer receiver.Close()
+			defer sender.Close()
+			if err := syscall.SetsockoptInt(pair[0], syscall.SOL_SOCKET, syscall.SO_PASSCRED, 1); err != nil {
+				t.Fatal(err)
+			}
+			if err := syscall.Sendmsg(pair[1], data, nil, nil, 0); err != nil {
+				t.Fatal(err)
+			}
+			_, files, err := b.ReceiveAuthenticated(receiver, pidfd)
+			for _, file := range files {
+				file.Close()
+			}
+			if field == "control" && err != nil {
+				t.Fatalf("корректный HELLO отклонён: %v", err)
+			}
+			if field != "control" && err == nil {
+				t.Fatalf("принята чужая identity: %s", field)
+			}
+		})
+	}
+}

+)
+
+func TestActualSocketGuard(t *testing.T) {
+	for _, network := range []string{"tcp", "udp", "listen"} {
+		for _, status := range []H.Status{H.Known, H.Unknown, H.Unavailable} {
+			t.Run(network+string(rune('0'+status)), func(t *testing.T) {
+				ctx := H.ClosedRoutingFixture(t, status)
+				d, err := D.NewDefault(ctx, option.DialerOptions{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				target, err := net.Listen("tcp4", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer target.Close()
+				ctx, cancel := context.WithTimeout(ctx, time.Second)
+				defer cancel()
+				var conn interface{ Close() error }
+				if network == "listen" {
+					conn, err = d.ListenPacket(ctx, M.ParseSocksaddr("127.0.0.1:12345"))
+				} else {
+					conn, err = d.DialContext(ctx, network, M.ParseSocksaddr(target.Addr().String()))
+				}
+				if err == nil {
+					defer conn.Close()
+				}
+				if (err == nil) != (status == H.Known) {
+					t.Fatalf("status %v: %v", status, err)
+				}
+			})
+		}
+		t.Run(network+"-no-handoff", func(t *testing.T) {
+			ctx := context.Background()
+			d, err := D.NewDefault(ctx, option.DialerOptions{})
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			if network == "listen" {
+				c, e := d.ListenPacket(ctx, M.ParseSocksaddr("127.0.0.1:12345"))
+				if e == nil {
+					c.Close()
+					t.Fatal("listen without handoff")
+				}
+			} else {
+				c, e := d.DialContext(ctx, network, M.ParseSocksaddr("127.0.0.1:9"))
+				if e == nil {
+					c.Close()
+					t.Fatal("dial without handoff")
+				}
+				if !errors.Is(e, H.ErrDenied) {
+					t.Fatalf("guard not reached: %v", e)
+				}
+			}
+		})
+	}
+}
+
+func TestActualSocketFreshProof(t *testing.T) {
+	for _, network := range []string{"tcp", "udp", "listen"} {
+		for _, mode := range []string{"known", "unknown", "unavailable", "stale", "expired", "revoke", "cancel"} {
+			t.Run(network+"/"+mode, func(t *testing.T) {
+				ctx, change, calls := H.ClosedSocketFixture(t)
+				if err := H.RoutingEntry(ctx); err != nil {
+					t.Fatal(err)
+				}
+				change(mode)
+				ctx, cancel := context.WithCancel(ctx)
+				defer cancel()
+				if mode == "cancel" {
+					cancel()
+				}
+				d, err := D.NewDefault(ctx, option.DialerOptions{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				target, err := net.Listen("tcp4", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer target.Close()
+				var conn interface{ Close() error }
+				if network == "listen" {
+					conn, err = d.ListenPacket(ctx, M.ParseSocksaddr("127.0.0.1:12345"))
+				} else {
+					conn, err = d.DialContext(ctx, network, M.ParseSocksaddr(target.Addr().String()))
+				}
+				if err == nil {
+					defer conn.Close()
+				}
+				if (err == nil) != (mode == "known") {
+					t.Fatalf("%s: %v", mode, err)
+				}
+				if mode == "known" && calls() < 2 {
+					t.Fatalf("cached routing proof: %d", calls())
+				}
+			})
+		}
+	}
+}
+
+func TestActualDelayedTFODenial(t *testing.T) {
+	for _, mode := range []string{"unknown", "unavailable", "stale", "cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, change, _ := H.ClosedSocketFixture(t)
+			ctx, cancel := context.WithCancel(ctx)
+			defer cancel()
+			opts := option.DialerOptions{}
+			opts.TCPFastOpen = true
+			d, err := D.NewDefault(ctx, opts)
+			if err != nil {
+				t.Fatal(err)
+			}
+			c, err := d.DialContext(ctx, "tcp", M.ParseSocksaddr("127.0.0.1:9"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			change(mode)
+			if mode == "cancel" {
+				cancel()
+			}
+			n, err := c.Write([]byte("запрещено"))
+			if n != 0 || !errors.Is(err, H.ErrDenied) {
+				t.Fatalf("n=%d err=%v", n, err)
+			}
+		})
+	}
+}

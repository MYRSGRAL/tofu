+// validateExternalConfiguration запрещает смешивать внешнего владельца сети
+// с нативным управлением routes/DNS. Существование интерфейса проверяется при Start,
+// чтобы config-check не создавал TUN и не зависел от уже применённой сети.
+func validateExternalConfiguration(options option.TunInboundOptions, usePlatformInterface bool) error {
+	if !options.ExternalConfiguration {
+		return nil
+	}
+	if !C.IsLinux || usePlatformInterface || options.Platform != nil || options.NetNs != "" {
+		return E.New("external_configuration requires a Linux interface in the current namespace")
+	}
+	if options.InterfaceName == "" || options.MTU == 0 || len(options.Address) == 0 {
+		return E.New("external_configuration requires explicit interface_name, mtu and address")
+	}
+	if options.AutoRoute || options.AutoRedirect || options.StrictRoute {
+		return E.New("external_configuration conflicts with automatic routing")
+	}
+	if (options.DNSMode != "" && options.DNSMode != "disabled") || len(options.DNSAddress) != 0 {
+		return E.New("external_configuration requires disabled native DNS")
+	}
+	return nil
+}

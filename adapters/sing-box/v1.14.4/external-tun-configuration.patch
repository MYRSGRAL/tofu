diff --git a/protocol/tun/external_configuration_test.go b/protocol/tun/external_configuration_test.go
new file mode 100644
--- /dev/null
+++ b/protocol/tun/external_configuration_test.go
@@ -0,0 +1,76 @@
+package tun
+
+import (
+	"encoding/json"
+	"net/netip"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+)
+
+func externalOptions(t *testing.T) option.TunInboundOptions {
+	t.Helper()
+	var options option.TunInboundOptions
+	if err := json.Unmarshal([]byte(`{"external_configuration":true,"interface_name":"tofu00000001","mtu":1500,"address":["198.18.0.1/30","2001:db8:746f::1/126"],"dns_mode":"disabled"}`), &options); err != nil {
+		t.Fatal(err)
+	}
+	return options
+}
+
+func TestExternalConfigurationExplicitWireContract(t *testing.T) {
+	options := externalOptions(t)
+	if !options.ExternalConfiguration || options.InterfaceName != "tofu00000001" || len(options.Address) != 2 {
+		t.Fatal("external_configuration: typed settings lost")
+	}
+	var omitted option.TunInboundOptions
+	if err := json.Unmarshal([]byte(`{}`), &omitted); err != nil || omitted.ExternalConfiguration {
+		t.Fatal("external_configuration: upstream default changed")
+	}
+	if err := json.Unmarshal([]byte(`{"external_configuration":"true"}`), &omitted); err == nil {
+		t.Fatal("external_configuration: non-boolean accepted")
+	}
+	if C.IsLinux {
+		if err := validateExternalConfiguration(options, false); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestExternalConfigurationRejectsCompetingNetworkOwners(t *testing.T) {
+	if !C.IsLinux {
+		t.Skip("external_configuration is Linux-only")
+	}
+	for name, mutate := range map[string]func(*option.TunInboundOptions){
+		"auto-route":      func(o *option.TunInboundOptions) { o.AutoRoute = true },
+		"auto-redirect":   func(o *option.TunInboundOptions) { o.AutoRedirect = true },
+		"strict-route":    func(o *option.TunInboundOptions) { o.StrictRoute = true },
+		"native-dns":      func(o *option.TunInboundOptions) { o.DNSMode = "native" },
+		"hijack-dns":      func(o *option.TunInboundOptions) { o.DNSMode = "hijack" },
+		"dns-address":     func(o *option.TunInboundOptions) { o.DNSAddress = []netip.Addr{netip.MustParseAddr("198.18.0.2")} },
+		"no-name":         func(o *option.TunInboundOptions) { o.InterfaceName = "" },
+		"no-mtu":          func(o *option.TunInboundOptions) { o.MTU = 0 },
+		"no-address":      func(o *option.TunInboundOptions) { o.Address = nil },
+		"other-namespace": func(o *option.TunInboundOptions) { o.NetNs = "other" },
+		"platform":        func(o *option.TunInboundOptions) { o.Platform = &option.TunPlatformOptions{} },
+	} {
+		t.Run(name, func(t *testing.T) {
+			options := externalOptions(t)
+			mutate(&options)
+			if err := validateExternalConfiguration(options, false); err == nil {
+				t.Fatal("external_configuration: competing network ownership accepted")
+			}
+		})
+	}
+	if err := validateExternalConfiguration(externalOptions(t), true); err == nil {
+		t.Fatal("external_configuration: platform interface accepted")
+	}
+	// Отсутствие нового режима не вводит ограничений в upstream-конфигурации.
+	legacy := externalOptions(t)
+	legacy.ExternalConfiguration = false
+	legacy.AutoRoute = true
+	legacy.DNSMode = "native"
+	if err := validateExternalConfiguration(legacy, true); err != nil {
+		t.Fatal("external_configuration: legacy behavior changed")
+	}
+}

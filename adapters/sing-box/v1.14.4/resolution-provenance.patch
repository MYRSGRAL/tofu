+func TestProvenanceFailuresAndSources(t *testing.T) {
+	for _, kind := range []string{C.DNSTypeLocal, C.DNSTypeDHCP, C.DNSTypeFakeIP, C.DNSTypeHosts, "unknown"} {
+		t.Run(kind, func(t *testing.T) {
+			tr := proofTransport()
+			tr.kind = kind
+			c := NewClient(ClientOptions{Context: context.Background()})
+			_, err := c.LookupWithProvenance(context.Background(), tr, "lease.example", adapter.DNSQueryOptions{}, nil)
+			require.ErrorIs(t, err, ErrProvenanceUnavailable)
+		})
+	}
+	for _, family := range []uint16{mdns.TypeA, mdns.TypeAAAA} {
+		t.Run(mdns.TypeToString[family], func(t *testing.T) {
+			tr := proofTransport()
+			original := tr.respond
+			tr.respond = func(m *mdns.Msg) (*mdns.Msg, error) {
+				if m.Question[0].Qtype == family {
+					return nil, context.DeadlineExceeded
+				}
+				return original(m)
+			}
+			c := NewClient(ClientOptions{Context: context.Background()})
+			result, err := c.LookupWithProvenance(context.Background(), tr, "lease.example", adapter.DNSQueryOptions{}, nil)
+			require.Error(t, err)

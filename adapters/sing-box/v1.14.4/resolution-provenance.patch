+)
+
+type provenanceTransport struct {
+	fakeDNSTransport
+	kind    string
+	respond func(*mdns.Msg) (*mdns.Msg, error)
+	gate    <-chan struct{}
+	started chan<- struct{}
+}
+
+func (t *provenanceTransport) Type() string { return t.kind }
+func (t *provenanceTransport) Exchange(ctx context.Context, m *mdns.Msg) (*mdns.Msg, error) {
+	t.queryCount.Add(1)
+	return t.respond(m)
+}
+func (t *provenanceTransport) ExchangeAsync(ctx context.Context, m *mdns.Msg, cb func(*mdns.Msg, error)) {
+	if t.gate == nil {
+		cb(t.Exchange(ctx, m))
+		return
+	}
+	if t.started != nil {
+		t.started <- struct{}{}
+	}
+	go func() {
+		select {
+		case <-t.gate:
+			cb(t.Exchange(ctx, m))
+		case <-ctx.Done():
+			cb(nil, ctx.Err())
+		}
+	}()
+}
+func proofTransport() *provenanceTransport {
+	t := &provenanceTransport{kind: C.DNSTypeUDP}
+	t.tag = "wire"
+	t.respond = func(m *mdns.Msg) (*mdns.Msg, error) {
+		r := new(mdns.Msg)
+		r.SetReply(m)
+		if m.Question[0].Qtype == mdns.TypeA {
+			rr, _ := mdns.NewRR("lease.example. 60 IN A 192.0.2.1")
+			r.Answer = []mdns.RR{rr}
+		} else {
+			rr, _ := mdns.NewRR("example. 50 IN SOA ns.example. hostmaster.example. 1 2 3 4 20")
+			r.Ns = []mdns.RR{rr}
+		}
+		return r, nil
+	}
+	return t
+}
+func TestProvenanceActualLookupAndCache(t *testing.T) {
+	now := time.Now()
+	c := NewClient(ClientOptions{Context: context.Background(), Logger: log.NewNOPFactory().Logger()})
+	c.provenanceNow = func() time.Time { return now }
+	tr := proofTransport()
+	first, err := c.LookupWithProvenance(context.Background(), tr, "lease.example", adapter.DNSQueryOptions{}, nil)
+	require.NoError(t, err)
+	require.Equal(t, []netip.Addr{netip.MustParseAddr("192.0.2.1")}, first.Addresses)
+	require.Len(t, first.Families, 2)
+	require.Equal(t, now.Add(60*time.Second), first.Families[0].Deadline)
+	require.Equal(t, now.Add(20*time.Second), first.Families[1].Deadline)
+	require.True(t, first.Families[1].NoData)
+	first.Families[0].Addresses[0] = netip.MustParseAddr("192.0.2.99")
+	now = now.Add(5 * time.Second)
+	second, err := c.LookupWithProvenance(context.Background(), tr, "lease.example", adapter.DNSQueryOptions{}, nil)
+	require.NoError(t, err)
+	require.Equal(t, int32(2), tr.queryCount.Load())
+	require.Equal(t, 55*time.Second, second.Families[0].Deadline.Sub(now))
+	require.Equal(t, "192.0.2.1", second.Families[0].Addresses[0].String())
+	now = now.Add(61 * time.Second)
+	_, err = c.LookupWithProvenance(context.Background(), tr, "lease.example", adapter.DNSQueryOptions{}, nil)
+	require.NoError(t, err)
+	require.Equal(t, int32(4), tr.queryCount.Load())
+}
+func TestProvenanceRawTTL(t *testing.T) {
+	for _, tc := range []struct {
+		name               string
+		opcode             int
+		reserved           bool
+		answers, authority []string
+		ttl                uint32
+		fail               bool
+	}{
+		{name: "reserved_z", reserved: true, answers: []string{"lease.example. 60 IN A 192.0.2.1"}, fail: true},
+		{name: "non_query_opcode", opcode: mdns.OpcodeStatus, answers: []string{"lease.example. 60 IN A 192.0.2.1"}, fail: true},
+		{name: "mixed_zero", answers: []string{"lease.example. 60 IN A 192.0.2.1", "lease.example. 0 IN A 192.0.2.2"}, fail: true},
+		{name: "cname", answers: []string{"lease.example. 7 IN CNAME target.example.", "target.example. 60 IN A 192.0.2.1"}, ttl: 7},
+		{name: "ancestor_dname", answers: []string{"example. 1 IN DNAME target.", "lease.example. 60 IN CNAME lease.target.", "lease.target. 60 IN A 192.0.2.1"}, fail: true},
+		{name: "ancestor_dname_zero", answers: []string{"example. 0 IN DNAME target.", "lease.example. 60 IN CNAME lease.target.", "lease.target. 60 IN A 192.0.2.1"}, fail: true},
+		{name: "negative_cname", answers: []string{"lease.example. 7 IN CNAME target.example."}, authority: []string{"example. 50 IN SOA ns.example. hostmaster.example. 1 2 3 4 20"}, ttl: 7},
+		{name: "negative_min", authority: []string{"example. 50 IN SOA ns.example. hostmaster.example. 1 2 3 4 20"}, ttl: 20},
+		{name: "negative_zero", authority: []string{"example. 50 IN SOA ns.example. hostmaster.example. 1 2 3 4 0"}, fail: true},
+		{name: "negative_missing", fail: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			now := time.Now()
+			tr := proofTransport()
+			tr.respond = func(m *mdns.Msg) (*mdns.Msg, error) {
+				r := new(mdns.Msg)
+				r.SetReply(m)
+				r.Opcode = tc.opcode
+				r.Zero = tc.reserved
+				for _, s := range tc.answers {
+					rr, e := mdns.NewRR(s)
+					require.NoError(t, e)
+					r.Answer = append(r.Answer, rr)
+				}
+				for _, s := range tc.authority {
+					rr, e := mdns.NewRR(s)
+					require.NoError(t, e)
+					r.Ns = append(r.Ns, rr)
+				}
+				return r, nil
+			}
+			c := NewClient(ClientOptions{Context: context.Background(), DisableCache: true})
+			c.provenanceNow = func() time.Time { return now }
+			result, err := c.LookupWithProvenance(context.Background(), tr, "lease.example", adapter.DNSQueryOptions{Strategy: C.DomainStrategyIPv4Only}, nil)
+			if tc.fail {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, now.Add(time.Duration(tc.ttl)*time.Second), result.Families[0].Deadline)
+		})
+	}
+}

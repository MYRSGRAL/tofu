+			require.Empty(t, result.Addresses)
+		})
+	}
+}
+func TestProvenanceDoesNotPromoteOrdinaryCacheOrRewrite(t *testing.T) {
+	now := time.Now()
+	tr := proofTransport()
+	c := NewClient(ClientOptions{Context: context.Background(), DisableExpire: true, OptimisticTimeout: time.Hour})
+	c.provenanceNow = func() time.Time { return now }
+	_, err := c.Lookup(context.Background(), tr, "lease.example", adapter.DNSQueryOptions{}, nil)
+	require.NoError(t, err)
+	result, err := c.LookupWithProvenance(context.Background(), tr, "lease.example", adapter.DNSQueryOptions{}, nil)
+	require.NoError(t, err)
+	require.Equal(t, int32(4), tr.queryCount.Load())
+	rewrite := uint32(900)
+	_, err = c.LookupWithProvenance(context.Background(), tr, "lease.example", adapter.DNSQueryOptions{RewriteTTL: &rewrite}, nil)
+	require.ErrorIs(t, err, ErrProvenanceUnavailable)
+	now = now.Add(21 * time.Second)
+	next, err := c.LookupWithProvenance(context.Background(), tr, "lease.example", adapter.DNSQueryOptions{}, nil)
+	require.NoError(t, err)
+	require.Equal(t, int32(5), tr.queryCount.Load())
+	require.Equal(t, result.Families[0].Deadline, next.Families[0].Deadline)
+	require.Equal(t, now.Add(20*time.Second), next.Families[1].Deadline)
+}
+func TestProvenanceSelectedRules(t *testing.T) {
+	for _, path := range []string{"pending", "explicit", "legacy", "respond_named", "respond_anonymous", "race", "terminal"} {
+		t.Run(path, func(t *testing.T) {
+			selected := proofTransport()
+			selected.tag = "final"
+			discarded := proofTransport()
+			discarded.tag = "discarded"
+			original := discarded.respond
+			discarded.respond = func(m *mdns.Msg) (*mdns.Msg, error) {
+				r, err := original(m)
+				for _, rr := range r.Answer {
+					rr.Header().Ttl = 1
+					if a, ok := rr.(*mdns.A); ok {
+						a.A = netip.MustParseAddr("192.0.2.99").AsSlice()
+					}
+				}
+				return r, err
+			}
+			router := strictCompleteRouter(selected)
+			router.transport.(*fakeDNSTransportManager).transports["discarded"] = discarded
+			opts := adapter.DNSQueryOptions{}
+			switch path {
+			case "explicit":
+				opts.Transport = selected
+			case "legacy":
+				router.legacyDNSMode = true
+			case "respond_named":
+				router.rules = raceTestRules(t, []option.DNSRule{evaluateRule("discarded", "other", true), evaluateRule("final", "chosen", false), respondRule("chosen", false, true)})
+			case "respond_anonymous":
+				router.rules = raceTestRules(t, []option.DNSRule{evaluateRule("discarded", "other", true), evaluateRule("final", "", false), respondRule("", false, true)})
+			case "race":
+				router.rules = raceTestRules(t, []option.DNSRule{evaluateRule("discarded", "other", true), evaluateRule("final", "chosen", false), respondRule("chosen", true, true)})
+			case "terminal":
+				router.rules = raceTestRules(t, []option.DNSRule{routeRule("final", true)})
+			}
+			result, err := router.LookupWithProvenance(context.Background(), "lease.example", opts)
+			require.NoError(t, err)
+			require.Len(t, result.Families, 2)
+			require.Equal(t, []netip.Addr{netip.MustParseAddr("192.0.2.1")}, result.Addresses)
+			for _, proof := range result.Families {
+				require.Equal(t, "final", proof.TransportTag)
+				require.Equal(t, C.DNSTypeUDP, proof.TransportType)
+			}
+		})
+	}
+}
+func TestProvenanceRejectsMalformedChainAndQuestion(t *testing.T) {
+	for _, kind := range []string{"question", "truncated", "rcode", "cycle", "conflict", "uncovered_soa", "unrelated"} {
+		t.Run(kind, func(t *testing.T) {

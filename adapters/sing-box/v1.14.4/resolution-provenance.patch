+func TestProvenanceCacheBounds(t *testing.T) {
+	c := NewClient(ClientOptions{Context: context.Background()})
+	c.ClearCache()
+	require.Nil(t, c.provenanceCache.Load())
+	tr := proofTransport()
+	tr.respond = func(m *mdns.Msg) (*mdns.Msg, error) {
+		return FixedResponse(m.Id, m.Question[0], []netip.Addr{netip.MustParseAddr("192.0.2.1")}, 60), nil
+	}
+	options := adapter.DNSQueryOptions{Strategy: C.DomainStrategyIPv4Only}
+	for i := range 270 {
+		_, err := c.LookupWithProvenance(context.Background(), tr, fmt.Sprintf("d%d.example", i), options, nil)
+		require.NoError(t, err)
+	}
+	require.LessOrEqual(t, c.proofCache().Len(), 256)
+	c.ClearCache()
+	original := tr.respond
+	tr.respond = func(m *mdns.Msg) (*mdns.Msg, error) {
+		r, err := original(m)
+		for range 20 {
+			r.Extra = append(r.Extra, &mdns.TXT{Hdr: mdns.RR_Header{Name: m.Question[0].Name, Rrtype: mdns.TypeTXT, Class: mdns.ClassINET, Ttl: 60}, Txt: []string{strings.Repeat("x", 250)}})
+		}
+		return r, err
+	}
+	for range 2 {
+		_, err := c.LookupWithProvenance(context.Background(), tr, "large.example", options, nil)
+		require.NoError(t, err)
+	}
+	require.Zero(t, c.proofCache().Len())
+	require.Equal(t, int32(272), tr.queryCount.Load())
+}
+func TestProvenanceCombinedAddressBound(t *testing.T) {
+	tr := proofTransport()
+	tr.respond = func(m *mdns.Msg) (*mdns.Msg, error) {
+		addresses := make([]netip.Addr, 33)
+		for i := range addresses {
+			if m.Question[0].Qtype == mdns.TypeA {
+				addresses[i] = netip.AddrFrom4([4]byte{192, 0, 2, byte(i + 1)})
+			} else {
+				addresses[i] = netip.AddrFrom16([16]byte{0x20, 1, 0xd, 0xb8, 15: byte(i + 1)})
+			}
+		}
+		return FixedResponse(m.Id, m.Question[0], addresses, 60), nil
+	}
+	c := NewClient(ClientOptions{Context: context.Background()})
+	result, err := c.LookupWithProvenance(context.Background(), tr, "lease.example", adapter.DNSQueryOptions{}, nil)
+	require.ErrorIs(t, err, ErrProvenanceUnavailable)
+	require.Empty(t, result.Families)
+}
+func TestProvenancePredefinedRefusal(t *testing.T) {
+	for _, legacy := range []bool{false, true} {
+		t.Run(fmt.Sprint(legacy), func(t *testing.T) {
+			router := strictCompleteRouter(proofTransport())
+			router.legacyDNSMode = legacy
+			router.rules = raceTestRules(t, []option.DNSRule{{DefaultOptions: option.DefaultDNSRule{DNSRuleAction: option.DNSRuleAction{Action: C.RuleActionTypePredefined}}}})
+			result, err := router.LookupWithProvenance(context.Background(), "lease.example", adapter.DNSQueryOptions{})
+			require.ErrorIs(t, err, ErrProvenanceUnavailable)

diff --git a/dns/provenance.go b/dns/provenance.go
new file mode 100644
index 0000000..57d2c25
--- /dev/null
+++ b/dns/provenance.go
@@ -0,0 +1,308 @@
+package dns
+
+import (
+	"context"
+	"fmt"
+	"net/netip"
+	"strings"
+	"time"
+
+	"github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing/common"
+	"github.com/sagernet/sing/contrab/freelru"
+	"github.com/sagernet/sing/contrab/maphash"
+)
+
+var ErrProvenanceUnavailable = fmt.Errorf("DNS response provenance unavailable")
+
+func cloneProof(proof *adapter.DNSResponseProof) *adapter.DNSResponseProof {
+	if proof == nil {
+		return nil
+	}
+	copy := *proof
+	copy.Addresses = append([]netip.Addr(nil), proof.Addresses...)
+	return &copy
+}
+func (c *Client) proofNow() time.Time {
+	if c.provenanceNow != nil {
+		return c.provenanceNow()
+	}
+	return time.Now()
+}
+
+type provenanceCacheEntry struct {
+	response *dns.Msg
+	proof    *adapter.DNSResponseProof
+}
+
+func (c *Client) proofCache() *freelru.Cache[dnsCacheKey, *provenanceCacheEntry] {
+	if cache := c.provenanceCache.Load(); cache != nil {
+		return cache
+	}
+	cache := common.Must1(freelru.New[dnsCacheKey, *provenanceCacheEntry](256, maphash.NewHasher[dnsCacheKey]().Hash32, true))
+	if c.provenanceCache.CompareAndSwap(nil, cache) {
+		return cache
+	}
+	return c.provenanceCache.Load()
+}
+func (c *Client) loadProvenance(key dnsCacheKey) (*dns.Msg, *adapter.DNSResponseProof) {
+	entry, ok := c.proofCache().Get(key)
+	if !ok {
+		return nil, nil
+	}
+	now := c.proofNow()
+	if !now.Before(entry.proof.Deadline) {
+		c.proofCache().Remove(key)
+		return nil, nil
+	}
+	response := entry.response.Copy()
+	normalizeTTL(response, uint32(entry.proof.Deadline.Sub(now)/time.Second))
+	return response, cloneProof(entry.proof)
+}
+func (c *Client) storeProvenance(key dnsCacheKey, response *dns.Msg, proof *adapter.DNSResponseProof) {
+	// Ограничиваем и число записей, и размер сохранённых DNS сообщений.
+	if proof == nil || response.Len() > 4096 {
+		return
+	}
+	c.proofCache().Add(key, &provenanceCacheEntry{response.Copy(), cloneProof(proof)})
+}
+
+func canonicalDNSName(name string) string { return strings.ToLower(dns.Fqdn(name)) }
+
+func (c *Client) responseProof(transport adapter.DNSTransport, question dns.Question, response *dns.Msg, options adapter.DNSQueryOptions) (*adapter.DNSResponseProof, error) {
+	fail := func(reason string) (*adapter.DNSResponseProof, error) {
+		return nil, fmt.Errorf("%w: %s", ErrProvenanceUnavailable, reason)
+	}
+	switch transport.Type() {
+	case C.DNSTypeUDP, C.DNSTypeTCP, C.DNSTypeTLS, C.DNSTypeHTTPS, C.DNSTypeQUIC, C.DNSTypeHTTP3:
+	default:
+		return fail("transport has no static wire origin")
+	}
+	if transport.Tag() == "" || options.RewriteTTL != nil {
+		return fail("missing transport identity or rewritten TTL")
+	}
+	if response == nil || !response.Response || response.Opcode != dns.OpcodeQuery || response.Zero || response.Truncated || response.Rcode != dns.RcodeSuccess || len(response.Question) != 1 || question.Qclass != dns.ClassINET || (question.Qtype != dns.TypeA && question.Qtype != dns.TypeAAAA) {
+		return fail("not a complete address response")
+	}
+	q := response.Question[0]
+	if canonicalDNSName(q.Name) != canonicalDNSName(question.Name) || q.Qtype != question.Qtype || q.Qclass != question.Qclass {
+		return fail("response question mismatch")
+	}
+	if _, valid := dns.IsDomainName(question.Name); !valid {
+		return fail("invalid question name")
+	}
+	name := canonicalDNSName(question.Name)
+	minimum := uint32(^uint32(0))
+	hasTTL := false
+	includeTTL := func(ttl uint32) { minimum = min(minimum, ttl); hasTTL = true }
+	owners := make(map[string][]dns.RR)
+	for _, rr := range response.Answer {
+		// DNAME на ancestor влияет на синтезированный CNAME и его срок.
+		if _, unsupported := rr.(*dns.DNAME); unsupported {
+			return fail("DNAME unsupported")
+		}
+		owners[canonicalDNSName(rr.Header().Name)] = append(owners[canonicalDNSName(rr.Header().Name)], rr)
+	}
+	visited := make(map[string]bool)
+	var addresses []netip.Addr
+	for {
+		if visited[name] {
+			return fail("CNAME cycle")
+		}
+		visited[name] = true
+		var target string
+		var familyRecords int
+		seen := make(map[netip.Addr]bool)
+		for _, rr := range owners[name] {
+			if rr.Header().Class != dns.ClassINET {
+				return fail("invalid answer class")
+			}
+			switch value := rr.(type) {
+			case *dns.CNAME:
+				next := canonicalDNSName(value.Target)
+				if _, valid := dns.IsDomainName(value.Target); !valid {
+					return fail("invalid CNAME target")
+				}
+				if target != "" && target != next {
+					return fail("conflicting CNAME targets")
+				}
+				target = next
+				includeTTL(value.Hdr.Ttl)
+			case *dns.A:
+				familyRecords++
+				if question.Qtype == dns.TypeA {
+					address, ok := netip.AddrFromSlice(value.A)
+					if !ok || !address.Unmap().Is4() {
+						return fail("invalid A address")
+					}
+					address = address.Unmap()
+					includeTTL(value.Hdr.Ttl)
+					if !seen[address] {
+						addresses = append(addresses, address)
+						seen[address] = true
+					}
+				}
+			case *dns.AAAA:
+				familyRecords++
+				if question.Qtype == dns.TypeAAAA {
+					address, ok := netip.AddrFromSlice(value.AAAA)
+					if !ok || !address.Is6() || address.Is4In6() {
+						return fail("invalid AAAA address")
+					}
+					includeTTL(value.Hdr.Ttl)
+					if !seen[address] {
+						addresses = append(addresses, address)
+						seen[address] = true
+					}
+				}
+			}
+		}
+		if target == "" {
+			break
+		}
+		if familyRecords > 0 {
+			return fail("CNAME conflicts with address data")
+		}
+		name = target
+	}
+	if len(addresses) > 64 {
+		return fail("too many addresses")
+	}
+	noData := len(addresses) == 0
+	if noData {
+		soaFound := false
+		for _, rr := range response.Ns {
+			soa, ok := rr.(*dns.SOA)
+			if !ok || soa.Hdr.Class != dns.ClassINET || !dns.IsSubDomain(canonicalDNSName(soa.Hdr.Name), name) {
+				continue
+			}
+			includeTTL(min(soa.Hdr.Ttl, soa.Minttl))
+			soaFound = true
+		}
+		if !soaFound {
+			return fail("NODATA has no covering SOA")
+		}
+	}
+	if minimum == 0 || !hasTTL {
+		return fail("no positive original TTL")
+	}
+	return &adapter.DNSResponseProof{QuestionName: strings.TrimSuffix(canonicalDNSName(question.Name), "."), CanonicalName: strings.TrimSuffix(name, "."), Addresses: addresses, QueryType: question.Qtype, NoData: noData, Deadline: c.proofNow().Add(time.Duration(minimum) * time.Second), TransportTag: transport.Tag(), TransportType: transport.Type(), NativeEnvironmentHash: c.environmentHash(transport)}, nil
+}
+
+func familySlot(strategy C.DomainStrategy, qType uint16) int {
+	if qType == dns.TypeAAAA && strategy != C.DomainStrategyIPv6Only {
+		return 1
+	}
+	return 0
+}
+func prepareLookupResult(options adapter.DNSQueryOptions) adapter.DNSLookupResult {
+	strategy := options.Strategy
+	if options.LookupStrategy != C.DomainStrategyAsIS {
+		strategy = options.LookupStrategy
+	}
+	count := 2
+	if strategy == C.DomainStrategyIPv4Only || strategy == C.DomainStrategyIPv6Only {
+		count = 1
+	}
+	return adapter.DNSLookupResult{Families: make([]adapter.DNSResponseProof, count)}
+}
+func finishLookupResult(result adapter.DNSLookupResult, addresses []netip.Addr, err error, domain string) (adapter.DNSLookupResult, error) {
+	if err != nil {
+		return adapter.DNSLookupResult{}, err
+	}
+	if len(addresses) > 64 {
+		return adapter.DNSLookupResult{}, fmt.Errorf("%w: too many combined addresses", ErrProvenanceUnavailable)
+	}
+	for _, proof := range result.Families {
+		if proof.Deadline.IsZero() || canonicalDNSName(proof.QuestionName) != canonicalDNSName(domain) {
+			return adapter.DNSLookupResult{}, ErrProvenanceUnavailable
+		}
+	}
+	result.Addresses = append([]netip.Addr(nil), addresses...)
+	return result, nil
+}
+func (c *Client) LookupWithProvenance(ctx context.Context, transport adapter.DNSTransport, domain string, options adapter.DNSQueryOptions, checker func(*dns.Msg) bool) (adapter.DNSLookupResult, error) {
+	options.RequireProvenance = true
+	options.StrictComplete = true
+	options.DisableOptimisticCache = true
+	result := prepareLookupResult(options)
+	addresses, err := c.lookup(ctx, transport, domain, options, checker, &result)
+	return finishLookupResult(result, addresses, err, domain)
+}
+func (c *Client) ExchangeWithProvenance(ctx context.Context, transport adapter.DNSTransport, message *dns.Msg, options adapter.DNSQueryOptions, checker func(*dns.Msg) bool) (*dns.Msg, *adapter.DNSResponseProof, error) {
+	options.RequireProvenance = true
+	options.DisableOptimisticCache = true
+	return c.exchangeWithProvenance(ctx, transport, message, options, checker)
+}
+func (c *Client) ExchangeWithProvenanceAsync(ctx context.Context, transport adapter.DNSTransport, message *dns.Msg, options adapter.DNSQueryOptions, checker func(*dns.Msg) bool, callback func(*dns.Msg, *adapter.DNSResponseProof, error)) {
+	options.RequireProvenance = true
+	options.DisableOptimisticCache = true
+	c.exchangeWithProvenanceAsync(ctx, transport, message, options, checker, callback)
+}
+func (c *Client) lookupFamily(ctx context.Context, transport adapter.DNSTransport, name string, qType uint16, options adapter.DNSQueryOptions, checker func(*dns.Msg) bool, result *adapter.DNSLookupResult, slot int) ([]netip.Addr, error) {
+	if result == nil {
+		return c.lookupToExchange(ctx, transport, name, qType, options, checker)
+	}
+	message := &dns.Msg{MsgHdr: dns.MsgHdr{RecursionDesired: true}, Question: []dns.Question{{Name: name, Qtype: qType, Qclass: dns.ClassINET}}}
+	_, proof, err := c.ExchangeWithProvenance(ctx, transport, message, options, checker)
+	if err != nil {
+		return nil, err
+	}
+	if proof == nil {
+		return nil, ErrProvenanceUnavailable
+	}
+	result.Families[slot] = *proof
+	return append([]netip.Addr(nil), proof.Addresses...), nil
+}
+
+func (r *Router) clientExchange(ctx context.Context, transport adapter.DNSTransport, message *dns.Msg, options adapter.DNSQueryOptions, checker func(*dns.Msg) bool) (*dns.Msg, *adapter.DNSResponseProof, error) {
+	if options.RequireProvenance {
+		client, ok := r.client.(adapter.DNSClientWithProvenance)
+		if !ok {
+			return nil, nil, ErrProvenanceUnavailable
+		}
+		return client.ExchangeWithProvenance(ctx, transport, message, options, checker)
+	}
+	response, err := r.client.Exchange(ctx, transport, message, options, checker)
+	return response, nil, err
+}
+func (r *Router) clientExchangeAsync(ctx context.Context, transport adapter.DNSTransport, message *dns.Msg, options adapter.DNSQueryOptions, checker func(*dns.Msg) bool, callback func(*dns.Msg, *adapter.DNSResponseProof, error)) {
+	if options.RequireProvenance {
+		client, ok := r.client.(adapter.DNSClientWithProvenance)
+		if !ok {
+			callback(nil, nil, ErrProvenanceUnavailable)
+			return
+		}
+		client.ExchangeWithProvenanceAsync(ctx, transport, message, options, checker, callback)
+		return
+	}
+	r.client.ExchangeAsync(ctx, transport, message, options, checker, func(response *dns.Msg, err error) { callback(response, nil, err) })
+}
+func (r *Router) clientLookup(ctx context.Context, transport adapter.DNSTransport, domain string, options adapter.DNSQueryOptions, checker func(*dns.Msg) bool, result *adapter.DNSLookupResult) ([]netip.Addr, error) {
+	if result == nil {
+		return r.client.Lookup(ctx, transport, domain, options, checker)
+	}
+	client, ok := r.client.(adapter.DNSClientWithProvenance)
+	if !ok {
+		return nil, ErrProvenanceUnavailable
+	}
+	candidate, err := client.LookupWithProvenance(ctx, transport, domain, options, checker)
+	if err != nil {
+		return nil, err
+	}
+	*result = candidate
+	return candidate.Addresses, nil
+}
+func (r *Router) LookupWithProvenance(ctx context.Context, domain string, options adapter.DNSQueryOptions) (adapter.DNSLookupResult, error) {
+	options.RequireProvenance = true
+	options.StrictComplete = true
+	options.DisableOptimisticCache = true
+	if options.Strategy == C.DomainStrategyAsIS {
+		options.Strategy = r.defaultDomainStrategy
+	}
+	result := prepareLookupResult(options)
+	addresses, err := r.lookup(ctx, domain, options, &result)
+	return finishLookupResult(result, addresses, err, domain)
+}

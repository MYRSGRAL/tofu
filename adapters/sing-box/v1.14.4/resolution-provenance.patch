+func TestProvenanceAsyncSelection(t *testing.T) {
+	for _, path := range []string{"respond", "race", "terminal"} {
+		t.Run(path, func(t *testing.T) {
+			started := make(chan struct{}, 4)
+			gate := make(chan struct{})
+			discardedGate := make(chan struct{})
+			chosen := proofTransport()
+			chosen.tag = "final"
+			chosen.gate = gate
+			chosen.started = started
+			other := proofTransport()
+			other.tag = "other"
+			other.gate = discardedGate
+			other.started = started
+			router := strictCompleteRouter(chosen)
+			router.transport.(*fakeDNSTransportManager).transports["other"] = other
+			rules := []option.DNSRule{evaluateRule("other", "discarded", true), evaluateRule("final", "selected", false), respondRule("selected", path == "race", true)}
+			count := 4
+			if path == "terminal" {
+				miss := respondRule("discarded", true, false)
+				failure := option.DNSRCode(mdns.RcodeNameError)
+				miss.DefaultOptions.ResponseRcode = &failure
+				rules = []option.DNSRule{evaluateRule("other", "discarded", false), miss, routeRule("final", true)}
+			}
+			router.rules = raceTestRules(t, rules)
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			type outcome struct {
+				result adapter.DNSLookupResult
+				err    error
+			}
+			done := make(chan outcome, 1)
+			go func() {
+				result, err := router.LookupWithProvenance(ctx, "lease.example", adapter.DNSQueryOptions{})
+				done <- outcome{result, err}
+			}()
+			for range count {
+				select {
+				case <-started:
+				case <-ctx.Done():
+					t.Fatal("queries did not launch")
+				}
+			}
+			close(gate)
+			if path == "terminal" {
+				close(discardedGate)
+			}
+			select {
+			case got := <-done:
+				require.NoError(t, got.err)
+				require.Len(t, got.result.Families, 2)
+				for _, proof := range got.result.Families {
+					require.Equal(t, "final", proof.TransportTag)
+				}
+			case <-ctx.Done():
+				t.Fatal("selected future did not finish")
+			}
+		})
+	}
+}

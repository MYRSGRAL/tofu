# Снимок исходников; обновлять revision и checksum совместно после проверки.
pkgname=yonik
pkgver=0.1.0.r20261110
pkgrel=2
pkgdesc='Qt-клиент yonik и системный сетевой помощник'
arch=('x86_64')
url='https://github.com/MYRSGRAL/yonik'
license=('GPL-3.0-only')
depends=('ca-certificates' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'sqlite' 'dbus' 'polkit' 'systemd' 'nftables' 'iproute2' 'gcc-libs' 'glibc')
makedepends=('rust' 'clang' 'pkgconf')
optdepends=('qt6-wayland: запуск в Wayland' 'gnome-keyring: провайдер Secret Service')
options=('!debug')
_revision=eec7a56b6b03f2b022a87682f9097ce78b61fa0b
source=("yonik-${_revision}.tar.gz::https://codeload.github.com/MYRSGRAL/yonik/tar.gz/${_revision}")
sha256sums=('71e9c347ffc363da062b42b0c5ffc6ccb0a97b0988202ce21391dd1c2553a1d3')

build() {
    cd "$srcdir/yonik-$_revision"
    # Target задаёт runner, удерживающий flock корня transient-каталога.
    : "${CARGO_TARGET_DIR:?Укажите внешний transient target под flock}"
    export CARGO_BUILD_JOBS=1
    export YONIK_BUILD_ID="0.1.0+$_revision"
    # GNU ld читает rlib раньше forced initializer archives CXX-Qt 0.10.
    # Явные undefined symbols включают нужные initializer objects из rlib.
    cargo rustc --locked --release -p yonik-desktop --features gui --bin yonik-desktop -- \
        -C link-arg=-Wl,--undefined=cxx_qt_init_qml_module_cloud_highpriority_yonik \
        -C link-arg=-Wl,--undefined=cxx_qt_init_crate_yonik_desktop \
        -C link-arg=-Wl,--undefined=cxx_qt_init_crate_cxx_qt_lib \
        -C link-arg=-Wl,--undefined=cxx_qt_init_crate_cxx_qt
    cargo build --locked --release -p yonik-linux --bin yonik-helper --bin yonik-worker
}

package() {
    cd "$srcdir/yonik-$_revision"
    python3 tools/compile_notices.py "$srcdir/yonik-notices"
    install -dm755 "$pkgdir/usr/share/licenses/yonik"
    while IFS= read -r notice; do
        install -m644 "$srcdir/yonik-notices/$notice" "$pkgdir/usr/share/licenses/yonik/"
    done < "$srcdir/yonik-notices/payload.list"
    install -Dm755 "$CARGO_TARGET_DIR/release/yonik-desktop" "$pkgdir/usr/bin/yonik-desktop"
    install -Dm755 "$CARGO_TARGET_DIR/release/yonik-helper" "$pkgdir/usr/lib/yonik/yonik-helper"
    install -Dm755 "$CARGO_TARGET_DIR/release/yonik-worker" "$pkgdir/usr/lib/yonik/yonik-worker"
    install -Dm644 packaging/systemd/* -t "$pkgdir/usr/lib/systemd/system/"
    install -Dm644 packaging/sysusers/* -t "$pkgdir/usr/lib/sysusers.d/"
    install -Dm644 packaging/dbus/*.conf -t "$pkgdir/usr/share/dbus-1/system.d/"
    install -Dm644 packaging/dbus/*.service -t "$pkgdir/usr/share/dbus-1/system-services/"
    install -Dm644 packaging/polkit/* -t "$pkgdir/usr/share/polkit-1/actions/"
    install -Dm644 crates/yonik-desktop/assets/yonik.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/cloud.highpriority.yonik.svg"
    install -dm755 "$pkgdir/usr/share/applications"
    cat > "$pkgdir/usr/share/applications/cloud.highpriority.yonik.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=yonik
Comment=Управление прокси-подключениями
Exec=/usr/bin/yonik-desktop
Icon=cloud.highpriority.yonik
Terminal=false
Categories=Network;
DESKTOP
}

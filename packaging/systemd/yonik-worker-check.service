[Unit]
Description=Yonik — проверка сетевого ядра
BindsTo=yonik-helper.service
After=yonik-helper.service

[Service]
Type=exec
User=yonik-worker
Group=yonik-worker
ExecStart=/usr/lib/yonik/yonik-worker --check
StandardInput=socket
StandardOutput=null
StandardError=null
Sockets=yonik-worker-check.socket
Slice=system.slice
Restart=no
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
FinalKillSignal=SIGKILL
TimeoutStartSec=10s
TimeoutStopSec=5s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
MemoryMax=256M
TasksMax=64
LimitCORE=0

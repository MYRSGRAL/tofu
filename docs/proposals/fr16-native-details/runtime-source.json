        "lines": [
          "func (f Formatter) writePrefix(builder *strings.Builder, level Level, timestamp time.Time) {",
          "\tvar levelString string",
          "\tif int(level) >= len(levelLabels) {",
          "\t\tlevelString = \"UNKNOWN\"",
          "\t} else if f.DisableColors {",
          "\t\tlevelString = levelLabels[level]",
          "\t} else {",
          "\t\tlevelString = coloredLevelLabels[level]",
          "\t}",
          "\tswitch {",
          "\tcase f.DisableTimestamp:",
          "\t\tbuilder.WriteString(levelString)",
          "\t\tbuilder.WriteByte(' ')",
          "\tcase f.FullTimestamp:",
          "\t\tvar timeBuffer [64]byte",
          "\t\tbuilder.Write(timestamp.AppendFormat(timeBuffer[:0], f.TimestampFormat))",
          "\t\tbuilder.WriteByte(' ')",
          "\t\tbuilder.WriteString(levelString)",
          "\t\tbuilder.WriteByte(' ')",
          "\tdefault:",
          "\t\tbuilder.WriteString(levelString)",
          "\t\tbuilder.WriteByte('[')",
          "\t\tseconds := strconv.AppendInt(make([]byte, 0, 20), int64(timestamp.Sub(f.BaseTime)/time.Second), 10)",
          "\t\tfor pad := 4 - len(seconds); pad > 0; pad-- {",
          "\t\t\tbuilder.WriteByte('0')",
          "\t\t}",
          "\t\tbuilder.Write(seconds)",
          "\t\tbuilder.WriteString(\"] \")",
          "\t}"
        ]
      }
    ]
  },

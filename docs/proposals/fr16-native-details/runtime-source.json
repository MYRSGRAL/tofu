          "func doLog(ctx context.Context, inner error, severity log.Severity, msg ...interface{}) {",
          "\tif log.GetSeverity() < severity {",
          "\t\treturn",
          "\t}",
          "\tpc, _, _, _ := runtime.Caller(2)",
          "\tdetails := runtime.FuncForPC(pc).Name()",
          "\tif len(details) >= trim {",
          "\t\tdetails = details[trim:]",
          "\t}",
          "\ti := strings.Index(details, \".\")",
          "\tif i > 0 {",
          "\t\tdetails = details[:i]",
          "\t}",
          "\terr := &Error{",
          "\t\tmessage: msg,",
          "\t\tcaller:  details,",
          "\t\tinner:   inner,",
          "\t}",
          "\tif ctx != nil && ctx != context.Background() {",
          "\t\tid := uint32(c.IDFromContext(ctx))",
          "\t\tif id > 0 {",
          "\t\t\terr.prefix = append(err.prefix, id)",
          "\t\t}",
          "\t}",
          "\tlog.Record(&log.GeneralMessage{",
          "\t\tSeverity: severity,",
          "\t\tContent:  err,",
          "\t})"
        ]
      }
    ]
  },

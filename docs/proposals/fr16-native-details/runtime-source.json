          "\t\treturn NewNOPFactory(), nil",
          "\t}",
          "",
          "\tvar logWriter io.Writer",
          "\tvar logFilePath string",
          "",
          "\tswitch logOptions.Output {",
          "\tcase \"\":",
          "\t\tlogWriter = options.DefaultWriter",
          "\t\tif logWriter == nil {",
          "\t\t\tlogWriter = os.Stderr",
          "\t\t}",

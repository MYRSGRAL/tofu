import { Palette, ComboBox, Button, CheckBox, LineEdit, ListView, HorizontalBox, VerticalBox } from "std-widgets.slint";

export struct BenchRow {
    id: int,
    name: string,
    host: string,
    country: string,
    latency: string,
    favorite: bool,
}

export component AppWindow inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; }
    width: 800px;
    height: 640px;
    title: "Yonik · Slint benchmark";
    background: #191919;
    default-font-family: "Noto Sans";
    default-font-size: 14px;
    in property <[BenchRow]> rows;
    in property <int> selected-id: -1;
    in property <int> total;
    in property <int> offset;
    in property <bool> favorites-only;
    in property <bool> sort-name;
    in-out property <string> search;
    in-out property <length> scroll-y <=> list.content-y;
    public function scroll-to-index(index: int) {
        root.scroll-y = max(min(0px, list.visible-height - list.content-height), -index * 66px);
    }
    callback row-created();
    callback query(string, bool, bool, int);
    callback select-row(int);
    callback favorite-row(int, bool);

    VerticalBox {
        padding: 20px;
        spacing: 12px;
        HorizontalBox {
            padding: 0px;
            spacing: 12px;
            height: 38px;
            Text { text: "YONIK"; color: #c3a6ef; font-weight: 700; vertical-alignment: center; horizontal-stretch: 0; }
            Text { text: "Серверы"; color: #eee; vertical-alignment: center; }
            Text { text: "Slint · " + root.total; color: #b2b2b2; horizontal-alignment: right; vertical-alignment: center; }
        }
        HorizontalBox {
            padding: 0px;
            spacing: 12px;
            height: 40px;
            search-input := LineEdit {
                text <=> root.search;
                placeholder-text: "Поиск сервера";
                accepted => { root.query(root.search, root.favorites-only, root.sort-name, 0); }
            }
            Button {
                text: "Найти";
                horizontal-stretch: 0;
                clicked => { root.query(root.search, root.favorites-only, root.sort-name, 0); }
            }
            ComboBox {
                horizontal-stretch: 0;
                model: ["По порядку", "По имени"];
                current-index: root.sort-name ? 1 : 0;
                selected(value) => { root.query(root.search, root.favorites-only, self.current-index == 1, 0); }
            }
        }
        HorizontalBox {
            padding: 0px;
            spacing: 12px;
            height: 40px;
            CheckBox {
                text: "Избранные";
                checked: root.favorites-only;
                toggled => { root.query(root.search, self.checked, root.sort-name, 0); }
            }
            Text {
                text: "Выбран: " + (root.selected-id < 0 ? "—" : "" + root.selected-id);
                color: #b2b2b2;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        list := ListView {
            height: 320px;
            for row in root.rows: Rectangle {
                init => { root.row-created(); }
                height: 66px;
                background: row.id == root.selected-id ? #332b40 : #191919;
                Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: #303030; }
                TouchArea { clicked => { root.select-row(row.id); } }
                HorizontalBox {
                    padding: 0px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 14px;
                    Text { width: 30px; text: row.country; color: #c3a6ef; vertical-alignment: center; }
                    VerticalBox {
                        padding: 0px;
                        spacing: 3px;
                        alignment: center;
                        Text { text: row.name; color: #eee; overflow: elide; vertical-stretch: 0; }
                        Text { text: row.host; color: #9c9c9c; overflow: elide; vertical-stretch: 0; }
                    }
                    Text { text: row.latency; color: #c3a6ef; vertical-alignment: center; horizontal-stretch: 0; }
                    Button {
                        width: 44px;
                        text: row.favorite ? "★" : "☆";
                        clicked => { root.favorite-row(row.id, !row.favorite); }
                    }
                }
            }
        }
        HorizontalBox {
            padding: 0px;
            spacing: 12px;
            height: 40px;
            Button {
                text: "Назад";
                horizontal-stretch: 0;
                enabled: root.offset > 0;
                clicked => { root.query(root.search, root.favorites-only, root.sort-name, max(0, root.offset - 200)); }
            }
            Text {
                text: root.offset + " / " + root.total;
                color: #b2b2b2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Button {
                text: "Далее";
                horizontal-stretch: 0;
                enabled: root.offset + 200 < root.total;
                clicked => { root.query(root.search, root.favorites-only, root.sort-name, root.offset + 200); }
            }
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}

use rustix::{
    fs::{FileType, OFlags, fcntl_getfl, fstat, fstatfs},
    io::{FdFlags, fcntl_getfd},
};
use std::{io, os::fd::OwnedFd, process::Command};
use tokio::net::unix::pipe::{Receiver, pipe};

struct OutputReaders {
    stdout: Receiver,
    stderr: Receiver,
}

struct OutputWriters {
    roles: Vec<OwnedFd>,
}

struct ValidatedWriters {
    stdout: OwnedFd,
    stderr: OwnedFd,
}

fn create() -> io::Result<(OutputReaders, OutputWriters)> {
    let (stdout, stdout_reader) = pipe()?;
    let (stderr, stderr_reader) = pipe()?;
    Ok((
        OutputReaders {
            stdout: stdout_reader,
            stderr: stderr_reader,
        },
        OutputWriters {
            roles: vec![stdout.into_blocking_fd()?, stderr.into_blocking_fd()?],
        },
    ))
}

impl OutputWriters {
    fn validate(self) -> io::Result<ValidatedWriters> {
        let invalid = || {
            io::Error::new(
                io::ErrorKind::InvalidInput,
                "ожидались два разных blocking CLOEXEC FIFO writer",
            )
        };
        let [stdout, stderr]: [OwnedFd; 2] = self.roles.try_into().map_err(|_| invalid())?;
        let identity = |fd: &OwnedFd| -> io::Result<_> {
            let stat = fstat(fd)?;
            let flags = fcntl_getfl(fd)?;
            // PIPEFS_MAGIC фиксирован ABI Linux; обычный named FIFO не является pipe.
            if fstatfs(fd)?.f_type as u64 != 0x5049_5045
                || FileType::from_raw_mode(stat.st_mode) != FileType::Fifo
                || flags & OFlags::ACCMODE != OFlags::WRONLY
                || flags.contains(OFlags::NONBLOCK)
                || !fcntl_getfd(fd)?.contains(FdFlags::CLOEXEC)
            {
                return Err(invalid());
            }
            Ok((stat.st_dev, stat.st_ino))
        };
        if identity(&stdout)? == identity(&stderr)? {
            return Err(invalid());
        }
        Ok(ValidatedWriters { stdout, stderr })
    }
}

impl ValidatedWriters {
    // Метод приватен даже внутри test-only модуля: не capability общего executor.
    fn attach(self, command: &mut Command) {
        command.stdout(self.stdout).stderr(self.stderr);
    }
}

mod compatibility {
use super::*;
use crate::event_log::{EventCode, EventLog, EventSource};
use crate::worker::{Header, WorkerError, WorkerMode, decode_bundle_header};

const MAGIC: &[u8; 8] = b"YNKWRK\0\x03";

// Возвращаем порядок FD только как fixture, без импорта внешних дескрипторов.
fn decode(bytes: &[u8]) -> Result<Vec<&'static str>, WorkerError> {
    if bytes.len() < 112 || bytes.get(..8) != Some(MAGIC) {
        return Err(WorkerError::Protocol);
    }
    let count = usize::from(bytes[10]);
    if count > 16
        || bytes.len() != 112 + 54 * count
        || bytes[96..100] != [0, 2, 1, 2]
        || bytes[100..112] != [0; 12]
    {
        return Err(WorkerError::Protocol);
    }
    let mut legacy = bytes[..96].to_vec();
    if count == 0 {
        if legacy[80..96] != [0; 16] {
            return Err(WorkerError::Protocol);
        }
        legacy.truncate(80);
        legacy[7] = 1;
    } else {
        legacy[7] = 2;
        legacy.extend_from_slice(&bytes[112..]);
    }
    let (header, _, _) = decode_bundle_header(&legacy)?;
    if header.mode != WorkerMode::Run {
        return Err(WorkerError::Protocol);
    }
    let mut order = vec!["binary", "config"];
    order.extend(std::iter::repeat_n("resource", count));
    order.extend(["stdout", "stderr"]);
    Ok(order)
}

fn fixture(count: u8) -> Vec<u8> {
    let header = Header {
        mode: WorkerMode::Run,
        engine: yonik_engine::Engine::Xray,
        length: 0x010203,
        binary_hash: [0x34; 32],
        config_hash: [0x56; 32],
    };
    let mut bytes = header.encode().to_vec();
    bytes.resize(112, 0);
    bytes[..8].copy_from_slice(MAGIC);
    bytes[10] = count;
    bytes[96..100].copy_from_slice(&[0, 2, 1, 2]);
    if count > 0 {
        bytes[80..88].copy_from_slice(&1u64.to_be_bytes());
        bytes[88..96].copy_from_slice(&2u64.to_be_bytes());
    }
    for n in 0..count {
        crate::worker::encode_resource(
            &mut bytes,
            &yonik_engine::resource_bundle::ExternalRef {
                engine: yonik_engine::Engine::Xray,
                kind: yonik_engine::resource_bundle::ResourceKind::Domains,
                format_version: 1,
                bytes: 1,
                records: 1,
                digest: [n; 32],
            },
        );
    }
    bytes
}

// Поля недоступны потребителю: обе пары и scoped EventLog создаются вместе.
mod binding {
    use super::*;
    pub(super) struct FixtureHandle;
    pub(super) struct PreparedOutput {
        readers: OutputReaders,
        writers: ValidatedWriters,
        handle: FixtureHandle,
        log: EventLog,
    }
    pub(super) struct ConsumedOutput {
        pub(super) readers: OutputReaders,
        writers: Option<ValidatedWriters>,
        _handle: FixtureHandle,
        log: EventLog,
    }
    impl PreparedOutput {
        pub(super) fn create(log: &EventLog, generation: u64) -> io::Result<Self> {
            let (readers, writers) = super::super::create()?;
            Ok(Self {
                readers,
                writers: writers.validate()?,
                handle: FixtureHandle,
                log: log
                    .session_scope()
                    .ok_or_else(|| io::Error::other("исчерпан session id"))?
                    .with_generation(generation),
            })
        }
        pub(super) fn consume(self) -> ConsumedOutput {
            ConsumedOutput {
                readers: self.readers,
                writers: Some(self.writers),
                _handle: self.handle,
                log: self.log,
            }
        }
    }
    impl ConsumedOutput {
        pub(super) fn write_late(&self) -> io::Result<()> {
            let writers = self
                .writers
                .as_ref()
                .ok_or_else(|| io::Error::other("уже закрыто"))?;
            rustix::io::write(&writers.stdout, b"late")?;
            Ok(())
        }
        pub(super) fn close(&mut self) {
            drop(self.writers.take());
        }
        pub(super) fn observed(&self, eof: bool) {
            self.log.record(
                EventSource::Engine,
                if eof {
                    EventCode::ProcessExited
                } else {
                    EventCode::ProcessSpawned
                },
                None,
            );
        }
    }
}

pub(super) fn codec_bounds_roles_scope_and_legacy_rejection() {
    for count in [0, 1, 16] {
        let bytes = fixture(count);
        let order = decode(&bytes).expect("валидная fixture");
        assert_eq!(order.len(), 4 + usize::from(count));
        assert_eq!(&order[order.len() - 2..], &["stdout", "stderr"]);
        assert!(decode_bundle_header(&bytes).is_err()); // Никакого downgrade.
        for end in 0..bytes.len() {
            assert!(decode(&bytes[..end]).is_err(), "truncation {end}");
        }
        let mut trailing = bytes.clone();
        trailing.push(0);
        assert!(decode(&trailing).is_err());
        for index in [7, 8, 11, 96, 97, 98, 99, 100, 111] {
            let mut bad = bytes.clone();
            bad[index] ^= 0xff;
            assert!(decode(&bad).is_err(), "offset {index}");
        }
    }
    for count in [17, 255] {
        assert!(decode(&fixture(count)).is_err());
    }
    let mut check = fixture(0);
    check[8] = 1;
    assert!(decode(&check).is_err());
    let mut scope = fixture(0);
    scope[80] = 1;
    assert!(decode(&scope).is_err());
    for start in [80, 88] {
        let mut bad = fixture(1);
        bad[start..start + 8].fill(0);
        assert!(decode(&bad).is_err());
    }
    let mut endian = fixture(0);
    endian[12..16].reverse();
    assert!(decode(&endian).is_err());
}

pub(super) fn resource_validation_reuses_v2() {
    for (start, end) in [(112, 113), (113, 114), (114, 118), (118, 126), (126, 134)] {
        let mut bad = fixture(1);
        bad[start..end].fill(0);
        assert!(decode(&bad).is_err());
    }
    let mut duplicate = fixture(2);
    let record = duplicate[112..166].to_vec();
    duplicate[166..220].copy_from_slice(&record);
    assert!(decode(&duplicate).is_err());
    let mut mismatch = fixture(1);
    mismatch[112] = 2;
    mismatch[114..118].copy_from_slice(&3u32.to_be_bytes());
    assert!(decode(&mismatch).is_err());
    let mut limit = fixture(2);
    for start in [126, 180] {
        limit[start..start + 8].copy_from_slice(&1_000_000u64.to_be_bytes());
    }
    assert!(decode(&limit).is_err());
}

pub(super) fn late_bytes_and_eof_keep_original_context() -> io::Result<()> {
    use crate::event_log::{EventContext, LogFilter};
    use binding::PreparedOutput;
    use tokio::io::AsyncReadExt;
    let runtime = tokio::runtime::Builder::new_current_thread()
        .enable_all()
        .build()?;
    let _entered = runtime.enter();
    let log = EventLog::new();
    let mut g1 = PreparedOutput::create(&log, 1)?.consume();
    let g2 = PreparedOutput::create(&log, 2)?.consume();
    g1.write_late()?;
    g2.observed(false);
    let mut buf = [0; 4];
    runtime.block_on(async {
        tokio::time::timeout(
            std::time::Duration::from_secs(2),
            g1.readers.stdout.read_exact(&mut buf),
        )
        .await
    })??;
    assert_eq!(&buf, b"late");
    g1.observed(false);
    g1.close();
    assert_eq!(
        runtime.block_on(async {
            tokio::time::timeout(
                std::time::Duration::from_secs(2),
                g1.readers.stdout.read(&mut buf),
            )
            .await
        })??,
        0
    );
    // log остаётся immutable и после закрытия writer.
    g1.observed(true);
    let page = log
        .read_scoped(0, LogFilter::default(), 10)
        .expect("страница");
    assert_eq!(
        page.contexts,
        vec![
            Some(EventContext {
                session_id: 2,
                generation: 2
            }),
            Some(EventContext {
                session_id: 1,
                generation: 1
            }),
            Some(EventContext {
                session_id: 1,
                generation: 1
            })
        ]
    );
    Ok(())
}

pub(super) fn named_fifo_is_not_an_anonymous_pipe() -> io::Result<()> {
    use std::os::unix::fs::OpenOptionsExt;
    let mut nonce = [0; 8];
    getrandom::getrandom(&mut nonce).map_err(io::Error::other)?;
    let path = std::env::temp_dir().join(format!("yonik-fr16-{:x}", u64::from_ne_bytes(nonce)));
    rustix::fs::mkfifoat(
        rustix::fs::CWD,
        &path,
        rustix::fs::Mode::RUSR | rustix::fs::Mode::WUSR,
    )?;
    let keeper = std::fs::OpenOptions::new()
        .read(true)
        .write(true)
        .custom_flags(rustix::fs::OFlags::NONBLOCK.bits() as i32)
        .open(&path)?;
    let writer = std::fs::OpenOptions::new().write(true).open(&path)?;
    std::fs::remove_file(&path)?;
    // Отрицательный контроль удовлетворяет всем старым условиям, включая blocking.
    assert_eq!(
        rustix::fs::FileType::from_raw_mode(rustix::fs::fstat(&writer)?.st_mode),
        rustix::fs::FileType::Fifo
    );
    assert!(!fcntl_getfl(&writer)?.contains(OFlags::NONBLOCK));
    assert_ne!(rustix::fs::fstatfs(&writer)?.f_type as u64, 0x5049_5045);
    let runtime = tokio::runtime::Builder::new_current_thread()
        .enable_io()
        .build()?;
    let _entered = runtime.enter();
    let (readers, writers) = create()?;
    let mut roles = writers.roles;
    roles[0] = writer.into();
    assert!(OutputWriters { roles }.validate().is_err());
    assert_eq!(rustix::io::read(&readers.stderr, &mut [0])?, 0);
    drop(keeper);
    Ok(())
}

pub(super) fn fixed_golden_vectors() {
    let v1 = include_bytes!("v1.bin");
    let v2 = include_bytes!("v2.bin");
    let v3 = include_bytes!("v3.bin");
    let (header, manifest, scope) = decode_bundle_header(v1).expect("v1 golden");
    assert_eq!(header.encode(), *v1);
    assert_eq!(header.length, 0x010203);
    assert!(manifest.is_empty() && scope.is_none());
    let (header, manifest, scope) = decode_bundle_header(v2).expect("v2 golden");
    assert_eq!(header.encode(), *v1);
    assert_eq!(manifest.len(), 1);
    let scope = scope.expect("resource scope");
    assert_eq!((scope.session, scope.generation), (1, 2));
    assert_eq!(fixture(0), v3);
    assert_eq!(
        decode(v3).expect("v3 golden"),
        ["binary", "config", "stdout", "stderr"]
    );
    assert!(decode(v1).is_err() && decode(v2).is_err());
}
}
